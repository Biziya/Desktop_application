<Window x:Class="CT008Monitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CT008 Monitor (proof of concept)" Height="800" Width="1320"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="StateCell" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DisplayState}" Value="logging">
                    <Setter Property="Foreground" Value="Green" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DisplayState}" Value="connected">
                    <Setter Property="Foreground" Value="SteelBlue" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DisplayState}" Value="disconnected">
                    <Setter Property="Foreground" Value="Gray" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DisplayState}" Value="stale">
                    <Setter Property="Foreground" Value="DarkOrange" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DisplayState}" Value="logging (no data)">
                    <Setter Property="Foreground" Value="DarkOrange" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ResponseTimeCell" TargetType="TextBlock">
            <Style.Triggers>
                <DataTrigger Binding="{Binding ResponseTimeWarning}" Value="True">
                    <Setter Property="Foreground" Value="Red" />
                    <Setter Property="FontWeight" Value="Bold" />
                    <Setter Property="ToolTip" Value="Response time should be 1 s for 5 second samples" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CompleteCell" TargetType="TextBlock">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Complete}" Value="False">
                    <Setter Property="Foreground" Value="Red" />
                    <Setter Property="FontWeight" Value="Bold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="WarningBanner" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="Firebrick" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding WarningText}" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="SelectionMode" Value="Single" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="10">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Database:" VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBox Width="560" VerticalAlignment="Center"
                     Text="{Binding DatabasePath, UpdateSourceTrigger=PropertyChanged}" />
            <Button Content="Browse..." Margin="6,0,0,0" Padding="10,2" Click="BtnBrowse_Click" />
            <Button Content="Reconnect" Margin="6,0,0,0" Padding="10,2" Click="BtnReconnect_Click" />
            <TextBlock Text="{Binding ConnectionText}" VerticalAlignment="Center" Margin="14,0,0,0" TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <TextBlock DockPanel.Dock="Top" Text="{Binding WarningText}" Style="{StaticResource WarningBanner}" />

        <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusText}" Margin="0,8,0,0" Foreground="DimGray" />

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="170" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="190" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Detectors" FontWeight="Bold" Margin="0,0,0,4" />
            <DataGrid Grid.Row="1" ItemsSource="{Binding Detectors}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Serial" Binding="{Binding Serial}" />
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" />
                    <DataGridTextColumn Header="Type" Binding="{Binding TypeName}" />
                    <DataGridTextColumn Header="State" Binding="{Binding DisplayState}" ElementStyle="{StaticResource StateCell}" />
                    <DataGridTextColumn Header="Resp. time" Binding="{Binding ResponseTimeText}" ElementStyle="{StaticResource ResponseTimeCell}" />
                    <DataGridTemplateColumn Header="5 s sample">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Sample" Padding="8,0" Margin="2,1" Click="BtnAggregate_Click" IsEnabled="{Binding CanAggregate}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Sample progress" Binding="{Binding AggregateText}" />
                    <DataGridTextColumn Header="Heartbeat" Binding="{Binding HeartbeatAge}" />
                    <DataGridTextColumn Header="Last reading" Binding="{Binding LastSampleAge}" />
                    <DataGridTextColumn Header="Reading time" Binding="{Binding SampleTime}" />
                    <DataGridTextColumn Header="Seq" Binding="{Binding Seq}" />
                    <DataGridTextColumn Header="CPM" Binding="{Binding Cpm, StringFormat={}{0:0}}" />
                    <DataGridTextColumn Header="Raw CPM" Binding="{Binding CpmRaw, StringFormat={}{0:0}}" />
                    <DataGridTextColumn Header="HDM (mV)" Binding="{Binding Hdm, StringFormat={}{0:0.0}}" />
                    <DataGridTextColumn Header="Dose (uSv/h)" Binding="{Binding DoseRate, StringFormat={}{0:0.00}}" />
                    <DataGridTextColumn Header="Temp (C)" Binding="{Binding Temperature, StringFormat={}{0:0.0}}" />
                    <DataGridTextColumn Header="Session" Binding="{Binding SessionId}" />
                    <DataGridTextColumn Header="Firmware" Binding="{Binding Firmware}" />
                    <DataGridTextColumn Header="MAC" Binding="{Binding Mac}" />
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock Grid.Row="2" Text="5-second samples (newest first: the first reading after the click is discarded, the next 5 are averaged)" FontWeight="Bold" Margin="0,10,0,4" />
            <DataGrid Grid.Row="3" ItemsSource="{Binding Aggregations}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Serial" Binding="{Binding Serial}" />
                    <DataGridTextColumn Header="Covers" Binding="{Binding Window}" />
                    <DataGridTextColumn Header="Coverage (s)" Binding="{Binding SpanSeconds, StringFormat={}{0:0.00}}" />
                    <DataGridTextColumn Header="Readings" Binding="{Binding Samples}" ElementStyle="{StaticResource CompleteCell}" />
                    <DataGridTextColumn Header="Expected" Binding="{Binding Expected}" />
                    <DataGridTextColumn Header="Mean CPM" Binding="{Binding Cpm, StringFormat={}{0:0.0}}" />
                    <DataGridTextColumn Header="Mean raw CPM" Binding="{Binding CpmRaw, StringFormat={}{0:0.0}}" />
                    <DataGridTextColumn Header="Mean HDM (mV)" Binding="{Binding Hdm, StringFormat={}{0:0.00}}" />
                    <DataGridTextColumn Header="Mean dose (uSv/h)" Binding="{Binding DoseRate, StringFormat={}{0:0.000}}" />
                    <DataGridTextColumn Header="Mean temp (C)" Binding="{Binding Temperature, StringFormat={}{0:0.00}}" />
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock Grid.Row="4" Text="Recent readings (newest first)" FontWeight="Bold" Margin="0,10,0,4" />
            <DataGrid Grid.Row="5" ItemsSource="{Binding RecentSamples}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Id" Binding="{Binding Id}" />
                    <DataGridTextColumn Header="Time" Binding="{Binding Time}" />
                    <DataGridTextColumn Header="Serial" Binding="{Binding Serial}" />
                    <DataGridTextColumn Header="Seq" Binding="{Binding Seq}" />
                    <DataGridTextColumn Header="CPM" Binding="{Binding Cpm, StringFormat={}{0:0}}" />
                    <DataGridTextColumn Header="Raw CPM" Binding="{Binding CpmRaw, StringFormat={}{0:0}}" />
                    <DataGridTextColumn Header="HDM (mV)" Binding="{Binding Hdm, StringFormat={}{0:0.0}}" />
                    <DataGridTextColumn Header="Dose (uSv/h)" Binding="{Binding DoseRate, StringFormat={}{0:0.00}}" />
                    <DataGridTextColumn Header="Temp (C)" Binding="{Binding Temperature, StringFormat={}{0:0.0}}" />
                    <DataGridTextColumn Header="Session" Binding="{Binding SessionId}" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </DockPanel>
</Window>
