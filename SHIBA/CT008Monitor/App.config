<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8"/>
  </startup>
  <appSettings>
    <!-- Database to open when the monitor has not been pointed at one yet. A relative path is resolved
         against the monitor's exe folder; this default reaches the CT008 Debug build's Database folder. -->
    <add key="DefaultDatabasePath" value="..\..\..\..\..\Windows App\CT008\bin\Debug\Database\ct008-log.sqlite"/>
    <!-- How often to read the database, in milliseconds -->
    <add key="PollIntervalMs" value="1000"/>
    <!-- A detector whose heartbeat is older than this is shown as stale (its CT008 instance is probably gone) -->
    <add key="StaleAfterMs" value="5000"/>
  </appSettings>
</configuration>
