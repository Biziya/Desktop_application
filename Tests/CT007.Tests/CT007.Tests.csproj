<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Automated tests for Frontend and Backend (qa/planning/test-inventory.md). Same style as SmokeTests: a console test
    harness without a test framework package (none is available offline), but one result per test ID instead of stopping
    at the first failure. The target framework matches Frontend.csproj, which the SmokeTests project does not (NU1201).
    Run options (ID filters, opt-in categories, results file): see Tests/README.md.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Ct007.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- ASP.NET Core shared framework (installed with the SDK, no package download): in-process backend host for API tests. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Frontend\Frontend.csproj" />
    <ProjectReference Include="..\..\Backend\Backend.csproj" />
  </ItemGroup>

  <!-- The backend's appsettings*.json (with its SQL Server connection string) would be copied here through the project
       reference. Tests never use it: remove it from the test output so no test can reach the configured server. -->
  <Target Name="RemoveBackendAppSettings" AfterTargets="Build">
    <Delete Files="$(OutDir)appsettings.json;$(OutDir)appsettings.Development.json" />
  </Target>

</Project>
