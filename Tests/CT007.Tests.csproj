<Project Sdk="Microsoft.NET.Sdk">

  <!-- Console test harness for Frontend and Backend (no test framework package). How to run: README.md. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Ct007.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Hosts the backend in-process for API tests. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Frontend\Frontend.csproj" />
    <ProjectReference Include="..\Backend\Backend.csproj" />
  </ItemGroup>

  <!-- The backend's appsettings*.json holds the SQL Server connection string: keep it out of the test output so no test
       can reach a real server. -->
  <Target Name="RemoveBackendAppSettings" AfterTargets="Build">
    <Delete Files="$(OutDir)appsettings.json;$(OutDir)appsettings.Development.json" />
  </Target>

</Project>
