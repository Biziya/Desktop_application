<Window x:Class="Frontend.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:core="clr-namespace:Frontend.Pages.CoreInformation"
 xmlns:measurement="clr-namespace:Frontend.Pages.Measurement" Title="SPP CT-007 Measurement Studio"
 Width="1320" Height="870" MinWidth="960" MinHeight="650" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <DataTemplate DataType="{x:Type core:CoreInformationViewModel}"><core:CoreInformationPage/></DataTemplate>
        <DataTemplate DataType="{x:Type measurement:MeasurementViewModel}"><measurement:MeasurementPage/></DataTemplate>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Background="{StaticResource SidebarSurface}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Width" Value="224"/>
                    <Style.Triggers><DataTrigger Binding="{Binding IsSidebarExpanded}" Value="False"><Setter Property="Width" Value="72"/></DataTrigger></Style.Triggers>
                </Style>
            </Border.Style>
            <DockPanel Margin="15,20,15,20">
                <Grid DockPanel.Dock="Top" Margin="0,0,0,28">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Button Width="40" Height="40" Padding="10" Style="{StaticResource SecondaryButton}"
                            Command="{Binding ToggleSidebarCommand}" ToolTip="{Binding SidebarToggleLabel}" AutomationProperties.Name="{Binding SidebarToggleLabel}">
                        <Path Stroke="{StaticResource Navy}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform" Width="9" Height="15">
                            <Path.Style><Style TargetType="Path"><Setter Property="Data" Value="{StaticResource CollapseIcon}"/>
                                <Style.Triggers><DataTrigger Binding="{Binding IsSidebarExpanded}" Value="False"><Setter Property="Data" Value="{StaticResource ExpandIcon}"/></DataTrigger></Style.Triggers>
                            </Style></Path.Style>
                        </Path>
                    </Button>
                    <TextBlock Grid.Column="1" Text="SPP CT-007" FontSize="18" FontWeight="SemiBold" Margin="11,0,0,0"
                               VerticalAlignment="Center" Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BoolVisibility}}"/>
                </Grid>
                <StackPanel>
                    <Button Style="{StaticResource NavigationButton}" Tag="{Binding IsCoreSelected}" Command="{Binding ShowCoreCommand}" ToolTip="Core Information" AutomationProperties.Name="Core Information">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Path Data="{StaticResource CoreIcon}" Width="18" Height="21" Stretch="Uniform" StrokeThickness="1.5" StrokeLineJoin="Round"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            <TextBlock Grid.Column="1" Text="Core Information" Style="{StaticResource NavigationLabel}"/>
                        </Grid>
                    </Button>
                    <Button Style="{StaticResource NavigationButton}" Tag="{Binding IsMeasurementSelected}" Command="{Binding ShowMeasurementCommand}" ToolTip="Measurement" AutomationProperties.Name="Measurement">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Path Data="{StaticResource MeasurementIcon}" Width="19" Height="20" Stretch="Uniform"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            <TextBlock Grid.Column="1" Text="Measurement" Style="{StaticResource NavigationLabel}"/>
                        </Grid>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>
        <ContentControl Grid.Column="1" Content="{Binding CurrentPage}" Margin="24"/>
    </Grid>
</Window>
