<Window x:Class="Frontend.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:Frontend.Pages.CoreInformation"
        xmlns:measurement="clr-namespace:Frontend.Pages.Measurement"
        xmlns:monitoring="clr-namespace:Frontend.Pages.Monitoring"
        xmlns:viewer="clr-namespace:Frontend.Pages.DataViewer"
        xmlns:upload="clr-namespace:Frontend.Pages.UploadData"
        xmlns:infra="clr-namespace:Frontend.Shared.Infrastructure"
        Style="{StaticResource AppWindow}"
        Title="{StaticResource ApplicationTitle}"
        Width="1320" Height="870" MinWidth="960" MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Icon="Icons/icon.ico">
    <Window.Resources>
        <DataTemplate DataType="{x:Type core:CoreInformationViewModel}"><core:CoreInformationPage/></DataTemplate>
        <DataTemplate DataType="{x:Type measurement:MeasurementViewModel}"><measurement:MeasurementPage/></DataTemplate>
        <DataTemplate DataType="{x:Type monitoring:MonitoringViewModel}"><monitoring:MonitoringPage/></DataTemplate>
        <DataTemplate DataType="{x:Type upload:UploadDataViewModel}"><upload:UploadDataPage/></DataTemplate>
        <DataTemplate DataType="{x:Type viewer:DataViewerViewModel}"><viewer:DataViewerPage/></DataTemplate>
    </Window.Resources>

    <!-- The ? button of every page header sends ApplicationCommands.Help. F1 and Esc are handled in PreviewKeyDown
         (MainWindow.xaml.cs), so they work wherever the keyboard focus is. All three go through ToggleHelp. -->
    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.Help" Executed="HelpButtonPressed"/>
    </Window.CommandBindings>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar: icon and title for every page; the toggle at the top collapses it to icons only (72 px). -->
        <Border Background="{StaticResource SidebarBackground}" BorderBrush="{StaticResource SidebarBorder}" BorderThickness="0,0,1,0">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Width" Value="224"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSidebarCollapsed}" Value="True">
                            <Setter Property="Width" Value="72"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <!-- The 14 px side padding holds the selected item's accent bar, flush with the sidebar edge. -->
            <DockPanel Margin="14,10,14,16">
                <!-- Header: one big button (app icon, name and «) that collapses the sidebar; collapsed it shows » to
                     expand again. Same rounded grey hover as the page items. -->
                <Button DockPanel.Dock="Top" Style="{StaticResource NavigationButton}" Height="48" Margin="0"
                        Foreground="{StaticResource SidebarTextStrong}"
                        Command="{Binding ToggleSidebarCommand}" AutomationProperties.Name="Toggle sidebar">
                    <Button.ToolTip>
                        <ToolTip>
                            <ToolTip.Style>
                                <Style TargetType="ToolTip">
                                    <Setter Property="Content" Value="Collapse sidebar"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSidebarCollapsed}" Value="True">
                                            <Setter Property="Content" Value="Expand sidebar"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ToolTip.Style>
                        </ToolTip>
                    </Button.ToolTip>
                    <Grid>
                        <DockPanel Margin="6,0,8,0" Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBoolVisibility}}">
                            <Path DockPanel.Dock="Right" Data="{StaticResource CollapseLeftIcon}" Width="14" Height="14" Stretch="Uniform"
                                  StrokeThickness="1.8" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Stroke="{StaticResource SidebarMuted}" VerticalAlignment="Center"/>
                            <Image Source="{StaticResource AppIcon}" Width="28" Height="28" VerticalAlignment="Center"/>
                            <TextBlock Text="{StaticResource ApplicationName}" FontSize="16" FontWeight="Bold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </DockPanel>
                        <Path Data="{StaticResource ExpandRightIcon}" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center"
                              StrokeThickness="1.8" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Stroke="{StaticResource SidebarMuted}" VerticalAlignment="Center"
                              Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource BoolVisibility}}"/>
                    </Grid>
                </Button>
                <Border DockPanel.Dock="Top" Height="1" Margin="0,10,0,12" Background="{StaticResource SidebarBorder}"/>

                <!-- Bottom, under a divider: backend API reachability (green Online, yellow Offline, grey while checking),
                     then the version. Collapsed: the dot only. -->
                <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource SidebarBorder}" BorderThickness="0,1,0,0" Padding="0,14,0,0">
                <StackPanel Margin="15,0,0,0">
                    <StackPanel Orientation="Horizontal" Background="Transparent"
                                ToolTip="{Binding Backend.Tooltip}" AutomationProperties.Name="{Binding Backend.Tooltip}">
                        <Ellipse Width="9" Height="9" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{StaticResource SidebarMuted}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Backend.State}" Value="Online"><Setter Property="Fill" Value="{StaticResource Success}"/></DataTrigger>
                                        <DataTrigger Binding="{Binding Backend.State}" Value="Offline"><Setter Property="Fill" Value="{StaticResource OfflineIndicator}"/></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding Backend.StateText}" Margin="8,0,0,0" FontSize="13" VerticalAlignment="Center"
                                   Foreground="{StaticResource SidebarText}"
                                   Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBoolVisibility}}"/>
                    </StackPanel>
                    <TextBlock Text="{StaticResource ApplicationVersionLabel}" Foreground="{StaticResource SidebarMuted}" FontSize="12" Margin="0,8,0,0"
                               AutomationProperties.Name="{StaticResource ApplicationTitle}"
                               Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBoolVisibility}}"/>
                </StackPanel>
                </Border>

                <ItemsControl ItemsSource="{Binding Pages}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource NavigationButton}"
                                    infra:SidebarItem.IsSelected="{Binding IsSelected}"
                                    Command="{Binding DataContext.ShowPageCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}"
                                    ToolTip="{Binding Title}"
                                    AutomationProperties.Name="{Binding Title}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Path Data="{Binding IconKey, Converter={StaticResource ResourceKey}}" Width="17" Height="18" Stretch="Uniform"
                                          StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center" Margin="4,0,8,0"
                                               Visibility="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBoolVisibility}}"/>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>

        <ContentControl Grid.Column="1" Content="{Binding CurrentPage}" Margin="24" Focusable="False"/>

        <!-- Toasts: bottom-right corner of the window, stacked 8 px apart, newest
             at the bottom. They take no layout space and never block clicks outside themselves. -->
        <ItemsControl Grid.Column="1" ItemsSource="{Binding Toasts.Items}" Focusable="False"
                      HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="360" MaxWidth="360" Margin="0,0,20,20">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Toast}">
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Style="{StaticResource ToastBadge}" VerticalAlignment="Top" Margin="0,2,12,0">
                                <TextBlock Style="{StaticResource ToastGlyph}"/>
                            </Border>
                            <Button DockPanel.Dock="Right" Style="{StaticResource ClearButton}" Margin="8,0,0,0" VerticalAlignment="Top"
                                    Command="{Binding DataContext.Toasts.DismissCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}" ToolTip="Dismiss" AutomationProperties.Name="Dismiss notification"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource ToastTitle}"/>
                                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="13" Margin="0,2,0,0"
                                           Foreground="{StaticResource LabelText}"
                                           AutomationProperties.LiveSetting="Polite"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</Window>
