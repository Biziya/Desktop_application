<Window x:Class="Frontend.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:core="clr-namespace:Frontend.Pages.CoreInformation"
 xmlns:measurement="clr-namespace:Frontend.Pages.Measurement" xmlns:infra="clr-namespace:Frontend.Shared.Infrastructure" Style="{StaticResource AppWindow}" Title="SPP CT-007 Measurement Studio"
 Width="1320" Height="870" MinWidth="960" MinHeight="650" WindowStartupLocation="CenterScreen"
 Icon="Icons/icon.ico">
    <Window.Resources>
        <DataTemplate DataType="{x:Type core:CoreInformationViewModel}"><core:CoreInformationPage/></DataTemplate>
        <DataTemplate DataType="{x:Type measurement:MeasurementViewModel}"><measurement:MeasurementPage/></DataTemplate>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <!-- Sidebar (after the reference): white panel with a hairline divider against the grey pages; brand icon
             top-left (click it to collapse/expand), navigation, and the backend Online/Offline indicator at the bottom. -->
        <Border Background="{StaticResource SidebarBackground}" BorderBrush="{StaticResource SidebarBorder}" BorderThickness="0,0,1,0">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Width" Value="224"/>
                    <Style.Triggers><DataTrigger Binding="{Binding IsSidebarExpanded}" Value="False"><Setter Property="Width" Value="72"/></DataTrigger></Style.Triggers>
                </Style>
            </Border.Style>
            <!-- 14 px padding: the selected item's accent bar sits in it, flush with the sidebar edge. -->
            <DockPanel Margin="14,18,14,16">
                <!-- Brand row. The blue SPP CT-007 icon is the sidebar toggle (the sidebar, not the window): it stays in the
                     40 px icon column, so it is visible and clickable both expanded and collapsed. Hover tint, keyboard
                     focus ring (Tab, then Enter/Space) and the tooltip come from IconButton / the bound label. -->
                <Grid DockPanel.Dock="Top">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Button Style="{StaticResource IconButton}" Width="40" Height="40" VerticalAlignment="Center"
                            Command="{Binding ToggleSidebarCommand}"
                            ToolTip="{Binding SidebarToggleLabel}"
                            AutomationProperties.Name="{Binding SidebarToggleLabel}"
                            AutomationProperties.HelpText="SPP CT-007 Measurement Studio">
                        <Image Source="{StaticResource AppIcon}" Width="28" Height="28"/>
                    </Button>
                    <StackPanel Grid.Column="1" Margin="8,0,4,0" VerticalAlignment="Center"
                                Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BoolVisibility}}">
                        <TextBlock Text="SPP CT-007" FontSize="16" FontWeight="Bold"/>
                        <TextBlock Text="Measurement Studio" FontSize="12" Foreground="{StaticResource Muted}"/>
                    </StackPanel>
                </Grid>
                <Border DockPanel.Dock="Top" Height="1" Margin="0,16,0,12" Background="{StaticResource Line}"/>

                <!-- Backend API reachability (not the Bluetooth device): green Online, yellow Offline, grey while checking.
                     Left-aligned under the navigation icons, dot and text 8 px apart. Collapsed, only the dot stays;
                     the tooltip always gives the status. -->
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Left" Margin="15,0,0,0"
                            Background="Transparent" ToolTip="{Binding Backend.Tooltip}" AutomationProperties.Name="{Binding Backend.Tooltip}">
                    <Ellipse Width="9" Height="9" VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource Muted}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Backend.State}" Value="Online"><Setter Property="Fill" Value="{StaticResource Success}"/></DataTrigger>
                                    <DataTrigger Binding="{Binding Backend.State}" Value="Offline"><Setter Property="Fill" Value="{StaticResource OfflineIndicator}"/></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding Backend.StateText}" Margin="8,0,0,0" FontSize="13" VerticalAlignment="Center"
                               Foreground="{StaticResource SidebarText}"
                               Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BoolVisibility}}"/>
                </StackPanel>

                <StackPanel>
                    <Button Style="{StaticResource NavigationButton}" infra:SidebarItem.IsSelected="{Binding IsCoreSelected}" Command="{Binding ShowCoreCommand}" ToolTip="Core Information" AutomationProperties.Name="Core Information">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Path Data="{StaticResource CoreIcon}" Width="16" Height="19" Stretch="Uniform" StrokeThickness="1.5" StrokeLineJoin="Round"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            <TextBlock Grid.Column="1" Text="Core Information" Style="{StaticResource NavigationLabel}"/>
                        </Grid>
                    </Button>
                    <Button Style="{StaticResource NavigationButton}" infra:SidebarItem.IsSelected="{Binding IsMeasurementSelected}" Command="{Binding ShowMeasurementCommand}" ToolTip="Measurement" AutomationProperties.Name="Measurement">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Path Data="{StaticResource MeasurementIcon}" Width="17" Height="18" Stretch="Uniform"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            <TextBlock Grid.Column="1" Text="Measurement" Style="{StaticResource NavigationLabel}"/>
                        </Grid>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>
        <ContentControl Grid.Column="1" Content="{Binding CurrentPage}" Margin="24"/>

        <!-- Toasts for both pages: top-right of the window's content area (beside the sidebar, in the window's own grid,
             so they follow resizing, sidebar collapse and page switches), 16 px from the top and right edges, stacked
             downwards 8 px apart. They take no layout space and the empty area around them is not hit-testable, so they
             never move the page or block clicks elsewhere. Info and success close after 3 s, errors after 5 s; × closes
             one now. -->
        <ItemsControl Grid.Column="1" ItemsSource="{Binding Toasts.Items}" Focusable="False"
                      HorizontalAlignment="Right" VerticalAlignment="Top" Width="360" MaxWidth="360" Margin="0,16,16,0">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Toast}">
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Style="{StaticResource ToastAccent}"/>
                            <Button DockPanel.Dock="Right" Style="{StaticResource ClearButton}" Margin="0,8,8,8" VerticalAlignment="Top"
                                    Command="{Binding DataContext.Toasts.DismissCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}" ToolTip="Dismiss" AutomationProperties.Name="Dismiss notification"/>
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource ToastGlyph}"/>
                            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,11,4,11" VerticalAlignment="Center"
                                       AutomationProperties.LiveSetting="Polite"/>
                        </DockPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</Window>
