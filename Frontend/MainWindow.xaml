<Window x:Class="Frontend.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:Frontend.Pages.CoreInformation"
        xmlns:measurement="clr-namespace:Frontend.Pages.Measurement"
        xmlns:monitoring="clr-namespace:Frontend.Pages.Monitoring"
        xmlns:saved="clr-namespace:Frontend.Pages.SavedData"
        xmlns:upload="clr-namespace:Frontend.Pages.UploadData"
        xmlns:infra="clr-namespace:Frontend.Shared.Infrastructure"
        Style="{StaticResource AppWindow}"
        Title="{StaticResource ApplicationTitle}"
        Width="1320" Height="870" MinWidth="960" MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Icon="Icons/icon.ico">
    <Window.Resources>
        <DataTemplate DataType="{x:Type core:CoreInformationViewModel}"><core:CoreInformationPage/></DataTemplate>
        <DataTemplate DataType="{x:Type measurement:MeasurementViewModel}"><measurement:MeasurementPage/></DataTemplate>
        <DataTemplate DataType="{x:Type monitoring:MonitoringViewModel}"><monitoring:MonitoringPage/></DataTemplate>
        <DataTemplate DataType="{x:Type saved:SavedDataViewModel}"><saved:SavedDataPage/></DataTemplate>
        <DataTemplate DataType="{x:Type upload:UploadDataViewModel}"><upload:UploadDataPage/></DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar: 224 px, 72 px collapsed (the app icon toggles it). -->
        <Border Background="{StaticResource SidebarBackground}" BorderBrush="{StaticResource SidebarBorder}" BorderThickness="0,0,1,0">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Width" Value="224"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSidebarExpanded}" Value="False">
                            <Setter Property="Width" Value="72"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <!-- The 14 px side padding holds the selected item's accent bar, flush with the sidebar edge. -->
            <DockPanel Margin="14,18,14,16">
                <Grid DockPanel.Dock="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Style="{StaticResource IconButton}" Width="40" Height="40" VerticalAlignment="Center"
                            Command="{Binding ToggleSidebarCommand}"
                            ToolTip="{Binding SidebarToggleLabel}"
                            AutomationProperties.Name="{Binding SidebarToggleLabel}"
                            AutomationProperties.HelpText="SPP CT-007 Measurement Studio">
                        <Image Source="{StaticResource AppIcon}" Width="28" Height="28"/>
                    </Button>
                    <StackPanel Grid.Column="1" Margin="8,0,4,0" VerticalAlignment="Center"
                                Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BoolVisibility}}">
                        <TextBlock Text="SPP CT-007" FontSize="16" FontWeight="Bold"/>
                        <TextBlock Text="Measurement Studio" FontSize="12" Foreground="{StaticResource Muted}"/>
                    </StackPanel>
                </Grid>
                <Border DockPanel.Dock="Top" Height="1" Margin="0,16,0,12" Background="{StaticResource Line}"/>

                <!-- Backend API reachability: green Online, yellow Offline, grey while checking. Collapsed, only the dot stays. -->
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Left" Margin="15,0,0,0"
                            Background="Transparent" ToolTip="{Binding Backend.Tooltip}" AutomationProperties.Name="{Binding Backend.Tooltip}">
                    <Ellipse Width="9" Height="9" VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource Muted}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Backend.State}" Value="Online"><Setter Property="Fill" Value="{StaticResource Success}"/></DataTrigger>
                                    <DataTrigger Binding="{Binding Backend.State}" Value="Offline"><Setter Property="Fill" Value="{StaticResource OfflineIndicator}"/></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding Backend.StateText}" Margin="8,0,0,0" FontSize="13" VerticalAlignment="Center"
                               Foreground="{StaticResource SidebarText}"
                               Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BoolVisibility}}"/>
                </StackPanel>

                <ItemsControl ItemsSource="{Binding Pages}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource NavigationButton}"
                                    infra:SidebarItem.IsSelected="{Binding IsSelected}"
                                    Command="{Binding DataContext.ShowPageCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}"
                                    ToolTip="{Binding Title}"
                                    AutomationProperties.Name="{Binding Title}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Path Data="{Binding IconKey, Converter={StaticResource ResourceKey}}" Width="17" Height="18" Stretch="Uniform"
                                          StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center" Margin="4,0,8,0"
                                               Visibility="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource BoolVisibility}}"/>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>

        <ContentControl Grid.Column="1" Content="{Binding CurrentPage}" Margin="24" Focusable="False"/>

        <!-- Toasts: top-right of the content area, stacked 8 px apart. They take no layout space and never block clicks
             outside themselves. -->
        <ItemsControl Grid.Column="1" ItemsSource="{Binding Toasts.Items}" Focusable="False"
                      HorizontalAlignment="Right" VerticalAlignment="Top" Width="360" MaxWidth="360" Margin="0,16,16,0">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Toast}">
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Style="{StaticResource ToastAccent}"/>
                            <Button DockPanel.Dock="Right" Style="{StaticResource ClearButton}" Margin="0,8,8,8" VerticalAlignment="Top"
                                    Command="{Binding DataContext.Toasts.DismissCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}" ToolTip="Dismiss" AutomationProperties.Name="Dismiss notification"/>
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource ToastGlyph}"/>
                            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,11,4,11" VerticalAlignment="Center"
                                       AutomationProperties.LiveSetting="Polite"/>
                        </DockPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</Window>
