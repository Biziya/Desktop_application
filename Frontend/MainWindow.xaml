<Window x:Class="Frontend.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:core="clr-namespace:Frontend.Pages.CoreInformation" xmlns:measurement="clr-namespace:Frontend.Pages.Measurement"
 Title="SPP CT-007 Measurement Studio" Width="1320" Height="870" MinWidth="960" MinHeight="650" WindowStartupLocation="CenterScreen">
 <Window.Resources><DataTemplate DataType="{x:Type core:CoreInformationViewModel}"><core:CoreInformationPage/></DataTemplate><DataTemplate DataType="{x:Type measurement:MeasurementViewModel}"><measurement:MeasurementPage/></DataTemplate></Window.Resources>
 <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="218"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#ECF4FF" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0" Padding="16,30,16,22">
   <DockPanel><StackPanel DockPanel.Dock="Top" Margin="8,0,0,28"><TextBlock Text="◈  SPP CT-007" FontSize="22" FontWeight="Bold"/></StackPanel>
    <StackPanel><Button Content="▤   Core Information" Style="{StaticResource NavigationButton}" Tag="{Binding IsCoreSelected}" Command="{Binding ShowCoreCommand}"/><Button Content="▥   Measurement" Style="{StaticResource NavigationButton}" Tag="{Binding IsMeasurementSelected}" Command="{Binding ShowMeasurementCommand}"/></StackPanel>
   </DockPanel>
  </Border>
  <ContentControl Grid.Column="1" Content="{Binding CurrentPage}" Margin="26"/>
 </Grid>
</Window>
