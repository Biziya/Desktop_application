<UserControl x:Class="Frontend.Views.MeasurementPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Style="{StaticResource Card}"><StackPanel><Grid Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
   <StackPanel HorizontalAlignment="Center"><TextBlock Text="◷" FontSize="32" Foreground="{StaticResource Blue}" HorizontalAlignment="Center"/><TextBlock Text="Capture Countdown" Foreground="{StaticResource Muted}" Margin="0,8,0,4"/><TextBlock Text="{Binding Countdown}" FontSize="44" FontWeight="Bold" Foreground="{StaticResource Blue}" HorizontalAlignment="Center" AutomationProperties.Name="Capture countdown"/></StackPanel>
   <Border Grid.Column="1" BorderBrush="{StaticResource Line}" BorderThickness="1,0" Margin="12,16"><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock Text="Capture Duration" Foreground="{StaticResource Muted}"/><TextBlock Text="5 seconds" FontSize="24" FontWeight="SemiBold" Margin="0,8,0,0"/></StackPanel></Border>
   <Button Grid.Column="2" Content="▶  Start" FontSize="25" Background="#00A34C" Margin="14,0,0,0" VerticalAlignment="Center" Padding="20,20" Command="{Binding StartCommand}"/>
  </Grid><Border Background="#EFF5FD" CornerRadius="7" Padding="14"><TextBlock Text="Click Start to capture five simulated samples over 5 seconds. Each capture is averaged and added as one row. Click Start again to take another measurement." Style="{StaticResource MutedText}"/></Border>
  <TextBlock Text="Complete Core Information and click Save &amp; Continue to enable Start." Foreground="#AC6510" TextWrapping="Wrap" Margin="0,12,0,0" Visibility="{Binding NeedsCore, Converter={StaticResource BoolVisibility}}"/>
  </StackPanel></Border>
  <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0" Margin="0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Grid Margin="18,14"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="▥   Averaged Measurements" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/><Button Grid.Column="1" Content="↓   Export CSV" Style="{StaticResource SecondaryButton}" Command="{Binding ExportCommand}"/></Grid>
   <DataGrid x:Name="ResultsGrid" Grid.Row="1" ItemsSource="{Binding Results}" AutoGenerateColumns="False" SelectionMode="Single" AllowDrop="True" PreviewMouseMove="BeginDrag" PreviewMouseLeftButtonUp="EndPointer" DragOver="RowDragOver" Drop="RowDrop" DragLeave="RowDragLeave" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto">
    <DataGrid.Columns>
     <DataGridTemplateColumn Width="34"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="⠿" Cursor="SizeAll" FontSize="22" Foreground="{StaticResource Blue}" Background="Transparent" ToolTip="Drag to reorder" AutomationProperties.Name="Drag to reorder measurement" PreviewMouseLeftButtonDown="HandleDown"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
     <DataGridTextColumn Header="No." Binding="{Binding Number}" Width="44"/>
     <DataGridTextColumn Header="Capture No." Binding="{Binding CaptureNumber}" Width="83"/>
     <DataGridTextColumn Header="Start Time" Binding="{Binding StartTime, StringFormat={}{0:yyyy-MM-dd HH:mm:ss.fff}}" Width="176"/>
     <DataGridTextColumn Header="End Time" Binding="{Binding EndTime, StringFormat={}{0:yyyy-MM-dd HH:mm:ss.fff}}" Width="176"/>
     <DataGridTextColumn Header="Samples" Binding="{Binding SampleCount}" Width="69"/>
     <DataGridTextColumn Header="Average" Binding="{Binding AverageValue, StringFormat=F2}" Width="78"/>
     <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="50"/>
     <DataGridTemplateColumn Header="Delete" Width="68"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="✕" ToolTip="Delete measurement" AutomationProperties.Name="Delete measurement" Foreground="#D9334C" Background="Transparent" Padding="8" Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
    </DataGrid.Columns>
   </DataGrid>
   <TextBlock Grid.Row="1" Text="Your averaged measurements will appear here." HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Muted}" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Results.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
  </Grid></Border>
  <StackPanel Grid.Row="2" Margin="2,14,0,0"><TextBlock Text="Drag rows using ⠿ to change their order. Times are shown in local time." Style="{StaticResource MutedText}" FontSize="12"/><TextBlock Text="{Binding Notification}" Foreground="#087547" FontWeight="SemiBold" Margin="0,7,0,0" AutomationProperties.LiveSetting="Polite"/></StackPanel>
 </Grid>
</UserControl>
