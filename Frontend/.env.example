# Frontend -> backend API connection (the frontend only; this is NOT the backend database connection string).
#
# Copy this file to %LocalAppData%\CT007_Measurement_Studio\.env and edit it. That folder is outside the
# Velopack install folder, so updates keep it. Lookup order (later wins):
#   1. Api\api-settings.json next to Frontend.exe (shipped defaults)
#   2. %LocalAppData%\CT007_Measurement_Studio\.env (this file)
#   3. API_BASE_URL / API_TIMEOUT_SECONDS / API_RETRY_INTERVAL_SECONDS environment variables
# Omit a key to keep the value from the previous level. An invalid value stops the app with a message.
#
# Use https:// for a deployed backend. Never put passwords or tokens in this file.

# Backend base URL (local development backend: Backend/Properties/launchSettings.json, "http" profile).
API_BASE_URL=http://localhost:5002

# Seconds before a backend request is abandoned.
API_TIMEOUT_SECONDS=5

# Seconds between backend reachability checks (the sidebar Online/Offline retry).
API_RETRY_INTERVAL_SECONDS=5
