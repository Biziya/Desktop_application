# Frontend -> backend API connection. This is an HTTP address, NOT the backend's SQL Server connection string.
# Never put passwords or tokens in this file. Full guide: docs/API_CONFIGURATION.md
#
# Copy this file to:
#   - Frontend\.env.local       development: read by Debug builds (dotnet watch run)
#   - Frontend\.env.production  production: shipped by build-installer.ps1 as the installer's template. On first
#                               start the installed app copies it to
#                               %LocalAppData%\CT007_Measurement_Studio\Config\.env.production
#                               and from then on reads only that copy (edit it there; updates keep it).
# Restart the app after editing.

# Optional. Only confirms the file: local in .env.local, production in .env.production.
APP_ENV=local

# Required. Absolute http:// or https:// URL (use https:// for a deployed backend).
# Local development backend: Backend/Properties/launchSettings.json, "http" profile.
API_BASE_URL=http://localhost:5002

# Optional (default 5). Seconds before a backend request is abandoned.
API_TIMEOUT_SECONDS=5

# Optional (default 5). Seconds between backend reachability checks (the sidebar Online/Offline retry).
API_RETRY_INTERVAL_SECONDS=5
