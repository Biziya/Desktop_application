
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows 10 2004+ target for Windows Runtime Bluetooth API. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>

    <!-- Application icon -->
    <ApplicationIcon>Icons\icon.ico</ApplicationIcon>

    <!-- Use custom Main() for Velopack initialization -->
    <StartupObject>Frontend.App</StartupObject>
  </PropertyGroup>

  <!-- Application metadata comes from Config\application.yaml (the single source of truth), so every build -
       Visual Studio, dotnet build or build-installer.ps1 - compiles the same version and product name. -->
  <PropertyGroup>
    <ApplicationYaml>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)Config\application.yaml'))</ApplicationYaml>
    <Version>$([System.Text.RegularExpressions.Regex]::Match($(ApplicationYaml), '(?m)^\s+version:\s*"?([^"\r\n]+?)"?\s*$').Result('$1'))</Version>
    <Product>$([System.Text.RegularExpressions.Regex]::Match($(ApplicationYaml), '(?m)^\s+name:\s*"?([^"\r\n]+?)"?\s*$').Result('$1'))</Product>
    <Description>$([System.Text.RegularExpressions.Regex]::Match($(ApplicationYaml), '(?m)^\s+description:\s*"?([^"\r\n]+?)"?\s*$').Result('$1'))</Description>
    <AssemblyTitle>$(Product)</AssemblyTitle>
  </PropertyGroup>

  <!-- Backend API environment used when the APP_ENV environment variable is not set: Debug builds read .env.local,
       every other build .env.production (Api\ApiSettings.cs, docs\API_CONFIGURATION.md). Override with
       -p:AppEnvironment=local|production. Only the environment name is compiled in, never an address. -->
  <PropertyGroup>
    <AppEnvironment Condition="'$(AppEnvironment)' == '' and '$(Configuration)' == 'Debug'">local</AppEnvironment>
    <AppEnvironment Condition="'$(AppEnvironment)' == ''">production</AppEnvironment>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="AppEnvironment" Value="$(AppEnvironment)" />
  </ItemGroup>

  <Target Name="CheckAppEnvironment" BeforeTargets="BeforeBuild"
          Condition="'$(AppEnvironment)' != 'local' and '$(AppEnvironment)' != 'production'">
    <Error Text="AppEnvironment must be 'local' or 'production' (is '$(AppEnvironment)')." />
  </Target>

  <ItemGroup>
    <!-- .env files are this machine's configuration: never copied to the output, so none reaches the installer. -->
    <None Remove=".env*" />

    <Resource Include="Icons\icon.ico" />
    <None Include="Icons\icon.svg" />

    <!-- Application metadata (name, version); read at start-up -->
    <None Update="Config\application.yaml"
          CopyToOutputDirectory="PreserveNewest" />

    <!-- CT-007 device configuration -->
    <None Update="Calculation\Core-Information\device-settings.json"
          CopyToOutputDirectory="PreserveNewest" />

    <!-- Page YAML configuration -->
    <None Update="Pages\**\*.yaml"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Disable WPF's automatically generated Main() -->
  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite"
                      Version="10.0.0" />
    <PackageReference Include="Velopack"
                      Version="1.2.161" />
    <PackageReference Include="YamlDotNet"
                      Version="18.1.0" />
  </ItemGroup>

</Project>
