<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows 10 2004+ target: gives the Windows Runtime Bluetooth API (Windows.Devices.Bluetooth) used by
         Calculation/Core-Information/BluetoothDevice/WindowsBluetooth.cs, as in the former backend. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Windows needs .ico for the exe and window icon; Icons/icon.svg is the source it is rendered from. -->
    <ApplicationIcon>Icons\icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Icons\icon.ico" />
    <None Include="Icons\icon.svg" />
    <!-- Backend URL and intervals; editable next to the executable. -->
    <None Update="Api\api-settings.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- CT-007 identification, Gamma Guard database location and local check interval; editable next to the executable. -->
    <None Update="Calculation\Core-Information\device-settings.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Section labels, sizes and table columns (Pages/<page>/<section>/<section>.yaml); editable next to the
         executable, read once at start-up. -->
    <None Update="Pages\**\*.yaml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.0" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>

</Project>
