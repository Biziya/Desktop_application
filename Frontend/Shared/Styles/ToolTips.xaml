<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!-- Tooltips: one look for the whole app, plus every tooltip text, so the wording can be reviewed in one place.
         Rules: one short sentence (about 12 words at most), what it does (not how), the keyboard shortcut in brackets
         if there is one, and the same names as the labels on screen. Anything longer belongs in Help (help.yaml).
         Set a text with infra:Tip.Text="{StaticResource …}": that also sets the screen-reader help text.
         Timing (400 ms in, 10 s shown), keyboard focus and disabled controls: Shared/Infrastructure/ToolTipDefaults.cs.
         A few texts sit with their page labels in YAML: modeToolTip, drillholeLockedToolTip, clearDrillholeToolTip,
         cancelAddToolTip, localTagToolTip (DrillholeInformation.yaml), bluetoothDeviceToolTip, selectDatabaseToolTip
         (DeviceStatus.yaml). -->

    <SolidColorBrush x:Key="ToolTipBackground" Color="#1F2937"/>
    <SolidColorBrush x:Key="ToolTipText" Color="#FFFFFF"/>

    <Style TargetType="ToolTip">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource ToolTipText}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="HasDropShadow" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <!-- The margin leaves room for the shadow inside the transparent popup. -->
                    <Border x:Name="Frame" Margin="0,0,6,6" CornerRadius="6" Padding="8,6" MaxWidth="280"
                            Background="{StaticResource ToolTipBackground}">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="8" ShadowDepth="2" Direction="270" Opacity="0.25"/>
                        </Border.Effect>
                        <Border.Resources>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextWrapping" Value="Wrap"/>
                            </Style>
                        </Border.Resources>
                        <ContentPresenter/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ⓘ next to a field label: a small focusable button with no action. Hover or Tab to it to see its tooltip.
         Set infra:Tip.Text and AutomationProperties.Name ("About <label>"). -->
    <Geometry x:Key="InfoIconGeometry">M2,12 A10,10 0 1 0 22,12 A10,10 0 1 0 2,12 Z M12,11 L12,17 M12,7.4 L12,7.6</Geometry>
    <Style x:Key="InfoIcon" TargetType="Button">
        <Setter Property="Width" Value="18"/>
        <Setter Property="Height" Value="18"/>
        <Setter Property="Margin" Value="3,-2,0,-2"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="#6B7280"/>
        <Setter Property="Cursor" Value="Help"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="AutomationProperties.AutomationId" Value="InfoIcon"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Frame" Background="{TemplateBinding Background}" CornerRadius="9" BorderThickness="1.5" BorderBrush="Transparent">
                        <Path Data="{StaticResource InfoIconGeometry}" Width="13" Height="13" Stretch="Uniform"
                              Stroke="{TemplateBinding Foreground}" StrokeThickness="1.8"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="#2563EB"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter Property="Foreground" Value="#2563EB"/>
                            <Setter TargetName="Frame" Property="BorderBrush" Value="#2563EB"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Texts ===== -->
    <!-- Sidebar and every page header -->
    <sys:String x:Key="TipSidebarToggle">Collapse or expand the sidebar</sys:String>
    <sys:String x:Key="TipHelp">Open help for this page (F1)</sys:String>
    <sys:String x:Key="TipConnection">Online: connected to the server. Offline: data is saved on this laptop only.</sys:String>
    <sys:String x:Key="TipDismiss">Dismiss</sys:String>

    <!-- Core Information -->
    <sys:String x:Key="TipDrillhole">The drillhole you are measuring</sys:String>
    <sys:String x:Key="TipProject">Project this drillhole belongs to</sys:String>
    <sys:String x:Key="TipCampaign">Drilling campaign, usually the year</sys:String>
    <sys:String x:Key="TipOperator">Name of the person taking measurements</sys:String>
    <sys:String x:Key="TipRetryDrillholes">Try again to load the drillhole list from the server</sys:String>
    <sys:String x:Key="TipSaveAndContinue">Save and go to Measurement</sys:String>
    <sys:String x:Key="TipSaveAndContinueDisabled">Fill Drillhole, Project and Campaign to continue</sys:String>
    <sys:String x:Key="TipDeviceStatus">Shows whether the CT007 device is connected</sys:String>
    <sys:String x:Key="TipMeasurementDatabaseStatus">Shows whether readings can be saved on this laptop</sys:String>
    <sys:String x:Key="TipGammaGuardStatus">Shows whether the GammaGuard database was found</sys:String>
    <sys:String x:Key="TipRetryDatabase">Check the database again</sys:String>

    <!-- Measurement -->
    <sys:String x:Key="TipStartingDepth">Depth where this measurement run begins</sys:String>
    <sys:String x:Key="TipStep">Length of each measurement interval</sys:String>
    <sys:String x:Key="TipThreshold">Readings above this value are flagged and shown as a red line</sys:String>
    <sys:String x:Key="TipStart">Start the measurement countdown</sys:String>
    <sys:String x:Key="TipStop">Stop measuring. Captured readings are kept.</sys:String>
    <sys:String x:Key="TipStartDisabled">Save a drillhole on Core Information first</sys:String>
    <sys:String x:Key="TipCountdown">Time left in the current interval</sys:String>
    <sys:String x:Key="TipCountdownDisabled">Wait for the capture to finish to change the duration</sys:String>
    <sys:String x:Key="TipLive">Current reading from the device</sys:String>
    <sys:String x:Key="TipLiveUnit">Counts per second or per minute (CPS × 60)</sys:String>
    <sys:String x:Key="TipThresholdLine">Show or hide the threshold line</sys:String>
    <sys:String x:Key="TipGraph">Right-click anywhere on this page to capture the next interval</sys:String>
    <sys:String x:Key="TipNewMeasurement">Start a new measurement run</sys:String>
    <sys:String x:Key="TipNewMeasurementDisabled">Stop measuring first to start a new run</sys:String>
    <sys:String x:Key="TipExport">Save the table as a CSV file</sys:String>
    <sys:String x:Key="TipExportDisabled">Nothing to export yet</sys:String>
    <sys:String x:Key="TipDeleteRow">Delete this row</sys:String>
    <sys:String x:Key="TipDeleteRowDisabled">Rows can't be changed after upload</sys:String>

    <!-- Monitoring -->
    <sys:String x:Key="TipOpenCoreInformation">Go to Core Information to pick the database</sys:String>
    <sys:String x:Key="TipTakeSample">Skip the next reading, then average the 5 after it</sys:String>
    <sys:String x:Key="TipSampleNeedsResponse">5-second samples need a 1 s response time</sys:String>
    <sys:String x:Key="TipRecentReadings">Show or hide the latest readings</sys:String>
    <sys:String x:Key="TipDoseRate">Dose rate reported by the detector</sys:String>
    <sys:String x:Key="TipCoverage">Seconds of readings in this sample</sys:String>
    <sys:String x:Key="TipHdm">Detector's HDM value</sys:String>

    <!-- Upload Data -->
    <sys:String x:Key="TipImport">Open a CSV exported from the Measurement page</sys:String>
    <sys:String x:Key="TipImportDisabled">Wait for the upload to finish</sys:String>
    <sys:String x:Key="TipUpload">Send these rows to the central database</sys:String>
    <sys:String x:Key="TipUploadDisabled">Import a CSV with rows to upload</sys:String>
    <sys:String x:Key="TipUploaded">Already uploaded</sys:String>
    <sys:String x:Key="TipUploadingUser">Your Windows account, saved with the upload</sys:String>

    <!-- Data Viewer -->
    <sys:String x:Key="TipViewerDrillhole">Type part of the ID, then pick it</sys:String>
    <sys:String x:Key="TipViewerRefresh">Load the latest uploaded data</sys:String>
</ResourceDictionary>
