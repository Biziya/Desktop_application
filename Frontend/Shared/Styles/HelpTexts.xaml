<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!-- Screen-reader help texts (AutomationProperties.HelpText), kept in one place so the wording can be reviewed.
         The app shows no tooltips: what a field or button does is explained in Help (Config/help.yaml, "Buttons and
         fields"). One short sentence each, with the same names as the labels on screen. A few texts sit with their page
         labels in YAML: modeHelpText, drillholeLockedHelpText, clearDrillholeHelpText, cancelAddHelpText,
         localTagHelpText (DrillholeInformation.yaml), bluetoothDeviceHelpText, selectDatabaseHelpText (DeviceStatus.yaml). -->

    <!-- Sidebar and every page header -->
    <sys:String x:Key="HelpTextSidebarToggle">Collapse or expand the sidebar</sys:String>
    <sys:String x:Key="HelpTextHelp">Open or close help for this page (F1)</sys:String>
    <sys:String x:Key="HelpTextConnection">Online: connected to the server. Offline: data is saved on this laptop only.</sys:String>
    <sys:String x:Key="HelpTextDismiss">Dismiss</sys:String>

    <!-- Core Information -->
    <sys:String x:Key="HelpTextDrillhole">The drillhole you are measuring</sys:String>
    <sys:String x:Key="HelpTextProject">Project this drillhole belongs to</sys:String>
    <sys:String x:Key="HelpTextCampaign">Drilling campaign, usually the year</sys:String>
    <sys:String x:Key="HelpTextOperator">Name of the person taking measurements</sys:String>
    <sys:String x:Key="HelpTextRetryDrillholes">Try again to load the drillhole list from the server</sys:String>
    <sys:String x:Key="HelpTextSaveAndContinue">Save and go to Measurement</sys:String>
    <sys:String x:Key="HelpTextSaveAndContinueDisabled">Fill Drillhole, Project and Campaign to continue</sys:String>
    <sys:String x:Key="HelpTextDeviceStatus">Shows whether the CT007 device is connected</sys:String>
    <sys:String x:Key="HelpTextMeasurementDatabaseStatus">Shows whether readings can be saved on this laptop</sys:String>
    <sys:String x:Key="HelpTextGammaGuardStatus">Shows whether the GammaGuard database was found</sys:String>
    <sys:String x:Key="HelpTextRetryDatabase">Check the database again</sys:String>

    <!-- Measurement -->
    <sys:String x:Key="HelpTextStartingDepth">Depth where this measurement run begins</sys:String>
    <sys:String x:Key="HelpTextStep">Length of each measurement interval</sys:String>
    <sys:String x:Key="HelpTextThreshold">Readings above this value are flagged and shown as a red line</sys:String>
    <sys:String x:Key="HelpTextStart">Start the measurement countdown</sys:String>
    <sys:String x:Key="HelpTextStop">Stop measuring. Captured readings are kept.</sys:String>
    <sys:String x:Key="HelpTextStartDisabled">Save a drillhole on Core Information first</sys:String>
    <sys:String x:Key="HelpTextCountdown">Time left in the current interval</sys:String>
    <sys:String x:Key="HelpTextCountdownDisabled">Wait for the capture to finish to change the duration</sys:String>
    <sys:String x:Key="HelpTextLive">Current reading from the device</sys:String>
    <sys:String x:Key="HelpTextLiveUnit">Counts per second or per minute (CPS × 60)</sys:String>
    <sys:String x:Key="HelpTextThresholdLine">Show or hide the threshold line</sys:String>
    <sys:String x:Key="HelpTextGraph">Right-click anywhere on this page to capture the next interval</sys:String>
    <sys:String x:Key="HelpTextNewMeasurement">Start a new measurement run</sys:String>
    <sys:String x:Key="HelpTextNewMeasurementDisabled">Stop measuring first to start a new run</sys:String>
    <sys:String x:Key="HelpTextExport">Save the table as a CSV file</sys:String>
    <sys:String x:Key="HelpTextExportDisabled">Nothing to export yet</sys:String>
    <sys:String x:Key="HelpTextDeleteRow">Delete this row</sys:String>
    <sys:String x:Key="HelpTextDeleteRowDisabled">Rows can't be changed after upload</sys:String>

    <!-- Monitoring -->
    <sys:String x:Key="HelpTextOpenCoreInformation">Go to Core Information to pick the database</sys:String>
    <sys:String x:Key="HelpTextTakeSample">Skip the next reading, then average the 5 after it</sys:String>
    <sys:String x:Key="HelpTextSampleNeedsResponse">5-second samples need a 1 s response time</sys:String>
    <sys:String x:Key="HelpTextRecentReadings">Show or hide the latest readings</sys:String>
    <sys:String x:Key="HelpTextDoseRate">Dose rate reported by the detector</sys:String>
    <sys:String x:Key="HelpTextCoverage">Seconds of readings in this sample</sys:String>
    <sys:String x:Key="HelpTextHdm">Detector's HDM value</sys:String>

    <!-- Upload Data -->
    <sys:String x:Key="HelpTextImport">Open a CSV exported from the Measurement page</sys:String>
    <sys:String x:Key="HelpTextImportDisabled">Wait for the upload to finish</sys:String>
    <sys:String x:Key="HelpTextUpload">Send these rows to the central database</sys:String>
    <sys:String x:Key="HelpTextUploadDisabled">Import a CSV with rows to upload</sys:String>
    <sys:String x:Key="HelpTextUploaded">Already uploaded</sys:String>
    <sys:String x:Key="HelpTextUploadingUser">Your Windows account, saved with the upload</sys:String>

    <!-- Help drawer -->
    <sys:String x:Key="HelpTextCloseHelp">Close help (Esc)</sys:String>
    <sys:String x:Key="HelpTextHelpSearch">Search every help page (Ctrl+F)</sys:String>
    <sys:String x:Key="HelpTextHelpPage">Choose which help page to show</sys:String>
    <sys:String x:Key="HelpTextHelpEnlarge">Show the screenshot larger</sys:String>
    <sys:String x:Key="HelpTextHelpResize">Drag to make Help wider or narrower</sys:String>
    <sys:String x:Key="HelpTextCloseLightbox">Close the picture (Esc)</sys:String>

    <!-- Data Viewer -->
    <sys:String x:Key="HelpTextViewerDrillhole">Type part of the ID, then pick it</sys:String>
    <sys:String x:Key="HelpTextViewerRefresh">Load the latest uploaded data</sys:String>
</ResourceDictionary>
