<Window x:Class="Frontend.Shared.Help.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:infra="clr-namespace:Frontend.Shared.Infrastructure"
        Style="{StaticResource AppWindow}"
        Background="{StaticResource Surface}"
        Title="{Binding Page.Page, StringFormat=Help · {0}, FallbackValue=Help, TargetNullValue=Help}"
        Width="720" Height="660" MinWidth="520" MinHeight="400"
        WindowStyle="ToolWindow" ResizeMode="CanResizeWithGrip" ShowInTaskbar="False"
        AutomationProperties.Name="Help"
        AutomationProperties.AutomationId="HelpWindow">
    <!-- The single Help window (DataContext: HelpPanel). One section per page, scrolled to the page the user is on;
         the list on the left jumps to any section. F1 (toggle), Esc, the Close button and the window's × hide it
         (MainWindow shows it again where it was left). F1 and Esc are handled in PreviewKeyDown, so they work wherever
         the keyboard focus is. -->
    <Window.Resources>
        <infra:SameItemConverter x:Key="SameItemConverter"/>
        <!-- Section list entries: the page on screen is highlighted. -->
        <Style x:Key="SectionLink" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
            <Setter Property="Foreground" Value="{StaticResource LabelText}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Back" Background="{TemplateBinding Background}" CornerRadius="{StaticResource ControlRadius}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="{StaticResource HoverSurface}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="{StaticResource HoverSurface}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Footer: a large Close button. -->
        <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="20,12">
            <DockPanel>
                <Button x:Name="CloseButton" DockPanel.Dock="Right"
                        Content="Close" FontSize="16" FontWeight="SemiBold"
                        MinWidth="140" Height="44" Padding="24,0"
                        Command="{Binding CloseCommand}"
                        infra:Tip.Text="Close Help (Esc or F1)"
                        AutomationProperties.AutomationId="HelpCloseButton"
                        AutomationProperties.Name="Close Help"/>
                <TextBlock VerticalAlignment="Center" Style="{StaticResource MutedText}" FontSize="13" TextWrapping="Wrap">
                    <Run Text="F1" FontWeight="SemiBold"/><Run Text=" opens or closes Help · "/><Run Text="Esc" FontWeight="SemiBold"/><Run Text=" closes it"/>
                </TextBlock>
            </DockPanel>
        </Border>

        <!-- Section list (one per page, then Keyboard shortcuts). -->
        <Border DockPanel.Dock="Left" Width="180" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0" Padding="10,16">
            <StackPanel>
                <TextBlock Text="SECTIONS" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Muted}" Margin="12,0,0,8"/>
                <ItemsControl ItemsSource="{Binding Pages}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button x:Name="Link" Style="{StaticResource SectionLink}" Content="{Binding Page}"
                                    Command="{Binding DataContext.ShowSectionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"/>
                            <DataTemplate.Triggers>
                                <DataTrigger Value="True">
                                    <DataTrigger.Binding>
                                        <MultiBinding Converter="{StaticResource SameItemConverter}">
                                            <Binding/>
                                            <Binding Path="DataContext.Page" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                        </MultiBinding>
                                    </DataTrigger.Binding>
                                    <Setter TargetName="Link" Property="Background" Value="{StaticResource SoftBlue}"/>
                                    <Setter TargetName="Link" Property="Foreground" Value="{StaticResource Blue}"/>
                                    <Setter TargetName="Link" Property="FontWeight" Value="SemiBold"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Style="{StaticResource SectionLink}" Content="Keyboard shortcuts" Click="ShowShortcuts"
                        Visibility="{Binding HasShortcuts, Converter={StaticResource BoolVisibility}}"/>
            </StackPanel>
        </Border>

        <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <StackPanel x:Name="Sections" Margin="28,20,28,28">
                <ItemsControl x:Name="PageSections" ItemsSource="{Binding Pages}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,36">
                                <TextBlock Text="{Binding Page}" Style="{StaticResource PageTitle}" FontSize="22"/>
                                <TextBlock Text="{Binding Purpose}" TextWrapping="Wrap" FontSize="15"
                                           Foreground="{StaticResource LabelText}" Margin="0,6,0,14"/>

                                <!-- What blocks the work on this page, before the controls (help.yaml "important"). -->
                                <Border Style="{StaticResource WarningBanner}" Margin="0,0,0,16"
                                        Visibility="{Binding HasImportant, Converter={StaticResource BoolVisibility}}">
                                    <StackPanel>
                                        <TextBlock Text="Before you start" FontWeight="Bold" Margin="0,0,0,6"/>
                                        <ItemsControl ItemsSource="{Binding Important}" Focusable="False">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <DockPanel Margin="0,0,0,6">
                                                        <TextBlock DockPanel.Dock="Left" Text="•" Margin="0,0,8,0"/>
                                                        <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{StaticResource TextPrimary}"/>
                                                    </DockPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <!-- Screenshot of the page (help.yaml "image"); hidden when the file is missing. -->
                                <Border BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="{StaticResource ControlRadius}"
                                        Margin="0,0,0,16" Padding="4" HorizontalAlignment="Left"
                                        Visibility="{Binding HasImage, Converter={StaticResource BoolVisibility}}">
                                    <Image Source="{Binding ImagePath, TargetNullValue={x:Null}}" Stretch="Uniform" MaxHeight="320"
                                           RenderOptions.BitmapScalingMode="HighQuality"
                                           AutomationProperties.Name="{Binding Page, StringFormat=Screenshot of {0}}"/>
                                </Border>

                                <TextBlock Text="Buttons and fields" Style="{StaticResource CardTitle}" Margin="0,0,0,6"/>
                                <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="0,9">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="190"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Control}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,12,0"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Does}" Style="{StaticResource MutedText}" FontSize="13" TextWrapping="Wrap"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Keyboard shortcuts (help.yaml "shortcuts"). -->
                <StackPanel x:Name="ShortcutsSection" Visibility="{Binding HasShortcuts, Converter={StaticResource BoolVisibility}}">
                    <TextBlock Text="Keyboard shortcuts" Style="{StaticResource PageTitle}" FontSize="22" Margin="0,0,0,12"/>
                    <ItemsControl ItemsSource="{Binding Shortcuts}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="0,9">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="190"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Padding="8,2" Margin="0,0,12,0"
                                                Background="{StaticResource HoverSurface}" BorderBrush="{StaticResource InputBorder}" BorderThickness="1"
                                                CornerRadius="4">
                                            <TextBlock Text="{Binding Keys}" FontFamily="Consolas" FontWeight="SemiBold"/>
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="{Binding Does}" Style="{StaticResource MutedText}" FontSize="13" TextWrapping="Wrap"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
