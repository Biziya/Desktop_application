<Window x:Class="Frontend.Shared.Help.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppWindow}"
        Background="{StaticResource Surface}"
        Title="{Binding Page.Page, StringFormat=Help · {0}, FallbackValue=Help, TargetNullValue=Help}"
        Width="460" Height="560" MinWidth="360" MinHeight="320"
        WindowStyle="ToolWindow" ResizeMode="CanResizeWithGrip" ShowInTaskbar="False"
        AutomationProperties.Name="Help">
    <!-- Floating Help for the page on screen (DataContext: HelpPanel). Stays above the app, follows navigation;
         Esc or the window's × hides it (MainWindow shows it again where it was left). -->
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CloseCommand}"/>
        <KeyBinding Key="F1" Command="{Binding CloseCommand}"/>
    </Window.InputBindings>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <StackPanel Margin="24,20,24,24">
            <TextBlock Text="{Binding Page.Page, FallbackValue=Help, TargetNullValue=Help}" Style="{StaticResource PageTitle}" FontSize="20"/>
            <TextBlock Text="{Binding Page.Purpose, FallbackValue=''}" TextWrapping="Wrap" FontSize="15"
                       Foreground="{StaticResource LabelText}" Margin="0,6,0,18"/>

            <!-- What blocks the work on this page, before the controls (help.yaml "important"). -->
            <Border Style="{StaticResource WarningBanner}" Margin="0,0,0,20"
                    Visibility="{Binding Page.HasImportant, Converter={StaticResource BoolVisibility}, FallbackValue=Collapsed}">
                <StackPanel>
                    <TextBlock Text="Before you start" FontWeight="Bold" Margin="0,0,0,6"/>
                    <ItemsControl ItemsSource="{Binding Page.Important}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock DockPanel.Dock="Left" Text="•" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{StaticResource TextPrimary}"/>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <TextBlock Text="Buttons on this page" Style="{StaticResource CardTitle}" Margin="0,0,0,10"/>
            <ItemsControl ItemsSource="{Binding Page.Items}" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="0,10">
                            <StackPanel>
                                <TextBlock Text="{Binding Control}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Does}" Style="{StaticResource MutedText}" FontSize="13" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Window>
