<UserControl x:Class="Frontend.Shared.Help.HelpDrawer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:Frontend.Shared.Infrastructure"
             xmlns:help="clr-namespace:Frontend.Shared.Help"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             Focusable="False">
    <!-- The Help drawer (DataContext: HelpPanel), an overlay over the whole main window, in three layers:
         1. Backdrop: a light dim, not on the Measurement page (HelpPanel.ShowsBackdrop); a click on it closes Help.
         2. Drawer: slides in from the right; header (title, ×, search, page selector, "On this page" chips), the page's
            help on the 6-part template (help.yaml), footer hint. Its left edge can be dragged to resize it.
         3. Lightbox: a screenshot enlarged over the whole window.
         Where nothing is shown the overlay takes no clicks, so the page underneath stays usable. Keys (F1, Esc, Ctrl+F)
         are handled by MainWindow. -->
    <UserControl.Resources>
        <Geometry x:Key="TipCalloutIcon">M9,18 L15,18 M10,21 L14,21 M12,3 A6,6 0 0 0 8.2,13.6 C8.9,14.3 9,15 9,16 L15,16 C15,15 15.1,14.3 15.8,13.6 A6,6 0 0 0 12,3 Z</Geometry>
        <Geometry x:Key="WarningCalloutIcon">M12,3 L22,20 2,20 Z M12,9.5 L12,14 M12,16.9 L12,17.1</Geometry>
        <Geometry x:Key="SearchIcon">M3,10 A7,7 0 1 0 17,10 A7,7 0 1 0 3,10 Z M15.2,15.2 L21,21</Geometry>
        <SolidColorBrush x:Key="Dim" Color="#000000" Opacity="0.18"/>
        <sys:Double x:Key="MarkerSize">17</sys:Double>
        <SolidColorBrush x:Key="LightboxDim" Color="#0F172A" Opacity="0.82"/>

        <!-- Body text: 14 px, line height 1.5. -->
        <Style x:Key="Body" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="LineHeight" Value="21"/>
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{StaticResource LabelText}"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style x:Key="Section" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,0,28"/>
        </Style>

        <!-- Numbered marker: the same circle on the screenshot, in the lightbox and before an item's name. -->
        <Style x:Key="MarkerBadge" TargetType="Border">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="CornerRadius" Value="11"/>
            <Setter Property="Background" Value="{StaticResource Blue}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Surface}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>
        <Style x:Key="MarkerText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Surface}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- The screenshot with its markers; the markers stay crisp at any size. -->
        <DataTemplate x:Key="MarkedScreenshot" DataType="{x:Type help:HelpSettings+HelpPage}">
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                <Image Source="{Binding ImagePath, TargetNullValue={x:Null}}" Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <ItemsControl ItemsSource="{Binding Markers}" Focusable="False" IsHitTestVisible="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><infra:FractionPanel/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="infra:FractionPanel.X" Value="{Binding X}"/>
                            <Setter Property="infra:FractionPanel.Y" Value="{Binding Y}"/>
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- MarkerSize: small on the drawer's picture, larger in the lightbox. -->
                            <Viewbox Width="{DynamicResource MarkerSize}" Height="{DynamicResource MarkerSize}">
                                <Border Style="{StaticResource MarkerBadge}">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.35"/>
                                    </Border.Effect>
                                    <TextBlock Text="{Binding N}" Style="{StaticResource MarkerText}"/>
                                </Border>
                            </Viewbox>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </DataTemplate>

        <!-- Tip (blue), Note (yellow) and Warning (red) boxes: icon, bold label, text. -->
        <Style x:Key="Callout" TargetType="Border">
            <Setter Property="CornerRadius" Value="{StaticResource ControlRadius}"/>
            <Setter Property="BorderThickness" Value="4,0,0,0"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,12,0,0"/>
            <Setter Property="Background" Value="{StaticResource WarningSurface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Warning}"/>
            <Setter Property="TextElement.Foreground" Value="{StaticResource Warning}"/>
        </Style>
        <DataTemplate x:Key="CalloutTemplate" DataType="{x:Type help:HelpSettings+HelpCallout}">
            <Border x:Name="Box" Style="{StaticResource Callout}" AutomationProperties.Name="{Binding Label}">
                <DockPanel>
                    <Path x:Name="Icon" DockPanel.Dock="Left" Data="{StaticResource CalloutInfoGeometry}" Width="16" Height="16"
                          Style="{StaticResource StrokeIcon}" Margin="0,2,10,0" VerticalAlignment="Top"
                          Stroke="{Binding BorderBrush, ElementName=Box}"/>
                    <TextBlock Style="{StaticResource Body}" Foreground="{StaticResource TextPrimary}">
                        <Run x:Name="Label" Text="{Binding Label, Mode=OneWay}" FontWeight="Bold"
                             Foreground="{Binding BorderBrush, ElementName=Box}"/><Run Text="  "/><Run Text="{Binding Text, Mode=OneWay}"/>
                    </TextBlock>
                </DockPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="tip">
                    <Setter TargetName="Box" Property="Background" Value="{StaticResource SoftBlue}"/>
                    <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Blue}"/>
                    <Setter TargetName="Icon" Property="Data" Value="{StaticResource TipCalloutIcon}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="warning">
                    <Setter TargetName="Box" Property="Background" Value="{StaticResource DangerSurface}"/>
                    <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Danger}"/>
                    <Setter TargetName="Icon" Property="Data" Value="{StaticResource WarningCalloutIcon}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- "On this page" chip; the section in view is blue. -->
        <Style x:Key="Chip" TargetType="Button">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource LabelText}"/>
            <Setter Property="Background" Value="{StaticResource HoverSurface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource InputBorder}"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Pill" CornerRadius="12" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource InputHoverBorder}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource Blue}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter Property="Background" Value="{StaticResource SoftBlue}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource Blue}"/>
                    <Setter Property="Foreground" Value="{StaticResource Blue}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- A plain clickable area (the screenshot, a search result): hover tint, blue focus ring. -->
        <Style x:Key="PlainButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Frame" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"
                                CornerRadius="{StaticResource ControlRadius}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1.5">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Frame" Property="Background" Value="{StaticResource HoverSurface}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource Blue}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- 1. Backdrop -->
        <Border x:Name="Backdrop" Background="{StaticResource Dim}" Visibility="Collapsed"
                MouseDown="BackdropPressed" AutomationProperties.AutomationId="HelpBackdrop"/>

        <!-- 2. Drawer -->
        <Border x:Name="Drawer" HorizontalAlignment="Right" Width="{x:Static help:HelpPanel.DefaultWidth}" Visibility="Collapsed"
                Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0"
                AutomationProperties.AutomationId="HelpDrawer" AutomationProperties.Name="Help"
                KeyboardNavigation.TabNavigation="Continue">
            <Border.RenderTransform>
                <TranslateTransform x:Name="Slide"/>
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect Direction="180" ShadowDepth="0" BlurRadius="24" Opacity="0.16"/>
            </Border.Effect>
            <Grid>
                <DockPanel>
                    <!-- Header -->
                    <StackPanel DockPanel.Dock="Top" Margin="20,14,14,0">
                        <DockPanel>
                            <Button x:Name="CloseButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}"
                                    Command="{Binding CloseCommand}" AutomationProperties.HelpText="{StaticResource HelpTextCloseHelp}"
                                    AutomationProperties.Name="Close help" AutomationProperties.AutomationId="HelpCloseButton">
                                <Path Data="{StaticResource CloseIcon}" Width="12" Height="12" Stretch="Uniform" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            </Button>
                            <TextBlock Text="Help" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                        </DockPanel>

                        <Grid Margin="0,4,6,0">
                            <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="34,0,11,0"
                                     infra:TextBoxHint.Placeholder="Search help"
                                     AutomationProperties.HelpText="{StaticResource HelpTextHelpSearch}"
                                     AutomationProperties.Name="Search help" AutomationProperties.AutomationId="HelpSearch"/>
                            <Path Data="{StaticResource SearchIcon}" Width="14" Height="14" Style="{StaticResource StrokeIcon}" Margin="12,7,0,0"
                                  HorizontalAlignment="Left" Stroke="{StaticResource Muted}" IsHitTestVisible="False"/>
                        </Grid>

                        <ComboBox x:Name="PageSelector" Margin="0,8,6,0" ItemsSource="{Binding Entries}" DisplayMemberPath="Title"
                                  SelectedItem="{Binding Selected}" AutomationProperties.HelpText="{StaticResource HelpTextHelpPage}"
                                  AutomationProperties.Name="Help page" AutomationProperties.AutomationId="HelpPageSelector"/>

                        <!-- On this page -->
                        <StackPanel Margin="0,12,0,0" Visibility="{Binding Page, Converter={StaticResource NotNullVisibility}}">
                            <TextBlock Text="ON THIS PAGE" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Muted}" Margin="0,0,0,6"/>
                            <ItemsControl x:Name="ChipList" ItemsSource="{Binding Chips}" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource Chip}" Content="{Binding Title}"
                                                Command="{Binding DataContext.ScrollToSectionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding Section}"
                                                AutomationProperties.Name="{Binding Title}" AutomationProperties.AutomationId="HelpChip"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <Border Height="1" Background="{StaticResource Line}" Margin="-20,8,-14,0"/>
                    </StackPanel>

                    <!-- Footer -->
                    <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="20,10">
                        <TextBlock FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap">
                            <Run Text="F1" FontWeight="SemiBold"/><Run Text=" opens or closes Help · "/><Run Text="Esc" FontWeight="SemiBold"/><Run Text=" closes it"/>
                        </TextBlock>
                    </Border>

                    <Grid>
                        <!-- The help of the page chosen (or Keyboard shortcuts) -->
                        <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                      Focusable="False" ScrollChanged="ScrollerScrolled"
                                      Visibility="{Binding IsSearching, Converter={StaticResource InverseBoolVisibility}}">
                            <Grid Margin="20,18,20,8">
                                <StackPanel x:Name="PageContent" DataContext="{Binding Page}"
                                            Visibility="{Binding Converter={StaticResource NotNullVisibility}}">
                                    <!-- 1. Title and purpose -->
                                    <TextBlock Text="{Binding Page}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock Text="{Binding Purpose}" Style="{StaticResource Body}" FontSize="15" Margin="0,4,0,16"/>

                                    <!-- 2. Before you start -->
                                    <StackPanel x:Name="BeforeSection" Style="{StaticResource Section}"
                                                Visibility="{Binding HasBeforeYouStart, Converter={StaticResource BoolVisibility}}">
                                        <Border Style="{StaticResource Callout}" Margin="0" AutomationProperties.Name="Before you start">
                                            <DockPanel>
                                                <Path DockPanel.Dock="Left" Data="{StaticResource CalloutInfoGeometry}" Width="16" Height="16" Style="{StaticResource StrokeIcon}"
                                                      Margin="0,2,10,0" VerticalAlignment="Top" Stroke="{StaticResource Warning}"/>
                                                <StackPanel>
                                                    <TextBlock Text="Before you start" FontSize="14" FontWeight="Bold" Margin="0,0,0,4"/>
                                                    <ItemsControl ItemsSource="{Binding BeforeYouStart}" Focusable="False">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <DockPanel Margin="0,0,0,2">
                                                                    <TextBlock DockPanel.Dock="Left" Text="•" Margin="0,0,8,0" Style="{StaticResource Body}"
                                                                               Foreground="{StaticResource Warning}"/>
                                                                    <TextBlock Text="{Binding}" Style="{StaticResource Body}" Foreground="{StaticResource TextPrimary}"/>
                                                                </DockPanel>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </StackPanel>

                                    <!-- 3. Screenshot: click (or Enter) to enlarge -->
                                    <Button x:Name="Screenshot" Style="{StaticResource PlainButton}" Padding="0" Margin="0,0,0,28"
                                            Command="{Binding DataContext.OpenLightboxCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            AutomationProperties.HelpText="{StaticResource HelpTextHelpEnlarge}"
                                            AutomationProperties.Name="{Binding Page, StringFormat=Enlarge the screenshot of {0}}"
                                            AutomationProperties.AutomationId="HelpScreenshot"
                                            Visibility="{Binding HasImage, Converter={StaticResource BoolVisibility}}">
                                        <Border BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="{StaticResource ControlRadius}" Padding="3">
                                            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource MarkedScreenshot}" Focusable="False"/>
                                        </Border>
                                    </Button>

                                    <!-- 4. Steps -->
                                    <StackPanel x:Name="StepsSection" Style="{StaticResource Section}">
                                        <TextBlock Text="Steps" Style="{StaticResource SectionTitle}"/>
                                        <ItemsControl ItemsSource="{Binding NumberedSteps}" Focusable="False">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <DockPanel Margin="0,0,0,8">
                                                        <Border DockPanel.Dock="Left" Width="22" Height="22" CornerRadius="11" Margin="0,0,10,0"
                                                                VerticalAlignment="Top" Background="{StaticResource SoftBlue}">
                                                            <TextBlock Text="{Binding Number}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource Blue}"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <TextBlock Text="{Binding Text}" Style="{StaticResource Body}" Foreground="{StaticResource TextPrimary}"/>
                                                    </DockPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <ItemsControl ItemsSource="{Binding StepsCallouts}" ItemTemplate="{StaticResource CalloutTemplate}" Focusable="False"/>
                                    </StackPanel>

                                    <!-- 5. Buttons and fields -->
                                    <StackPanel x:Name="ItemsSection" Style="{StaticResource Section}">
                                        <TextBlock Text="Buttons and fields" Style="{StaticResource SectionTitle}"/>
                                        <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="0,8">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="28"/>
                                                                <ColumnDefinition Width="118"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Border Style="{StaticResource MarkerBadge}" HorizontalAlignment="Left" VerticalAlignment="Top"
                                                                    BorderThickness="0"
                                                                    Visibility="{Binding Marker, Converter={StaticResource NotNullVisibility}}">
                                                                <TextBlock Text="{Binding Marker}" Style="{StaticResource MarkerText}"/>
                                                            </Border>
                                                            <TextBlock Grid.Column="1" Text="{Binding Control}" Style="{StaticResource Body}" FontWeight="SemiBold"
                                                                       Foreground="{StaticResource TextPrimary}" Margin="0,0,10,0"/>
                                                            <TextBlock Grid.Column="2" Text="{Binding Does}" Style="{StaticResource Body}"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <ItemsControl ItemsSource="{Binding ItemsCallouts}" ItemTemplate="{StaticResource CalloutTemplate}" Focusable="False"/>
                                    </StackPanel>

                                    <!-- 6. Troubleshooting -->
                                    <StackPanel x:Name="TroubleshootingSection" Style="{StaticResource Section}">
                                        <TextBlock Text="Troubleshooting" Style="{StaticResource SectionTitle}"/>
                                        <ItemsControl ItemsSource="{Binding Troubleshooting}" Focusable="False">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="0,8">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Problem}" Style="{StaticResource Body}" FontWeight="SemiBold"
                                                                       Foreground="{StaticResource TextPrimary}"/>
                                                            <TextBlock Text="{Binding Fix}" Style="{StaticResource Body}" Margin="0,2,0,0"/>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <ItemsControl ItemsSource="{Binding TroubleshootingCallouts}" ItemTemplate="{StaticResource CalloutTemplate}" Focusable="False"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Keyboard shortcuts -->
                                <StackPanel x:Name="ShortcutsContent"
                                            Visibility="{Binding IsShortcutsShown, Converter={StaticResource BoolVisibility}}">
                                    <TextBlock Text="Keyboard shortcuts" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock Text="Keys and clicks that work across the app." Style="{StaticResource Body}" FontSize="15" Margin="0,4,0,16"/>
                                    <ItemsControl ItemsSource="{Binding Shortcuts}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="0,8">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="120"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Padding="8,2" Margin="0,0,10,0"
                                                                Background="{StaticResource HoverSurface}" BorderBrush="{StaticResource InputBorder}"
                                                                BorderThickness="1" CornerRadius="4">
                                                            <TextBlock Text="{Binding Keys}" FontFamily="Consolas" FontWeight="SemiBold" FontSize="13"/>
                                                        </Border>
                                                        <TextBlock Grid.Column="1" Text="{Binding Does}" Style="{StaticResource Body}"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Controls on every page (sidebar, header, Help itself): name | what it does -->
                                    <StackPanel Visibility="{Binding HasControls, Converter={StaticResource BoolVisibility}}">
                                        <TextBlock Text="Controls on every page" FontSize="17" FontWeight="Bold" Margin="0,24,0,8"
                                                   Foreground="{StaticResource TextPrimary}"/>
                                        <ItemsControl ItemsSource="{Binding Controls}" Focusable="False"
                                                      AutomationProperties.AutomationId="HelpAppControls">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="0,8">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="120"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Control}" Style="{StaticResource Body}" FontWeight="SemiBold" Margin="0,0,10,0"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding Does}" Style="{StaticResource Body}"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>

                        <!-- Search results -->
                        <ScrollViewer x:Name="Results" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False"
                                      Visibility="{Binding IsSearching, Converter={StaticResource BoolVisibility}}">
                            <StackPanel Margin="12,12,12,8">
                                <TextBlock Text="No help matches your search." Style="{StaticResource Body}" Margin="8,4"
                                           Visibility="{Binding HasNoResults, Converter={StaticResource BoolVisibility}}"/>
                                <ItemsControl x:Name="ResultList" ItemsSource="{Binding SearchResults}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource PlainButton}" Padding="8,8" Margin="0,0,0,2"
                                                    Command="{Binding DataContext.OpenResultCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" AutomationProperties.Name="{Binding Location}"
                                                    AutomationProperties.AutomationId="HelpSearchResult">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Location}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Blue}"/>
                                                    <TextBlock Text="{Binding Snippet}" Style="{StaticResource Body}" Foreground="{StaticResource TextPrimary}"
                                                               Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </DockPanel>

                <!-- Left edge: drag to resize (the width is remembered). -->
                <Thumb x:Name="ResizeGrip" HorizontalAlignment="Left" Width="6" Margin="-3,0,0,0" Cursor="SizeWE"
                       DragDelta="ResizeDragged" DragCompleted="ResizeFinished" Focusable="False"
                       AutomationProperties.HelpText="{StaticResource HelpTextHelpResize}" AutomationProperties.AutomationId="HelpResizeGrip">
                    <Thumb.Template>
                        <ControlTemplate TargetType="Thumb">
                            <Border Background="Transparent"/>
                        </ControlTemplate>
                    </Thumb.Template>
                </Thumb>
            </Grid>
        </Border>

        <!-- 3. Lightbox -->
        <Grid x:Name="Lightbox" Background="{StaticResource LightboxDim}" Visibility="Collapsed"
              MouseLeftButtonDown="LightboxPressed" AutomationProperties.AutomationId="HelpLightbox"
              AutomationProperties.Name="Enlarged screenshot">
            <ContentControl Content="{Binding LightboxPage}" ContentTemplate="{StaticResource MarkedScreenshot}" Margin="48,56,48,48"
                            Focusable="False">
                <ContentControl.Resources>
                    <sys:Double x:Key="MarkerSize">30</sys:Double>
                </ContentControl.Resources>
            </ContentControl>
            <Button x:Name="LightboxClose" Style="{StaticResource IconButton}" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,12,12,0" Foreground="{StaticResource Surface}" Command="{Binding CloseLightboxCommand}"
                    AutomationProperties.HelpText="{StaticResource HelpTextCloseLightbox}" AutomationProperties.Name="Close the picture"
                    AutomationProperties.AutomationId="HelpLightboxClose">
                <Path Data="{StaticResource CloseIcon}" Width="14" Height="14" Stretch="Uniform" StrokeThickness="2"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stroke="{StaticResource Surface}"/>
            </Button>
        </Grid>
    </Grid>
</UserControl>
