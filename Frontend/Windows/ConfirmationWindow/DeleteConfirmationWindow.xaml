<Window x:Class="Frontend.Windows.ConfirmationWindow.DeleteConfirmationWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Delete measurement" Width="420" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
 <Border Style="{StaticResource Card}" Margin="12" Padding="24"><StackPanel><TextBlock Text="Delete this measurement?" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="This removes the selected result." Style="{StaticResource MutedText}" Margin="0,10,0,24"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Cancel" IsCancel="True" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0"/><Button Content="Delete" Background="{StaticResource Danger}" Click="Confirm"/></StackPanel></StackPanel></Border>
</Window>
