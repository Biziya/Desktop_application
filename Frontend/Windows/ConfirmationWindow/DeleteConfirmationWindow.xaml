<Window x:Class="Frontend.Windows.ConfirmationWindow.DeleteConfirmationWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Delete measurement" Width="390" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
 <StackPanel Margin="28"><TextBlock Text="Delete this measurement?" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="This removes the selected result." Style="{StaticResource MutedText}" Margin="0,12,0,24"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Cancel" IsCancel="True" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0"/><Button Content="Delete" Background="#D9334C" Click="Confirm"/></StackPanel></StackPanel>
</Window>
