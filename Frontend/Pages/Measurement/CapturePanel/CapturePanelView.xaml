<UserControl x:Class="Frontend.Pages.Measurement.CapturePanel.CapturePanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Frontend.Pages.Measurement.CapturePanel"
             xmlns:calc="clr-namespace:Frontend.Calculation.Measurement">
    <!-- Control row: control column (Starting Depth, Step, Start / Stop toggle — all the same width) | countdown | bar chart
         (remaining width). "to" is calculated (from + step), so there is no To input. Depth edits, also during acquisition,
         apply from the next capture. The chart takes the remaining width (about 205 px at the smallest window).
         Labels and sizes: CapturePanel.yaml (application resources). -->
    <UserControl.Resources>
        <ResourceDictionary>
            <!-- Countdown (a button: click to edit the capture duration). No fill or frame; hover tints the ring area,
                 keyboard focus draws a blue circle. When disabled (a capture is running) the countdown looks exactly the
                 same — it just cannot be clicked. -->
            <Style x:Key="CountdownButton" TargetType="Button">
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid Background="Transparent">
                                <Ellipse x:Name="Hover" Fill="{StaticResource SoftBlue}" Opacity="0" Margin="6"/>
                                <ContentPresenter/>
                                <Ellipse x:Name="Focus" Stroke="{StaticResource Blue}" StrokeThickness="1.5" StrokeDashArray="3 2" Visibility="Collapsed"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Hover" Property="Opacity" Value="1"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Focus" Property="Visibility" Value="Visible"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Cursor" Value="Arrow"/>
                                    <Setter TargetName="Hover" Property="Opacity" Value="0"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- One toggle: green "Start" while stopped, red "Stop" while measuring. Exactly as tall as the Starting Depth
                 and Step boxes (the box, not their labels). -->
            <Style x:Key="StartStopButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="FontSize" Value="{StaticResource StartStopButtonFontSize}"/>
                <Setter Property="MinWidth" Value="{StaticResource StartStopButtonWidth}"/>
                <Setter Property="Height" Value="{StaticResource ControlHeight}"/>
                <Setter Property="MinHeight" Value="0"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Padding" Value="{StaticResource StartStopButtonPadding}"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="Background" Value="{StaticResource Success}"/>
                <Setter Property="AutomationProperties.Name" Value="Start measurement"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsMeasurementModeActive}" Value="True">
                        <Setter Property="Background" Value="{StaticResource Danger}"/>
                        <Setter Property="AutomationProperties.Name" Value="Stop measurement"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- Glyph and label of the Start / Stop toggle; they switch with IsMeasurementModeActive. -->
            <Style x:Key="StartStopGlyph" TargetType="Run">
                <Setter Property="FontSize" Value="{StaticResource StartStopButtonIconFontSize}"/>
                <Setter Property="Text" Value="{StaticResource StartGlyph}"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsMeasurementModeActive}" Value="True">
                        <Setter Property="Text" Value="{StaticResource StopGlyph}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="StartStopLabel" TargetType="Run">
                <Setter Property="Text" Value="{StaticResource StartLabel}"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsMeasurementModeActive}" Value="True">
                        <Setter Property="Text" Value="{StaticResource StopLabel}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Width="{StaticResource StartStopButtonWidth}" VerticalAlignment="Center">
            <TextBlock Text="{StaticResource StartingDepthLabel}" Style="{StaticResource FieldLabel}" FontSize="{StaticResource CaptureLabelFontSize}"/>
            <!-- Invalid text gets a red border while typing; leaving the box (or Start) reports it in a toast. -->
            <TextBox Text="{Binding NextFrom, UpdateSourceTrigger=PropertyChanged}"
                     LostFocus="DepthCommitted"
                     AutomationProperties.Name="Starting depth in metres">
                <TextBox.Style>
                    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsNextFromInvalid}" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource Danger}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBox.Style>
            </TextBox>
            <TextBlock Text="{StaticResource StepLabel}" Style="{StaticResource FieldLabel}" FontSize="{StaticResource CaptureLabelFontSize}"
                       Margin="{StaticResource StepLabelMargin}"/>
            <TextBox Text="{Binding Step, UpdateSourceTrigger=PropertyChanged}"
                     LostFocus="DepthCommitted"
                     AutomationProperties.Name="Depth step in centimetres">
                <TextBox.Style>
                    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsStepInvalid}" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource Danger}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBox.Style>
            </TextBox>
            <Button Style="{StaticResource StartStopButton}" Margin="{StaticResource StartStopButtonMargin}"
                    Command="{Binding ToggleMeasurementCommand}">
                <!-- Runs stay on one line: other whitespace between them would show as a space. -->
                <TextBlock><Run Style="{StaticResource StartStopGlyph}"/><Run Text="  "/><Run Style="{StaticResource StartStopLabel}"/></TextBlock>
            </Button>
        </StackPanel>

        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="{StaticResource CountdownColumnMargin}">
            <TextBlock Text="{StaticResource CountdownLabel}"
                       FontSize="{StaticResource CountdownLabelFontSize}"
                       Foreground="{StaticResource Muted}"
                       HorizontalAlignment="Center"
                       Margin="{StaticResource CountdownLabelMargin}"/>
            <!-- Click (or Tab + Enter/Space) to edit the capture duration — only while no capture is running.
                 Left click only opens the editor: it never starts measuring or captures (captures are
                 right-click while armed, and are refused while the editor is open). -->
            <Button x:Name="CountdownButton"
                    Style="{StaticResource CountdownButton}"
                    Command="{Binding EditDurationCommand}"
                    ToolTip="Click to change the capture duration"
                    AutomationProperties.Name="Capture countdown. Click to change the capture duration">
                <Grid Width="{StaticResource CountdownRingSize}" Height="{StaticResource CountdownRingSize}">
                    <local:CountdownRing Progress="{Binding CaptureProgress}"
                                         RingThickness="{StaticResource CountdownRingThickness}"
                                         TrackBrush="{StaticResource Line}"
                                         ProgressBrush="{StaticResource Blue}"
                                         IsHitTestVisible="False"/>
                    <TextBlock Text="{Binding Countdown}"
                               FontSize="{StaticResource CountdownFontSize}"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource Blue}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Grid>
            </Button>
            <!-- Compact duration editor below the countdown (a popup, so the layout never moves).
                 Enter saves, Escape cancels; invalid input shows a 5 s error toast and keeps the editor open. -->
            <Popup IsOpen="{Binding IsEditingDuration, Mode=OneWay}"
                   PlacementTarget="{Binding ElementName=CountdownButton}"
                   Placement="Bottom"
                   HorizontalOffset="-60"
                   StaysOpen="True"
                   AllowsTransparency="True"
                   Opened="DurationEditorOpened">
                <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                        CornerRadius="{StaticResource ControlRadius}" Padding="14" Margin="0,6,12,12">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" ShadowDepth="3" Direction="270" Opacity="0.14"/>
                    </Border.Effect>
                    <Border.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SaveDurationCommand}"/>
                        <KeyBinding Key="Escape" Command="{Binding CancelDurationCommand}"/>
                    </Border.InputBindings>
                    <StackPanel Width="{StaticResource DurationEditorWidth}">
                        <TextBlock Text="{StaticResource DurationEditorLabel}" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="DurationBox"
                                 Text="{Binding DurationText, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="Capture duration in seconds"/>
                        <TextBlock Style="{StaticResource MutedText}" FontSize="12" Margin="0,6,0,0"><Run Text="Whole seconds, "/><Run Text="{Binding Source={x:Static calc:CaptureDurationSettings.MinSeconds}, Mode=OneWay}"/><Run Text="–"/><Run Text="{Binding Source={x:Static calc:CaptureDurationSettings.MaxSeconds}, Mode=OneWay}"/><Run Text=". Used from the next capture."/></TextBlock>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                            <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Padding="14,7" Margin="0,0,8,0"
                                    Command="{Binding CancelDurationCommand}"/>
                            <Button Content="Save" Padding="14,7" Command="{Binding SaveDurationCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Popup>
        </StackPanel>

        <local:DepthBarChart Grid.Column="2"
                             MinHeight="{StaticResource ChartMinHeight}"
                             ItemsSource="{Binding Results}"
                             XAxisLabel="{StaticResource ChartXAxisLabel}"
                             YAxisLabel="{StaticResource ChartYAxisLabel}"
                             EmptyText="{StaticResource ChartEmptyText}"
                             AxisLabelFontSize="{StaticResource ChartAxisLabelFontSize}"
                             TickFontSize="{StaticResource ChartTickFontSize}"
                             BarBrush="{StaticResource Blue}"
                             BarSeparatorBrush="{StaticResource Surface}"
                             GridBrush="{StaticResource Line}"
                             AxisBrush="{StaticResource Muted}"
                             Foreground="{StaticResource LabelText}"
                             AutomationProperties.Name="Bar chart of ts_ms by depth"/>
    </Grid>
</UserControl>
