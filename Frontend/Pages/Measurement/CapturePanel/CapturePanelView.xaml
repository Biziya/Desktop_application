<UserControl x:Class="Frontend.Pages.Measurement.CapturePanel.CapturePanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:Frontend.Shared.Infrastructure"
             xmlns:local="clr-namespace:Frontend.Pages.Measurement.CapturePanel"
             xmlns:calc="clr-namespace:Frontend.Calculation.Measurement"
             xmlns:measurement="clr-namespace:Frontend.Pages.Measurement">
    <!-- Control row: control column (Starting Depth, Step, Threshold, Start / Stop toggle — all the same width) | countdown | bar chart
         (remaining width). "to" is calculated (from + step), so there is no To input. Depth edits, also during acquisition,
         apply from the next capture. The chart takes the remaining width (about 205 px at the smallest window).
         Labels and sizes: CapturePanel.yaml (application resources). -->
    <UserControl.Resources>
        <ResourceDictionary>
            <!-- Countdown (a button: click to edit the capture duration). No fill or frame; hover tints the ring area,
                 keyboard focus draws a blue circle. When disabled (a capture is running) the countdown looks exactly the
                 same — it just cannot be clicked. -->
            <Style x:Key="CountdownButton" TargetType="Button">
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid Background="Transparent">
                                <Ellipse x:Name="Hover" Fill="{StaticResource SoftBlue}" Opacity="0" Margin="6"/>
                                <ContentPresenter/>
                                <Ellipse x:Name="Focus" Stroke="{StaticResource Blue}" StrokeThickness="1.5" StrokeDashArray="3 2" Visibility="Collapsed"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Hover" Property="Opacity" Value="1"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Focus" Property="Visibility" Value="Visible"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Cursor" Value="Arrow"/>
                                    <Setter TargetName="Hover" Property="Opacity" Value="0"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Setter Property="infra:Tip.Text" Value="{StaticResource TipCountdown}"/>
                <Style.Triggers>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="infra:Tip.Text" Value="{StaticResource TipCountdownDisabled}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- ⓘ on the top border of a Starting Depth / Step / Threshold box, at its right end (the white behind it
                 hides the border, as behind the label). Margin: the box's top margin minus 1 (the 18 px icon is centred
                 on the border, which is 8 px below the box's top). -->
            <Style x:Key="BoxInfoIcon" TargetType="Button" BasedOn="{StaticResource InfoIcon}">
                <Setter Property="Background" Value="{StaticResource Surface}"/>
                <Setter Property="HorizontalAlignment" Value="Right"/>
                <Setter Property="VerticalAlignment" Value="Top"/>
                <Setter Property="Margin" Value="0,7,8,0"/>
            </Style>

            <!-- Starting Depth, Step and Threshold: compact inputs (after the Uiverse "coolinput"). The label (Tag, the same
                 text style as the Core Information labels) sits on the box's top border with the card's white behind it,
                 so it takes no row of its own. Value text as in every text box (TextPrimary, 14 px), right-aligned.
                 Border: near-black (TextPrimary) → gray on hover (InputHoverBorder, as the Drillhole box) → blue while focused
                 (the focus trigger is declared last, so it wins over hover). An invalid value (each box's DataTrigger,
                 declared later still) turns it red. Sizes: floatingInput in CapturePanel.yaml. -->
            <Style x:Key="FloatingLabelInput" TargetType="TextBox">
                <Setter Property="Height" Value="{StaticResource FloatingInputHeight}"/>
                <Setter Property="Margin" Value="{StaticResource FloatingInputSpacing}"/>
                <Setter Property="Padding" Value="{StaticResource FloatingInputPadding}"/>
                <Setter Property="FontSize" Value="{StaticResource FloatingInputFontSize}"/>
                <Setter Property="TextAlignment" Value="Right"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                <Setter Property="Background" Value="{StaticResource Surface}"/>
                <Setter Property="BorderBrush" Value="{StaticResource TextPrimary}"/>
                <Setter Property="BorderThickness" Value="{StaticResource FloatingInputBorderThickness}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Grid>
                                <Border x:Name="Frame" Margin="{StaticResource FloatingInputBoxMargin}" CornerRadius="{StaticResource ControlRadius}"
                                        Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}">
                                    <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" Focusable="False"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                </Border>
                                <TextBlock Text="{TemplateBinding Tag}" Style="{StaticResource FieldLabel}" HorizontalAlignment="Left" VerticalAlignment="Top"
                                           Margin="{StaticResource FloatingInputLabelMargin}" Padding="{StaticResource FloatingInputLabelPadding}"
                                           Background="{StaticResource Surface}"
                                           FontSize="{StaticResource FloatingInputLabelFontSize}"
                                           IsHitTestVisible="False"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Frame" Property="Opacity" Value="0.6"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="BorderBrush" Value="{StaticResource InputHoverBorder}"/>
                    </Trigger>
                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                        <Setter Property="BorderBrush" Value="{StaticResource Blue}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- One toggle: green "Start" while stopped, red "Stop" while measuring. Exactly as tall as the Starting Depth,
                 Step and Threshold boxes (the box, not their labels). -->
            <Style x:Key="StartStopButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="FontSize" Value="{StaticResource StartStopButtonFontSize}"/>
                <Setter Property="MinWidth" Value="{StaticResource StartStopButtonWidth}"/>
                <Setter Property="Height" Value="{StaticResource FloatingInputBoxHeight}"/>
                <Setter Property="MinHeight" Value="0"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Padding" Value="{StaticResource StartStopButtonPadding}"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="Background" Value="{StaticResource ButtonCreate}"/>
                <Setter Property="AutomationProperties.Name" Value="Start measurement"/>
                <Setter Property="infra:Tip.Text" Value="{StaticResource TipStart}"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsMeasurementModeActive}" Value="True">
                        <Setter Property="Background" Value="{StaticResource ButtonDanger}"/>
                        <Setter Property="AutomationProperties.Name" Value="Stop measurement"/>
                        <Setter Property="infra:Tip.Text" Value="{StaticResource TipStop}"/>
                    </DataTrigger>
                    <!-- Start is only disabled while no drillhole is saved for measuring. -->
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="infra:Tip.Text" Value="{StaticResource TipStartDisabled}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Glyph and label of the Start / Stop toggle; they switch with IsMeasurementModeActive. -->
            <Style x:Key="StartStopGlyph" TargetType="Run">
                <Setter Property="FontSize" Value="{StaticResource StartStopButtonIconFontSize}"/>
                <Setter Property="Text" Value="{StaticResource StartGlyph}"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsMeasurementModeActive}" Value="True">
                        <Setter Property="Text" Value="{StaticResource StopGlyph}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="StartStopLabel" TargetType="Run">
                <Setter Property="Text" Value="{StaticResource StartLabel}"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsMeasurementModeActive}" Value="True">
                        <Setter Property="Text" Value="{StaticResource StopLabel}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Measures the input + countdown columns. The warning and the capture hint below take this width, so they wrap
             under those columns (the chart runs down beside them) without ever widening them. -->
        <Border x:Name="ControlsWidth" Grid.ColumnSpan="2" IsHitTestVisible="False"/>

        <!-- Shown while no drillhole is saved for measuring, under the inputs and countdown, beside the chart.
             Text and size: DrillholeInformation.yaml. -->
        <TextBlock Grid.Row="2" Grid.ColumnSpan="2"
                   Width="{Binding ActualWidth, ElementName=ControlsWidth}"
                   Text="{StaticResource DrillholeWarningText}"
                   FontSize="{StaticResource DrillholeWarningFontSize}"
                   Foreground="{StaticResource Warning}"
                   TextWrapping="Wrap"
                   HorizontalAlignment="Left"
                   Margin="{StaticResource DrillholeWarningMargin}"
                   Visibility="{Binding NeedsCore, Converter={StaticResource BoolVisibility}}"/>

        <!-- Shown while measurement mode waits for a right-click, so the capture gesture is visible when it is needed
             (Start also shows the same text in a toast). Never shown together with the warning above: Start needs Core. -->
        <Border Grid.Row="2" Grid.ColumnSpan="2"
                Width="{Binding ActualWidth, ElementName=ControlsWidth}"
                HorizontalAlignment="Left"
                Style="{StaticResource InfoBanner}"
                Margin="0,12,0,0"
                Visibility="{Binding ShowCaptureHint, Converter={StaticResource BoolVisibility}}">
            <TextBlock Text="{x:Static measurement:MeasurementViewModel.CaptureHint}" TextWrapping="Wrap" FontWeight="SemiBold"/>
        </Border>

        <!-- The first box's spacing is dropped so the column starts at its label. Invalid text gets a red border while
             typing; leaving the box (or Start) reports it in a toast. -->
        <StackPanel Width="{StaticResource StartStopButtonWidth}" VerticalAlignment="Center">
            <Grid>
            <TextBox Text="{Binding NextFrom, UpdateSourceTrigger=PropertyChanged}" Tag="{StaticResource StartingDepthLabel}" Margin="0"
                     LostFocus="DepthCommitted"
                     AutomationProperties.Name="Starting depth in metres"
                     AutomationProperties.HelpText="{StaticResource TipStartingDepth}">
                <TextBox.Style>
                    <Style TargetType="TextBox" BasedOn="{StaticResource FloatingLabelInput}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsNextFromInvalid}" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource Danger}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBox.Style>
            </TextBox>
                <Button Style="{StaticResource BoxInfoIcon}" Margin="0,-1,8,0" infra:Tip.Text="{StaticResource TipStartingDepth}" AutomationProperties.Name="About Starting Depth"/>
            </Grid>
            <Grid>
            <TextBox Text="{Binding Step, UpdateSourceTrigger=PropertyChanged}" Tag="{StaticResource StepLabel}"
                     LostFocus="DepthCommitted"
                     AutomationProperties.Name="Depth step in centimetres"
                     AutomationProperties.HelpText="{StaticResource TipStep}">
                <TextBox.Style>
                    <Style TargetType="TextBox" BasedOn="{StaticResource FloatingLabelInput}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsStepInvalid}" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource Danger}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBox.Style>
            </TextBox>
                <Button Style="{StaticResource BoxInfoIcon}" infra:Tip.Text="{StaticResource TipStep}" AutomationProperties.Name="About Step"/>
            </Grid>
            <!-- A completed row whose CPS is above this sounds the alarm (it never stops or changes the measurement).
                 The bell inside the box (left; the value is right-aligned) shows the alarm state and mutes the sound. -->
            <Grid>
                <TextBox Text="{Binding Threshold, UpdateSourceTrigger=PropertyChanged}" Tag="{StaticResource ThresholdLabel}"
                         LostFocus="ThresholdCommitted"
                         AutomationProperties.HelpText="{StaticResource TipThreshold}"
                         AutomationProperties.Name="CPS alarm threshold">
                    <TextBox.Style>
                        <Style TargetType="TextBox" BasedOn="{StaticResource FloatingLabelInput}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsThresholdInvalid}" Value="True">
                                    <Setter Property="BorderBrush" Value="{StaticResource Danger}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>
                <Button Style="{StaticResource IconButton}" Width="26" Height="26" Margin="6,0,0,5"
                        HorizontalAlignment="Left" VerticalAlignment="Bottom"
                        Command="{Binding ToggleAlarmMuteCommand}"
                        infra:Tip.Text="{Binding AlarmToolTip}"
                        AutomationProperties.Name="{Binding AlarmToolTip}">
                    <Path Width="15" Height="15" Stretch="Uniform" StrokeThickness="1.8"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round">
                        <Path.Style>
                            <Style TargetType="Path">
                                <Setter Property="Data" Value="{StaticResource BellIcon}"/>
                                <Setter Property="Stroke" Value="{StaticResource TextPrimary}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Alarm}" Value="{x:Static calc:AlarmState.Off}">
                                        <Setter Property="Data" Value="{StaticResource BellOffIcon}"/>
                                        <Setter Property="Stroke" Value="{StaticResource Muted}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Alarm}" Value="{x:Static calc:AlarmState.Muted}">
                                        <Setter Property="Data" Value="{StaticResource BellOffIcon}"/>
                                        <Setter Property="Stroke" Value="{StaticResource Warning}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Alarm}" Value="{x:Static calc:AlarmState.Triggered}">
                                        <Setter Property="Stroke" Value="{StaticResource Danger}"/>
                                        <Setter Property="Fill" Value="{StaticResource DangerSurface}"/>
                                    </DataTrigger>
                                    <!-- Went off, then muted: the crossed bell, still red. -->
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding Alarm}" Value="{x:Static calc:AlarmState.Triggered}"/>
                                            <Condition Binding="{Binding IsAlarmMuted}" Value="True"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Data" Value="{StaticResource BellOffIcon}"/>
                                        <Setter Property="Fill" Value="{x:Null}"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Path.Style>
                    </Path>
                </Button>
                <Button Style="{StaticResource BoxInfoIcon}" infra:Tip.Text="{StaticResource TipThreshold}" AutomationProperties.Name="About Threshold"/>
            </Grid>
            <Button Style="{StaticResource StartStopButton}" Margin="{StaticResource StartStopButtonMargin}"
                    Command="{Binding ToggleMeasurementCommand}">
                <!-- Runs stay on one line: other whitespace between them would show as a space. -->
                <TextBlock><Run Style="{StaticResource StartStopGlyph}"/><Run Text="  "/><Run Style="{StaticResource StartStopLabel}"/></TextBlock>
            </Button>
        </StackPanel>

        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="{StaticResource CountdownColumnMargin}">
            <TextBlock Text="{StaticResource CountdownLabel}"
                       FontSize="{StaticResource CountdownLabelFontSize}"
                       Foreground="{StaticResource Muted}"
                       HorizontalAlignment="Center"
                       Margin="{StaticResource CountdownLabelMargin}"/>
            <!-- Click (or Tab + Enter/Space) to edit the capture duration — only while no capture is running.
                 Left click only opens the editor: it never starts measuring or captures (captures are
                 right-click while armed, and are refused while the editor is open). -->
            <Button x:Name="CountdownButton"
                    Style="{StaticResource CountdownButton}"
                    Command="{Binding EditDurationCommand}"
                    AutomationProperties.Name="Capture countdown. Click to change the capture duration">
                <Grid Width="{StaticResource CountdownRingSize}" Height="{StaticResource CountdownRingSize}">
                    <local:CountdownRing Progress="{Binding CaptureProgress}"
                                         RingThickness="{StaticResource CountdownRingThickness}"
                                         TrackBrush="{StaticResource Line}"
                                         ProgressBrush="{StaticResource Blue}"
                                         IsHitTestVisible="False"/>
                    <TextBlock Text="{Binding Countdown}"
                               FontSize="{StaticResource CountdownFontSize}"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource Blue}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Grid>
            </Button>
            <!-- Compact duration editor below the countdown (a popup, so the layout never moves).
                 Enter saves, Escape cancels; invalid input shows a 5 s error toast and keeps the editor open. -->
            <Popup IsOpen="{Binding IsEditingDuration, Mode=OneWay}"
                   PlacementTarget="{Binding ElementName=CountdownButton}"
                   Placement="Bottom"
                   HorizontalOffset="-60"
                   StaysOpen="True"
                   AllowsTransparency="True"
                   Opened="DurationEditorOpened">
                <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                        CornerRadius="{StaticResource ControlRadius}" Padding="14" Margin="0,6,12,12">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" ShadowDepth="3" Direction="270" Opacity="0.14"/>
                    </Border.Effect>
                    <Border.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SaveDurationCommand}"/>
                        <KeyBinding Key="Escape" Command="{Binding CancelDurationCommand}"/>
                    </Border.InputBindings>
                    <StackPanel Width="{StaticResource DurationEditorWidth}">
                        <TextBlock Text="{StaticResource DurationEditorLabel}" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="DurationBox"
                                 Text="{Binding DurationText, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="Capture duration in seconds"/>
                        <TextBlock Style="{StaticResource MutedText}" FontSize="12" Margin="0,6,0,0"><Run Text="Whole seconds, "/><Run Text="{Binding Source={x:Static calc:CaptureDurationSettings.MinSeconds}, Mode=OneWay}"/><Run Text="–"/><Run Text="{Binding Source={x:Static calc:CaptureDurationSettings.MaxSeconds}, Mode=OneWay}"/><Run Text=". Used from the next capture."/></TextBlock>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                            <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Padding="14,7" Margin="0,0,8,0"
                                    Command="{Binding CancelDurationCommand}"/>
                            <Button Content="Save" Padding="14,7" Command="{Binding SaveDurationCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Popup>
        </StackPanel>

        <!-- Graph header, right-aligned on one line: the live value (left) and the eye that shows or hides the dashed
             threshold line (right). -->
        <Grid Grid.Column="2" Grid.RowSpan="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel x:Name="GraphHeader" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,4">
                <!-- Live value: the newest reading of the recording detector, refreshed about once a second while the
                     Measurement page is shown ("—" when no recent reading), in CPS or CPM (CPS × 60). The unit choice is
                     kept for the app session. -->
                <Border x:Name="LiveBox"
                        Padding="10,3,4,3" Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        Background="{StaticResource Surface}"
                        BorderBrush="{StaticResource Line}" BorderThickness="1.5"
                        CornerRadius="{StaticResource ControlRadius}"
                        infra:Tip.Text="{StaticResource TipLive}"
                        AutomationProperties.Name="Live reading"
                        AutomationProperties.AutomationId="LiveBox">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{StaticResource LiveLabel}"
                                   FontSize="13"
                                   Foreground="{StaticResource Muted}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding LiveValue}"
                                   FontSize="{StaticResource LiveFontSize}"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}"
                                   VerticalAlignment="Center"
                                   MinWidth="64" TextAlignment="Right"
                                   AutomationProperties.AutomationId="LiveValue"/>
                        <Border Margin="8,0,0,0" Padding="2" CornerRadius="6" Background="{StaticResource HoverSurface}"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton GroupName="LiveUnit" Style="{StaticResource SegmentPill}"
                                             Content="{StaticResource LiveCpsUnitLabel}"
                                             IsChecked="{Binding IsLiveUnitCps}"
                                             infra:Tip.Text="{StaticResource TipLiveUnit}"
                                             AutomationProperties.AutomationId="LiveUnitCps"/>
                                <RadioButton GroupName="LiveUnit" Style="{StaticResource SegmentPill}"
                                             Content="{StaticResource LiveCpmUnitLabel}"
                                             IsChecked="{Binding IsLiveUnitCpm}"
                                             infra:Tip.Text="{StaticResource TipLiveUnit}"
                                             AutomationProperties.AutomationId="LiveUnitCpm"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
                <!-- Open eye: the threshold line is shown; crossed-out eye: hidden. -->
                <Button x:Name="ThresholdLineToggle"
                        Style="{StaticResource IconButton}"
                        VerticalAlignment="Center"
                        Command="{Binding ToggleThresholdLineCommand}"
                        infra:Tip.Text="{StaticResource TipThresholdLine}"
                        AutomationProperties.AutomationId="ThresholdLineToggle"
                        AutomationProperties.Name="{Binding ThresholdLineButtonText}">
                    <Path Width="18" Height="18" Stretch="Uniform" StrokeThickness="1.8"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round">
                        <Path.Style>
                            <Style TargetType="Path">
                                <Setter Property="Data" Value="{StaticResource EyeIcon}"/>
                                <Setter Property="Stroke" Value="{StaticResource TextPrimary}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsThresholdLineVisible}" Value="False">
                                        <Setter Property="Data" Value="{StaticResource EyeOffIcon}"/>
                                        <Setter Property="Stroke" Value="{StaticResource Muted}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Path.Style>
                    </Path>
                </Button>
            </StackPanel>
        <local:DepthBarChart Grid.Row="1"
                             MinHeight="{StaticResource ChartMinHeight}"
                             ItemsSource="{Binding Results}"
                             Threshold="{Binding ThresholdCps}"
                             ShowThreshold="{Binding IsThresholdLineVisible}"
                             ThresholdBrush="{StaticResource Danger}"
                             ThresholdLabel="{StaticResource ChartThresholdLabel}"
                             XAxisLabel="{StaticResource ChartXAxisLabel}"
                             YAxisLabel="{StaticResource ChartYAxisLabel}"
                             EmptyText="{StaticResource ChartEmptyText}"
                             AxisLabelFontSize="{StaticResource ChartAxisLabelFontSize}"
                             TickFontSize="{StaticResource ChartTickFontSize}"
                             BarBrush="{StaticResource Blue}"
                             BarSeparatorBrush="{StaticResource Surface}"
                             GridBrush="{StaticResource Line}"
                             AxisBrush="{StaticResource Muted}"
                             Foreground="{StaticResource LabelText}"
                             AutomationProperties.Name="Bar chart of CPS by depth"
                             infra:Tip.Text="{StaticResource TipGraph}"/>
        </Grid>
    </Grid>
</UserControl>
