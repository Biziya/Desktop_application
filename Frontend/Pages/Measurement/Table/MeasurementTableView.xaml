<UserControl x:Class="Frontend.Pages.Measurement.Table.MeasurementTableView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:table="clr-namespace:Frontend.Pages.Measurement.Table">
    <!-- Averaged Measurements table. Columns and sizes: MeasurementTable.yaml (application resources). -->
    <Border Style="{StaticResource Card}" Padding="0" Margin="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Margin="18,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Averaged Measurements"
                           FontSize="{StaticResource TableHeadingFontSize}"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
                <!-- Starts a new measurement session (only while stopped). Start/Stop keeps the current one. -->
                <Button Grid.Column="1"
                        Content="+   New Measurement"
                        Style="{StaticResource SecondaryButton}"
                        FontSize="{StaticResource TableActionButtonFontSize}"
                        MinHeight="{StaticResource TableActionButtonMinHeight}"
                        Margin="0,0,10,0"
                        ToolTip="Finish this drillhole. Its measurements stay stored; enter the next drillhole in Core Information."
                        Command="{Binding NewMeasurementCommand}"/>
                <Button Grid.Column="2"
                        Content="↓   Export CSV"
                        Style="{StaticResource SecondaryButton}"
                        FontSize="{StaticResource TableActionButtonFontSize}"
                        MinWidth="{StaticResource TableActionButtonMinWidth}"
                        MinHeight="{StaticResource TableActionButtonMinHeight}"
                        Command="{Binding ExportCommand}"/>
            </Grid>

            <table:MeasurementGrid Grid.Row="1" EmptyText="Your averaged measurements will appear here."/>
        </Grid>
    </Border>
</UserControl>
