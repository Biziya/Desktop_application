<!--
  Measurement page UI sizing constants.
  Single place to tune font sizes and dimensions for the Measurement page only.
  Merged by MeasurementPage.xaml / MeasurementStyles.xaml (page scope) - NOT by App.xaml.
  Defaults reproduce the original look of the page.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- ============ 1. Countdown timer ============ -->
    <sys:Double x:Key="CountdownFontSize">32</sys:Double>
    <sys:Double x:Key="CountdownRingSize">140</sys:Double>
    <sys:Double x:Key="CountdownRingThickness">8</sys:Double>
    <sys:Double x:Key="CountdownLabelFontSize">14</sys:Double>

    <!-- ============ 2. Start / Stop button (shared by both states) ============ -->
    <!-- Width/Height are applied as MinWidth/MinHeight so larger text never clips; 0 = size to content. -->
    <!-- The play/stop glyphs are part of the button text, so they scale with StartStopButtonFontSize. -->
    <sys:Double x:Key="StartStopButtonWidth">200</sys:Double>
    <sys:Double x:Key="StartStopButtonHeight">0</sys:Double>
    <sys:Double x:Key="StartStopButtonFontSize">25</sys:Double>
    <Thickness x:Key="StartStopButtonPadding">32,18</Thickness>
    <CornerRadius x:Key="StartStopButtonCornerRadius">8</CornerRadius>

    <!-- ============ 3. Measurement table ============ -->
    <sys:Double x:Key="TableHeaderFontSize">12</sys:Double>
    <sys:Double x:Key="TableRowFontSize">14</sys:Double>
    <sys:Double x:Key="TableHeaderHeight">34</sys:Double>
    <sys:Double x:Key="TableRowHeight">36</sys:Double>
    <Thickness x:Key="TableHeaderPadding">8,4</Thickness>
    <Thickness x:Key="TableCellPadding">8,0</Thickness>
    <sys:Double x:Key="DragHandleFontSize">22</sys:Double>
    <DataGridLength x:Key="DragHandleColumnWidth">34</DataGridLength>
    <sys:Double x:Key="DeleteIconFontSize">14</sys:Double>
    <sys:Double x:Key="DeleteButtonSize">28</sys:Double>

    <!-- ============ 4. Other page elements ============ -->
    <sys:Double x:Key="SectionHeadingFontSize">18</sys:Double>
    <sys:Double x:Key="LabelFontSize">14</sys:Double>
    <!-- Export CSV: Width/Height applied as MinWidth/MinHeight; 0 = size to content. -->
    <sys:Double x:Key="ExportButtonFontSize">14</sys:Double>
    <sys:Double x:Key="ExportButtonWidth">0</sys:Double>
    <sys:Double x:Key="ExportButtonHeight">0</sys:Double>
</ResourceDictionary>
