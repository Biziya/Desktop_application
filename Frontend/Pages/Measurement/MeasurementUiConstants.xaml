<!--
  Measurement page UI sizing.  Final size = Default size x Multiplier.

  * Section A - MULTIPLIERS: the only values you normally edit. 1.0 = original look,
    1.5 = +50%, 2.0 = double, 0.8 = -20%. Decimals are fine.
  * Section B - DEFAULTS: the original sizes. Leave these unchanged.
  * The final value is calculated where it is used: {local:Scale Name} (see ScaleExtension.cs) reads "Name" and
    "NameMultiplier" from this file. A few items name their multiplier explicitly, e.g.
    {local:Scale DeleteIconFontSize, DeleteIconSizeMultiplier}. Items without a multiplier use the default as is.
  * This file is loaded once, by ScaleExtension. It is not merged into any resource dictionary or App.xaml.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- ===================== A. MULTIPLIERS (edit these) ===================== -->

    <!-- Countdown: ring, ring line and number enlarged together by 25% (175 px ring, 40 px number, 10 px line).
         The ring column stays as tall as the Starting Depth / Step / Start-Stop column, so the card does not grow
         and the chart and table keep their space. -->
    <sys:Double x:Key="CountdownFontSizeMultiplier">1.25</sys:Double>
    <sys:Double x:Key="CountdownRingSizeMultiplier">1.25</sys:Double>
    <sys:Double x:Key="CountdownRingThicknessMultiplier">1.25</sys:Double>
    <sys:Double x:Key="CountdownLabelFontSizeMultiplier">1.0</sys:Double>

    <!-- Start / Stop button (both states) -->
    <!-- Its height is not scaled: it always equals the input boxes (ControlHeight in Shared/Styles/Theme.xaml). -->
    <sys:Double x:Key="StartStopButtonWidthMultiplier">1.0</sys:Double>
    <sys:Double x:Key="StartStopButtonFontSizeMultiplier">1.0</sys:Double>
    <sys:Double x:Key="StartStopButtonIconFontSizeMultiplier">1.0</sys:Double>

    <!-- Measurement table: compact original size (the temporary 2x enlargement is reverted). Column widths are in
         MeasurementColumnLayout.cs and fit the table width, so raising these makes text shorten with "…" sooner. -->
    <sys:Double x:Key="TableHeaderFontSizeMultiplier">1.0</sys:Double>
    <sys:Double x:Key="TableRowFontSizeMultiplier">1.0</sys:Double>
    <sys:Double x:Key="TableRowHeightMultiplier">1.0</sys:Double>
    <sys:Double x:Key="TableHeaderHeightMultiplier">1.0</sys:Double>
    <sys:Double x:Key="TableCellPaddingMultiplier">1.0</sys:Double>      <!-- also scales header padding -->
    <sys:Double x:Key="DeleteIconSizeMultiplier">1.0</sys:Double>        <!-- delete glyph + its button size -->

    <!-- Other page elements -->
    <sys:Double x:Key="SectionHeadingFontSizeMultiplier">1.0</sys:Double>
    <sys:Double x:Key="LabelFontSizeMultiplier">1.0</sys:Double>
    <sys:Double x:Key="ExportButtonFontSizeMultiplier">1.0</sys:Double>
    <sys:Double x:Key="ExportButtonWidthMultiplier">1.0</sys:Double>
    <sys:Double x:Key="ExportButtonHeightMultiplier">1.0</sys:Double>

    <!-- ===================== B. DEFAULT SIZES (original values - do not edit) ===================== -->

    <!-- Countdown -->
    <sys:Double x:Key="CountdownFontSize">32</sys:Double>
    <sys:Double x:Key="CountdownRingSize">140</sys:Double>
    <sys:Double x:Key="CountdownRingThickness">8</sys:Double>
    <sys:Double x:Key="CountdownLabelFontSize">14</sys:Double>

    <!-- Start / Stop button. Width is also the width of the Starting Depth and Step boxes above it. The height is
         ControlHeight (40, same as those boxes), so text and padding are sized to fit a 40 px button. -->
    <sys:Double x:Key="StartStopButtonWidth">200</sys:Double>
    <sys:Double x:Key="StartStopButtonFontSize">16</sys:Double>
    <sys:Double x:Key="StartStopButtonIconFontSize">13</sys:Double>      <!-- the play/stop glyph -->
    <Thickness x:Key="StartStopButtonPadding">16,0</Thickness>           <!-- no multiplier: used as is -->

    <!-- Measurement table -->
    <sys:Double x:Key="TableHeaderFontSize">12</sys:Double>
    <sys:Double x:Key="TableRowFontSize">14</sys:Double>
    <sys:Double x:Key="TableHeaderHeight">34</sys:Double>                 <!-- minimum: a wrapped two-line header may be taller -->
    <sys:Double x:Key="TableRowHeight">36</sys:Double>
    <Thickness x:Key="TableHeaderPadding">8,4</Thickness>
    <Thickness x:Key="TableCellPadding">8,0</Thickness>
    <sys:Double x:Key="DeleteIconFontSize">14</sys:Double>
    <sys:Double x:Key="DeleteButtonSize">28</sys:Double>
    <sys:Double x:Key="DeleteColumnWidth">64</sys:Double>                 <!-- scaled with DeleteIconSizeMultiplier -->

    <!-- Other page elements. Export Width/Height are applied as MinWidth/MinHeight; 42.62 is the original natural height
         (14px line + 2x11 padding + border). 130 approximates the original natural width. -->
    <sys:Double x:Key="SectionHeadingFontSize">18</sys:Double>
    <sys:Double x:Key="LabelFontSize">14</sys:Double>
    <sys:Double x:Key="ExportButtonFontSize">14</sys:Double>
    <sys:Double x:Key="ExportButtonWidth">130</sys:Double>
    <sys:Double x:Key="ExportButtonHeight">42.62</sys:Double>
</ResourceDictionary>
