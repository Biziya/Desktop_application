<UserControl x:Class="Frontend.Pages.Measurement.MeasurementPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:capture="clr-namespace:Frontend.Pages.Measurement.CapturePanel"
             xmlns:table="clr-namespace:Frontend.Pages.Measurement.Table">
    <!-- Page composition only. The sections share this page's DataContext (MeasurementViewModel). Results, errors and
         status changes are shown as toasts (MainWindow), not as text here. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <capture:CapturePanelView/>

                <!-- The drillhole warning: shown while no drillhole is saved for measuring (also when none is selected,
                     which leaves the table and chart empty). Text and size: DrillholeInformation.yaml. -->
                <TextBlock Text="{StaticResource DrillholeWarningText}"
                           FontSize="{StaticResource DrillholeWarningFontSize}"
                           Foreground="{StaticResource Warning}"
                           TextWrapping="Wrap"
                           Margin="{StaticResource DrillholeWarningMargin}"
                           Visibility="{Binding NeedsCore, Converter={StaticResource BoolVisibility}}"/>
            </StackPanel>
        </Border>

        <table:MeasurementTableView Grid.Row="1"/>
    </Grid>
</UserControl>
