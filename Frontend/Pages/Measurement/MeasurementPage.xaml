<UserControl x:Class="Frontend.Pages.Measurement.MeasurementPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries>
  <ResourceDictionary Source="MeasurementStyles.xaml"/>
 </ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Style="{StaticResource Card}"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <StackPanel HorizontalAlignment="Center"><TextBlock Text="◷" FontSize="32" Foreground="{StaticResource Blue}" HorizontalAlignment="Center"/><TextBlock Text="Capture Countdown" Foreground="{StaticResource Muted}" Margin="0,8,0,4"/><TextBlock Text="{Binding Countdown}" FontSize="44" FontWeight="Bold" Foreground="{StaticResource Blue}" HorizontalAlignment="Center" AutomationProperties.Name="Capture countdown"/></StackPanel>
   <Button Grid.Column="1" Content="▶  Start" FontSize="25" Background="#00A34C" Margin="24,0,0,0" HorizontalAlignment="Center" MinWidth="200" VerticalAlignment="Center" Padding="32,18" Command="{Binding StartCommand}"/>
  </Grid>
  <TextBlock Text="Complete Core Information and click Save &amp; Continue to enable Start." Foreground="#AC6510" TextWrapping="Wrap" Margin="0,12,0,0" Visibility="{Binding NeedsCore, Converter={StaticResource BoolVisibility}}"/>
  </StackPanel></Border>
  <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0" Margin="0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Grid Margin="18,14"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="▥   Averaged Measurements" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/><Button Grid.Column="1" Content="↓   Export CSV" Style="{StaticResource SecondaryButton}" Command="{Binding ExportCommand}"/></Grid>
   <DataGrid x:Name="ResultsGrid" Grid.Row="1" ItemsSource="{Binding Results}" AutoGenerateColumns="False" SelectionMode="Single" AllowDrop="True" PreviewMouseMove="BeginDrag" PreviewMouseLeftButtonUp="EndPointer" DragOver="RowDragOver" Drop="RowDrop" DragLeave="RowDragLeave" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto">
    <DataGrid.Columns>
     <DataGridTemplateColumn Width="34"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="⠿" HorizontalAlignment="Stretch" TextAlignment="Center" VerticalAlignment="Center" Cursor="SizeAll" FontSize="22" Foreground="{StaticResource Blue}" Background="Transparent" ToolTip="Drag to reorder" AutomationProperties.Name="Drag to reorder measurement" PreviewMouseLeftButtonDown="HandleDown"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
     <DataGridTextColumn Header="No." Binding="{Binding Number}" Width="44" ElementStyle="{StaticResource CenteredTableText}" HeaderStyle="{StaticResource CenteredTableHeader}"/>
     <DataGridTextColumn Header="Start Time" Binding="{Binding StartTime, StringFormat={}{0:yyyy-MM-dd HH:mm:ss.fff}}" Width="2.4*" MinWidth="196"/>
     <DataGridTextColumn Header="Samples" Binding="{Binding SampleCount}" Width="*" MinWidth="74" ElementStyle="{StaticResource CenteredTableText}" HeaderStyle="{StaticResource CenteredTableHeader}"/>
     <DataGridTextColumn Header="Average" Binding="{Binding AverageValue, StringFormat=F2}" Width="*" MinWidth="82" ElementStyle="{StaticResource CenteredTableText}" HeaderStyle="{StaticResource CenteredTableHeader}"/>
     <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="0.7*" MinWidth="50" ElementStyle="{StaticResource CenteredTableText}" HeaderStyle="{StaticResource CenteredTableHeader}"/>
     <DataGridTemplateColumn Header="Delete" Width="64" HeaderStyle="{StaticResource CenteredTableHeader}"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="✕" ToolTip="Delete measurement" AutomationProperties.Name="Delete measurement" Foreground="#D9334C" Background="Transparent" Padding="4,2" Width="28" Height="28" HorizontalAlignment="Center" VerticalAlignment="Center" Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
    </DataGrid.Columns>
   </DataGrid>
   <TextBlock Grid.Row="1" Text="Your averaged measurements will appear here." HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Muted}" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Results.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
  </Grid></Border>
  <TextBlock Grid.Row="2" Text="{Binding Notification}" Foreground="#087547" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Margin" Value="2,12,0,0"/><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
 </Grid>
</UserControl>
