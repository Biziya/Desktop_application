<UserControl x:Class="Frontend.Pages.Measurement.MeasurementPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Frontend.Pages.Measurement">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="MeasurementStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- One row: Starting Depth, Step, countdown, Start / Stop. "to" is calculated (from + step), so there is no To input.
             Depth edits, also during acquisition, apply from the next capture. -->
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <Grid>
                    <!-- Inputs share the free width (124-180 px each; the minimum fits the smallest window with the
                         sidebar open); the empty third column pushes countdown and Start / Stop to the right. -->
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="124" MaxWidth="180"/>
                        <ColumnDefinition Width="*" MinWidth="124" MaxWidth="180"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                        <TextBlock Text="Starting Depth (m)" FontSize="{local:Scale LabelFontSize}" TextWrapping="Wrap"/>
                        <TextBox Text="{Binding NextFrom, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="Starting depth in metres"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,16,0" VerticalAlignment="Center">
                        <TextBlock Text="Step (m)" FontSize="{local:Scale LabelFontSize}" TextWrapping="Wrap"/>
                        <TextBox Text="{Binding Step, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="Depth step in metres"/>
                    </StackPanel>

                    <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                        <TextBlock Text="Capture Countdown"
                                   FontSize="{local:Scale CountdownLabelFontSize}"
                                   Foreground="{StaticResource Muted}"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,10"/>
                        <Grid Width="{local:Scale CountdownRingSize}" Height="{local:Scale CountdownRingSize}">
                            <local:CountdownRing Progress="{Binding CaptureProgress}"
                                                 RingThickness="{local:Scale CountdownRingThickness}"
                                                 TrackBrush="{StaticResource Line}"
                                                 ProgressBrush="{StaticResource Blue}"
                                                 IsHitTestVisible="False"/>
                            <TextBlock Text="{Binding Countdown}"
                                       FontSize="{local:Scale CountdownFontSize}"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource Blue}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       AutomationProperties.Name="Capture countdown"/>
                        </Grid>
                    </StackPanel>

                    <Button Grid.Column="4"
                            Margin="24,0,0,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Command="{Binding ToggleMeasurementCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource StartStopButtonStyle}">
                                <Setter Property="Background" Value="{StaticResource Success}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMeasurementModeActive}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource Danger}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <!-- Runs stay on one line: whitespace between them would show as a space. -->
                        <TextBlock><Run Style="{StaticResource StartStopIconRun}"/><Run Style="{StaticResource StartStopLabelRun}"/></TextBlock>
                    </Button>
                </Grid>

                <TextBlock Text="{Binding DepthError}"
                           FontSize="{local:Scale LabelFontSize}"
                           Foreground="{StaticResource Warning}"
                           TextWrapping="Wrap"
                           Margin="0,8,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <TextBlock Text="Complete Core Information and click Save &amp; Continue to enable Start."
                           FontSize="{local:Scale LabelFontSize}"
                           Foreground="{StaticResource Warning}"
                           TextWrapping="Wrap"
                           Margin="0,12,0,0"
                           Visibility="{Binding NeedsCore, Converter={StaticResource BoolVisibility}}"/>
            </StackPanel>
        </Border>

        <!-- Results table -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0" Margin="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Margin="18,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Averaged Measurements"
                               FontSize="{local:Scale SectionHeadingFontSize}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                    <!-- Starts a new measurement session (only while stopped). Start/Stop keeps the current one. -->
                    <Button Grid.Column="1"
                            Content="+   New Measurement"
                            Style="{StaticResource SecondaryButton}"
                            FontSize="{local:Scale ExportButtonFontSize}"
                            MinHeight="{local:Scale ExportButtonHeight}"
                            Margin="0,0,10,0"
                            ToolTip="Finish this drillhole. Its measurements stay stored; enter the next drillhole in Core Information."
                            Command="{Binding NewMeasurementCommand}"/>
                    <Button Grid.Column="2"
                            Content="↓   Export CSV"
                            Style="{StaticResource SecondaryButton}"
                            FontSize="{local:Scale ExportButtonFontSize}"
                            MinWidth="{local:Scale ExportButtonWidth}"
                            MinHeight="{local:Scale ExportButtonHeight}"
                            Command="{Binding ExportCommand}"/>
                </Grid>

                <DataGrid x:Name="ResultsGrid"
                          Grid.Row="1"
                          Margin="1,0,1,9"
                          ItemsSource="{Binding Results}"
                          AutoGenerateColumns="False"
                          SelectionMode="Single"
                          AllowDrop="True"
                          PreviewMouseMove="BeginDrag"
                          PreviewMouseLeftButtonUp="EndPointer"
                          DragOver="RowDragOver"
                          Drop="RowDrop"
                          DragLeave="RowDragLeave"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="{local:Scale DragHandleColumnWidth, DragHandleSizeMultiplier}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="⠿"
                                               Opacity="0.7"
                                               HorizontalAlignment="Stretch"
                                               TextAlignment="Center"
                                               VerticalAlignment="Center"
                                               Cursor="SizeAll"
                                               FontSize="{local:Scale DragHandleFontSize, DragHandleSizeMultiplier}"
                                               Foreground="{StaticResource Blue}"
                                               Background="Transparent"
                                               ToolTip="Drag to reorder"
                                               AutomationProperties.Name="Drag to reorder measurement"
                                               PreviewMouseLeftButtonDown="HandleDown"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Measurement value columns are inserted here from MeasurementColumns.cs (see MeasurementPage.xaml.cs). -->

                        <DataGridTemplateColumn Header="Delete"
                                                Width="64"
                                                HeaderStyle="{StaticResource CenteredTableHeader}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="✕"
                                            FontSize="{local:Scale DeleteIconFontSize, DeleteIconSizeMultiplier}"
                                            Width="{local:Scale DeleteButtonSize, DeleteIconSizeMultiplier}"
                                            Height="{local:Scale DeleteButtonSize, DeleteIconSizeMultiplier}"
                                            ToolTip="Delete measurement"
                                            AutomationProperties.Name="Delete measurement"
                                            Style="{StaticResource DeleteButton}"
                                            Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Grid.Row="1"
                           Text="Your averaged measurements will appear here."
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="{local:Scale LabelFontSize}"
                           Foreground="{StaticResource Muted}"
                           IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Results.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>

        <!-- Notification -->
        <TextBlock Grid.Row="2"
                   Text="{Binding Notification}"
                   FontSize="{local:Scale LabelFontSize}"
                   Foreground="{StaticResource Success}"
                   FontWeight="SemiBold"
                   AutomationProperties.LiveSetting="Polite">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Margin" Value="2,12,0,0"/>
                    <Style.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </Grid>
</UserControl>
