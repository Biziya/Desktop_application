<UserControl x:Class="Frontend.Pages.Measurement.MeasurementPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:capture="clr-namespace:Frontend.Pages.Measurement.CapturePanel"
             xmlns:table="clr-namespace:Frontend.Pages.Measurement.Table">
    <!-- The sections share this page's DataContext (MeasurementViewModel). Results, errors and status changes are
         toasts (MainWindow). -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Style="{StaticResource PageHeader}">
            <TextBlock Text="Measurement" Style="{StaticResource PageTitle}"/>
            <Button Style="{StaticResource HelpButton}"/>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Card}">
            <!-- The "complete Core Information" warning is inside the panel, under the inputs, so the chart can use
                 that height too. -->
            <capture:CapturePanelView/>
        </Border>

        <!-- Averaged Measurements table. Columns and sizes: MeasurementTable.yaml (application resources). -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0" Margin="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Margin="18,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Averaged Measurements"
                               FontSize="{StaticResource TableHeadingFontSize}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                    <!-- Starts a new measurement session (only while stopped). Start/Stop keeps the current one. -->
                    <Button Grid.Column="1"
                            Content="+   New Measurement"
                            FontSize="{StaticResource TableActionButtonFontSize}"
                            MinHeight="{StaticResource TableActionButtonMinHeight}"
                            Margin="0,0,10,0"
                            Command="{Binding NewMeasurementCommand}">
                        <!-- Disabled while measuring, or while no drillhole is saved: the screen-reader help text says which. -->
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SuccessButton}">
                                <Setter Property="AutomationProperties.HelpText" Value="{StaticResource HelpTextNewMeasurement}"/>
                                <Style.Triggers>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="AutomationProperties.HelpText" Value="{StaticResource HelpTextStartDisabled}"/>
                                    </Trigger>
                                    <DataTrigger Binding="{Binding IsMeasurementModeActive}" Value="True">
                                        <Setter Property="AutomationProperties.HelpText" Value="{StaticResource HelpTextNewMeasurementDisabled}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Grid.Column="2"
                            Content="↓   Export CSV"
                            FontSize="{StaticResource TableActionButtonFontSize}"
                            MinWidth="{StaticResource TableActionButtonMinWidth}"
                            MinHeight="{StaticResource TableActionButtonMinHeight}"
                            Command="{Binding ExportCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="AutomationProperties.HelpText" Value="{StaticResource HelpTextExport}"/>
                                <Style.Triggers>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="AutomationProperties.HelpText" Value="{StaticResource HelpTextExportDisabled}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>

                <table:MeasurementGrid Grid.Row="1" EmptyText="Your averaged measurements will appear here."/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
