<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:local="clr-namespace:Frontend.Pages.Measurement">

    <!-- ===== Table (implicit styles, scoped to this page by where the dictionary is merged) ===== -->

    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="{StaticResource Surface}"/>
        <Setter Property="Foreground" Value="{StaticResource Navy}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="RowBackground" Value="{StaticResource Surface}"/>
        <Setter Property="AlternatingRowBackground" Value="{StaticResource SidebarSurface}"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource Line}"/>
        <Setter Property="VerticalGridLinesBrush" Value="{StaticResource Line}"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <!-- Row text size is set once here; header, cells and the columns inherit it. -->
        <Setter Property="FontSize" Value="{local:Scale TableRowFontSize}"/>
        <Setter Property="RowHeight" Value="{local:Scale TableRowHeight}"/>
        <Setter Property="ColumnHeaderHeight" Value="{local:Scale TableHeaderHeight}"/>
        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="CanUserDeleteRows" Value="False"/>
        <Setter Property="CanUserSortColumns" Value="False"/>
        <Setter Property="CanUserReorderColumns" Value="False"/>
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="EnableColumnVirtualization" Value="True"/>
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
    </Style>

    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{StaticResource Canvas}"/>
        <Setter Property="Foreground" Value="{StaticResource Navy}"/>
        <Setter Property="Padding" Value="{local:Scale TableHeaderPadding, TableCellPaddingMultiplier}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FontSize" Value="{local:Scale TableHeaderFontSize}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
    </Style>

    <Style TargetType="DataGridCell">
        <Setter Property="Padding" Value="{local:Scale TableCellPadding}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <!-- Keeps WPF's default selected-cell highlight from showing through. -->
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource SoftBlue}"/>
                <Setter Property="Foreground" Value="{StaticResource Navy}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="DataGridRow">
        <Setter Property="BorderThickness" Value="0"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource HoverSurface}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource SoftBlue}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="CenteredTableText" TargetType="TextBlock">
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="CenteredTableHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
    </Style>

    <!-- ===== Start / Stop button ===== -->

    <Style x:Key="StartStopButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="FontSize" Value="{local:Scale StartStopButtonFontSize}"/>
        <Setter Property="MinWidth" Value="{local:Scale StartStopButtonWidth}"/>
        <Setter Property="MinHeight" Value="{local:Scale StartStopButtonHeight}"/>
        <Setter Property="Padding" Value="{local:Scale StartStopButtonPadding}"/>
    </Style>

    <!-- Glyph and label of the Start / Stop button; they switch with IsMeasurementModeActive. -->
    <Style x:Key="StartStopIconRun" TargetType="Run">
        <Setter Property="FontSize" Value="{local:Scale StartStopButtonIconFontSize}"/>
        <Setter Property="Text" Value="▶"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsMeasurementModeActive}" Value="True">
                <Setter Property="Text" Value="■"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="StartStopLabelRun" TargetType="Run">
        <Setter Property="Text">
            <Setter.Value>
                <sys:String xml:space="preserve">  Start</sys:String>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsMeasurementModeActive}" Value="True">
                <Setter Property="Text">
                    <Setter.Value>
                        <sys:String xml:space="preserve">  Stop</sys:String>
                    </Setter.Value>
                </Setter>
            </DataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
