<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:local="clr-namespace:Frontend.Pages.Measurement">

    <!-- ===== Table (implicit styles, scoped to this page by where the dictionary is merged) ===== -->

    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="{StaticResource Surface}"/>
        <Setter Property="Foreground" Value="{StaticResource Navy}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="RowBackground" Value="{StaticResource Surface}"/>
        <Setter Property="AlternatingRowBackground" Value="{StaticResource SubtleSurface}"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource Line}"/>
        <Setter Property="VerticalGridLinesBrush" Value="{StaticResource Line}"/>
        <!-- Vertical lines between every column use the same brush as the row lines and header border. -->
        <Setter Property="GridLinesVisibility" Value="All"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <!-- Row text size is set once here; header, cells and the columns inherit it. -->
        <Setter Property="FontSize" Value="{local:Scale TableRowFontSize}"/>
        <Setter Property="RowHeight" Value="{local:Scale TableRowHeight}"/>
        <!-- Header height grows when a narrow column wraps its header onto two lines (minimum on the header style). -->
        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="CanUserDeleteRows" Value="False"/>
        <Setter Property="CanUserSortColumns" Value="False"/>
        <Setter Property="CanUserReorderColumns" Value="False"/>
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="EnableColumnVirtualization" Value="True"/>
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
    </Style>

    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{StaticResource Canvas}"/>
        <Setter Property="Foreground" Value="{StaticResource Navy}"/>
        <Setter Property="Padding" Value="{local:Scale TableHeaderPadding, TableCellPaddingMultiplier}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FontSize" Value="{local:Scale TableHeaderFontSize}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="MinHeight" Value="{local:Scale TableHeaderHeight}"/>
        <!-- Right edge continues the column's vertical grid line through the header row. -->
        <Setter Property="BorderThickness" Value="0,0,1,1"/>
        <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
    </Style>

    <Style TargetType="DataGridCell">
        <Setter Property="Padding" Value="{local:Scale TableCellPadding}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <!-- Keeps WPF's default selected-cell highlight from showing through. -->
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource SoftBlue}"/>
                <Setter Property="Foreground" Value="{StaticResource Navy}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="DataGridRow">
        <Setter Property="BorderThickness" Value="0"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource HoverSurface}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource SoftBlue}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Cell text: centred; a value wider than its column ends in "…" and the full value is the tooltip. -->
    <Style x:Key="CenteredTableText" TargetType="TextBlock">
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
    </Style>

    <!-- Header text is centred and wraps (also inside a word such as count0_raw) instead of widening the column. -->
    <Style x:Key="CenteredTableHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <TextBlock Text="{Binding}" TextWrapping="Wrap" TextAlignment="Center"/>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Countdown (a button: click to edit the capture duration) ===== -->
    <!-- No fill or frame; hover tints the ring area, keyboard focus draws a blue circle. When disabled (a capture is
         running) the countdown looks exactly the same — it just cannot be clicked. -->
    <Style x:Key="CountdownButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <Ellipse x:Name="Hover" Fill="{StaticResource SoftBlue}" Opacity="0" Margin="6"/>
                        <ContentPresenter/>
                        <Ellipse x:Name="Focus" Stroke="{StaticResource Blue}" StrokeThickness="1.5" StrokeDashArray="3 2" Visibility="Collapsed"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Hover" Property="Opacity" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Focus" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Cursor" Value="Arrow"/>
                            <Setter TargetName="Hover" Property="Opacity" Value="0"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Start / Stop button ===== -->

    <Style x:Key="StartStopButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="FontSize" Value="{local:Scale StartStopButtonFontSize}"/>
        <Setter Property="MinWidth" Value="{local:Scale StartStopButtonWidth}"/>
        <!-- Exactly as tall as the Starting Depth and Step boxes (the box, not their labels). -->
        <Setter Property="Height" Value="{StaticResource ControlHeight}"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Padding" Value="{local:Scale StartStopButtonPadding}"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
    </Style>

    <!-- Glyph and label of the Start / Stop toggle; they switch with IsMeasurementModeActive. -->
    <Style x:Key="StartStopIconRun" TargetType="Run">
        <Setter Property="FontSize" Value="{local:Scale StartStopButtonIconFontSize}"/>
        <Setter Property="Text" Value="▶"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsMeasurementModeActive}" Value="True">
                <Setter Property="Text" Value="■"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="StartStopLabelRun" TargetType="Run">
        <Setter Property="Text">
            <Setter.Value>
                <sys:String xml:space="preserve">  Start</sys:String>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsMeasurementModeActive}" Value="True">
                <Setter Property="Text">
                    <Setter.Value>
                        <sys:String xml:space="preserve">  Stop</sys:String>
                    </Setter.Value>
                </Setter>
            </DataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
