<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Frontend.Pages.Measurement">
 <ResourceDictionary.MergedDictionaries>
  <ResourceDictionary Source="MeasurementUiConstants.xaml"/>
 </ResourceDictionary.MergedDictionaries>
 <local:ButtonTextPartConverter x:Key="ButtonTextPart"/>
 <Style TargetType="DataGrid"><Setter Property="Background" Value="{StaticResource Surface}"/><Setter Property="Foreground" Value="{StaticResource Navy}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="RowBackground" Value="{StaticResource Surface}"/><Setter Property="AlternatingRowBackground" Value="{StaticResource SidebarSurface}"/><Setter Property="HorizontalGridLinesBrush" Value="{StaticResource Line}"/><Setter Property="VerticalGridLinesBrush" Value="{StaticResource Line}"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="RowHeight" Value="{local:Scale TableRowHeight}"/><Setter Property="ColumnHeaderHeight" Value="{local:Scale TableHeaderHeight}"/><Setter Property="FontSize" Value="{local:Scale TableRowFontSize}"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="CanUserDeleteRows" Value="False"/><Setter Property="CanUserSortColumns" Value="False"/><Setter Property="CanUserReorderColumns" Value="False"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="EnableRowVirtualization" Value="True"/><Setter Property="EnableColumnVirtualization" Value="True"/><Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/></Style>
 <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="{StaticResource Canvas}"/><Setter Property="Foreground" Value="{StaticResource Navy}"/><Setter Property="Padding" Value="{local:ScaleThickness TableHeaderPadding, TableCellPaddingMultiplier}"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="FontSize" Value="{local:Scale TableHeaderFontSize}"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="BorderThickness" Value="0,0,0,1"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/></Style>
 <Style TargetType="DataGridCell"><Setter Property="Padding" Value="{local:ScaleThickness TableCellPadding}"/><Setter Property="FontSize" Value="{local:Scale TableRowFontSize}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell"><Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{StaticResource SoftBlue}"/><Setter Property="Foreground" Value="{StaticResource Navy}"/></Trigger></Style.Triggers></Style>
 <Style x:Key="StartStopButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
  <Setter Property="FontSize" Value="{local:Scale StartStopButtonFontSize}"/>
  <Setter Property="MinWidth" Value="{local:Scale StartStopButtonWidth}"/>
  <Setter Property="MinHeight" Value="{local:Scale StartStopButtonHeight}"/>
  <!-- Same text as before, split only so the glyph can have its own size multiplier. -->
  <Setter Property="ContentTemplate">
   <Setter.Value>
    <DataTemplate>
     <TextBlock Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"><Run Text="{Binding Mode=OneWay, Converter={StaticResource ButtonTextPart}, ConverterParameter=Icon}" FontSize="{local:Scale StartStopButtonIconFontSize}"/><Run Text="{Binding Mode=OneWay, Converter={StaticResource ButtonTextPart}, ConverterParameter=Label}"/></TextBlock>
    </DataTemplate>
   </Setter.Value>
  </Setter>
  <Setter Property="Padding" Value="{StaticResource StartStopButtonPadding}"/>
  <!-- Same template as the global Button, except the corner radius comes from the Measurement constants. -->
  <Setter Property="Template">
   <Setter.Value>
    <ControlTemplate TargetType="Button">
     <Border x:Name="Frame" CornerRadius="{StaticResource StartStopButtonCornerRadius}"
             Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
             BorderThickness="{TemplateBinding BorderThickness}">
      <Grid>
       <Border x:Name="Feedback" CornerRadius="{StaticResource StartStopButtonCornerRadius}" Background="White" Opacity="0" IsHitTestVisible="False"/>
       <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                         VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True"/>
       <Border x:Name="FocusRing" CornerRadius="6" BorderBrush="{StaticResource Navy}" BorderThickness="1" Margin="3" Visibility="Collapsed" IsHitTestVisible="False"/>
      </Grid>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Feedback" Property="Opacity" Value="0.13"/></Trigger>
      <Trigger Property="IsPressed" Value="True"><Setter TargetName="Feedback" Property="Background" Value="{StaticResource Navy}"/><Setter TargetName="Feedback" Property="Opacity" Value="0.12"/></Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FocusRing" Property="Visibility" Value="Visible"/></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="Opacity" Value="0.45"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate>
   </Setter.Value>
  </Setter>
 </Style>
 <Style x:Key="CenteredTableText" TargetType="TextBlock"><Setter Property="TextAlignment" Value="Center"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
 <Style x:Key="CenteredTableHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="HorizontalContentAlignment" Value="Center"/></Style>
 <Style TargetType="DataGridRow">
  <Setter Property="BorderThickness" Value="0"/>
  <Style.Triggers>
   <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource HoverSurface}"/></Trigger>
   <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{StaticResource SoftBlue}"/></Trigger>
  </Style.Triggers>
 </Style>
</ResourceDictionary>
