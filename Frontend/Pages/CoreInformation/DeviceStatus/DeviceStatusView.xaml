<UserControl x:Class="Frontend.Pages.CoreInformation.DeviceStatus.DeviceStatusView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Device Status of THIS laptop (the backend may run on another computer): the CT-007 Bluetooth connection and the
         two SQLite databases, checked locally (Calculation/Core-Information) at start, every few seconds and on Retry —
         also while the backend is offline. Paths are read-only text boxes: long paths wrap and can be selected and
         copied. Labels, sizes and spacing: DeviceStatus.yaml (application resources). -->
    <UserControl.Resources>
        <ResourceDictionary>
            <!-- Each row's DataContext is one LocalStatus (Devices.Bluetooth, Devices.MeasurementDatabase,
                 Devices.GammaGuardDatabase); its State colours the row: green Connected / Available, red Disconnected,
                 grey while checking or before a selection, amber otherwise (a missing, not found, inaccessible or busy
                 database, and "Status unavailable"). -->
            <Style x:Key="DeviceRow" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource WarningSurface}"/>
                <Setter Property="CornerRadius" Value="{StaticResource ControlRadius}"/>
                <Setter Property="Padding" Value="{StaticResource DeviceRowPadding}"/>
                <Setter Property="Margin" Value="{StaticResource DeviceRowMargin}"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding State}" Value="Connected">
                        <Setter Property="Background" Value="{StaticResource SuccessSurface}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding State}" Value="Available">
                        <Setter Property="Background" Value="{StaticResource SuccessSurface}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding State}" Value="Disconnected">
                        <Setter Property="Background" Value="{StaticResource DangerSurface}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding State}" Value="NotSelected">
                        <Setter Property="Background" Value="{StaticResource Canvas}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding State}" Value="Checking">
                        <Setter Property="Background" Value="{StaticResource Canvas}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="DeviceStatusValue" TargetType="TextBlock">
                <Setter Property="DockPanel.Dock" Value="Right"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="VerticalAlignment" Value="Top"/>
                <Setter Property="Foreground" Value="{StaticResource Warning}"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding State}" Value="Connected">
                        <Setter Property="Foreground" Value="{StaticResource Success}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding State}" Value="Available">
                        <Setter Property="Foreground" Value="{StaticResource Success}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding State}" Value="Disconnected">
                        <Setter Property="Foreground" Value="{StaticResource Danger}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding State}" Value="NotSelected">
                        <Setter Property="Foreground" Value="{StaticResource Muted}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding State}" Value="Checking">
                        <Setter Property="Foreground" Value="{StaticResource Muted}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <!-- Retry of a database row: shown for every result except a good one or a running check. -->
            <Style x:Key="DeviceRetry" TargetType="Button" BasedOn="{StaticResource SmallButton}">
                <Setter Property="DockPanel.Dock" Value="Right"/>
                <Setter Property="Content" Value="{StaticResource DeviceRetryLabel}"/>
                <Setter Property="Margin" Value="{StaticResource DeviceRetryMargin}"/>
                <Setter Property="Visibility" Value="{Binding CanRetry, Converter={StaticResource BoolVisibility}}"/>
            </Style>
            <!-- Gamma Guard row: Retry stays available next to a database that works too (it checks the selected
                 database first, then searches again); hidden only while a check runs. -->
            <Style x:Key="GammaGuardRetry" TargetType="Button" BasedOn="{StaticResource DeviceRetry}">
                <Setter Property="Visibility" Value="Visible"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding State}" Value="Checking">
                        <Setter Property="Visibility" Value="Collapsed"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <!-- Select Database (nothing available) / Change Database (a database is available): always shown, so an
                 automatically found database can be replaced at any time. -->
            <Style x:Key="GammaGuardSelect" TargetType="Button" BasedOn="{StaticResource SmallButton}">
                <Setter Property="DockPanel.Dock" Value="Right"/>
                <Setter Property="Margin" Value="{StaticResource DeviceRetryMargin}"/>
                <Setter Property="Content" Value="{StaticResource SelectDatabaseLabel}"/>
                <Setter Property="ToolTip" Value="{StaticResource SelectDatabaseToolTip}"/>
                <Setter Property="AutomationProperties.HelpText" Value="{StaticResource SelectDatabaseToolTip}"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding State}" Value="Available">
                        <Setter Property="Content" Value="{StaticResource ChangeDatabaseLabel}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Style="{StaticResource Card}">
        <StackPanel>
            <TextBlock Text="{StaticResource DeviceStatusTitle}" Style="{StaticResource SectionTitle}" Margin="{StaticResource DeviceStatusTitleMargin}"/>
            <Border Style="{StaticResource DeviceRow}" DataContext="{Binding Devices.Bluetooth}">
                <DockPanel>
                    <!-- No Retry: the selected device's connection is checked every second. The dropdown lists
                         paired/connected CT007-M devices (name + Bluetooth address); the user must pick one, and
                         picking only starts monitoring — no pairing or connection. Informational only: it never
                         enables or blocks measuring. -->
                    <TextBlock Style="{StaticResource DeviceStatusValue}"
                               AutomationProperties.Name="Bluetooth device status"><Run Text="{StaticResource DeviceStatusDot}"/><Run Text="{Binding Text, Mode=OneWay}"/></TextBlock>
                    <StackPanel Margin="{StaticResource DeviceRowLabelMargin}">
                        <TextBlock Text="{StaticResource BluetoothLabel}" Style="{StaticResource FieldLabel}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MaxWidth="{StaticResource BluetoothDropdownMaxWidth}"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox DisplayMemberPath="Display"
                                      SelectedItem="{Binding DataContext.Devices.SelectedBluetoothDevice, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                      ItemsSource="{Binding DataContext.Devices.BluetoothDevices, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                      DropDownOpened="BluetoothDropDownOpened"
                                      ToolTip="{StaticResource BluetoothDeviceToolTip}"
                                      AutomationProperties.Name="{StaticResource BluetoothDeviceToolTip}"/>
                        </Grid>
                        <TextBlock Style="{StaticResource StatusMessage}"
                                   Text="{Binding DataContext.Devices.BluetoothDevicesMessage, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                        <TextBlock Style="{StaticResource StatusMessage}" Text="{Binding Detail}" Margin="{StaticResource DeviceDetailMargin}"/>
                    </StackPanel>
                </DockPanel>
            </Border>
            <Border Style="{StaticResource DeviceRow}" DataContext="{Binding Devices.MeasurementDatabase}">
                <DockPanel>
                    <Button Style="{StaticResource DeviceRetry}"
                            Command="{Binding DataContext.RefreshMeasurementDatabaseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                    <TextBlock Style="{StaticResource DeviceStatusValue}"
                               AutomationProperties.Name="Measurement database status"><Run Text="{StaticResource DeviceStatusDot}"/><Run Text="{Binding Text, Mode=OneWay}"/></TextBlock>
                    <StackPanel Margin="{StaticResource DeviceRowLabelMargin}">
                        <TextBlock Text="{StaticResource MeasurementDatabaseLabel}" Style="{StaticResource FieldLabel}"/>
                        <TextBlock Style="{StaticResource StatusMessage}" Text="{Binding Detail}" Margin="{StaticResource DeviceDetailMargin}"/>
                        <TextBox Style="{StaticResource CopyableValue}"
                                 Text="{Binding Path, Mode=OneWay}"
                                 Visibility="{Binding HasPath, Converter={StaticResource BoolVisibility}}"
                                 AutomationProperties.Name="Measurement SQLite database path"/>
                    </StackPanel>
                </DockPanel>
            </Border>
            <Border Style="{StaticResource DeviceRow}" DataContext="{Binding Devices.GammaGuardDatabase}">
                <DockPanel>
                    <!-- Docked right in this order: [Retry] [Select / Change Database] -->
                    <Button Style="{StaticResource GammaGuardSelect}"
                            Command="{Binding DataContext.SelectGammaGuardDatabaseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                    <Button Style="{StaticResource GammaGuardRetry}"
                            Command="{Binding DataContext.RefreshGammaGuardDatabaseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                    <TextBlock Style="{StaticResource DeviceStatusValue}"
                               AutomationProperties.Name="Gamma Guard database status"><Run Text="{StaticResource DeviceStatusDot}"/><Run Text="{Binding Text, Mode=OneWay}"/></TextBlock>
                    <StackPanel Margin="{StaticResource DeviceRowLabelMargin}">
                        <TextBlock Text="{StaticResource GammaGuardDatabaseLabel}" Style="{StaticResource FieldLabel}"/>
                        <TextBlock Style="{StaticResource StatusMessage}" Text="{Binding Detail}" Margin="{StaticResource DeviceDetailMargin}"/>
                        <TextBox Style="{StaticResource CopyableValue}"
                                 Text="{Binding Path, Mode=OneWay}"
                                 Visibility="{Binding HasPath, Converter={StaticResource BoolVisibility}}"
                                 AutomationProperties.Name="Gamma Guard SQLite database path"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
