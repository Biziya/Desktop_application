<!--
  Device Status: labels, sizes and spacing of the CT007-M Bluetooth row and the two database rows.
  Display only: the checks themselves run in Calculation/Core-Information (DeviceStatusMonitor).
  Merged into DeviceStatusView.xaml only.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- ===== Labels ===== -->
    <sys:String x:Key="DeviceStatusTitle">Device Status</sys:String>
    <sys:String x:Key="BluetoothLabel">CT007-M Device — Bluetooth</sys:String>
    <sys:String x:Key="BluetoothDeviceToolTip">CT007-M device to monitor</sys:String>
    <sys:String x:Key="MeasurementDatabaseLabel">Measurement SQLite Database</sys:String>
    <sys:String x:Key="GammaGuardDatabaseLabel">Gamma Guard SQLite Database</sys:String>
    <sys:String x:Key="RetryLabel">Retry</sys:String>
    <!-- In front of the status text on the right of each row ("●  Connected"). -->
    <sys:String x:Key="StatusDot" xml:space="preserve">●  </sys:String>

    <!-- ===== Sizes ===== -->
    <!-- The Bluetooth dropdown is up to this wide, left-aligned, narrower when the window is. -->
    <sys:Double x:Key="BluetoothDropdownMaxWidth">360</sys:Double>

    <!-- ===== Spacing ===== -->
    <Thickness x:Key="DeviceStatusTitleMargin">0,0,0,8</Thickness>
    <Thickness x:Key="DeviceRowPadding">14,12</Thickness>
    <Thickness x:Key="DeviceRowMargin">0,8,0,0</Thickness>                <!-- between rows -->
    <Thickness x:Key="DeviceRowLabelMargin">0,0,12,0</Thickness>          <!-- between the label column and the status -->
    <Thickness x:Key="DeviceDetailMargin">0,3,0,0</Thickness>
    <Thickness x:Key="DeviceRetryMargin">12,0,0,0</Thickness>
</ResourceDictionary>
