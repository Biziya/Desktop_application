<UserControl x:Class="Frontend.Pages.CoreInformation.CoreInformationPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- Page-local layout styles; colours, labels and inputs come from Shared/Styles/Theme.xaml. -->
        <Style x:Key="FieldPanel" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,14,16"/>
        </Style>
        <Style x:Key="StatusRow" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SuccessSurface}"/>
            <Setter Property="CornerRadius" Value="{StaticResource ControlRadius}"/>
            <Setter Property="Padding" Value="14,12"/>
        </Style>
        <!-- Database path rows: same shape as the device row, neutral background, 8 px apart. -->
        <Style x:Key="PathRow" TargetType="Border" BasedOn="{StaticResource StatusRow}">
            <Setter Property="Background" Value="{StaticResource Canvas}"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
        </Style>
        <!-- Device row turns red when no CT007 is connected. -->
        <Style x:Key="DeviceRow" TargetType="Border" BasedOn="{StaticResource StatusRow}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDeviceConnected}" Value="False">
                    <Setter Property="Background" Value="{StaticResource DangerSurface}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DeviceStatusValue" TargetType="TextBlock">
            <Setter Property="DockPanel.Dock" Value="Right"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Success}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDeviceConnected}" Value="False">
                    <Setter Property="Foreground" Value="{StaticResource Danger}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="StatusDetail" TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>

            <!-- 1. Drillhole Information. Labels are display text only: Drillhole → DrillholeId (DrillholeID),
                 Project → DrillholeName (DrillholeName), Campaign → ProjectArea (Project). Row 1: four equal columns
                 with the same field margins; row 2: Notes across the full width. -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Drillhole Information" Style="{StaticResource SectionTitle}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Style="{StaticResource FieldPanel}">
                            <TextBlock Style="{StaticResource FieldLabel}"><Run Text="Drillhole"/><Run Text=" *" Style="{StaticResource RequiredStar}"/></TextBlock>
                            <TextBox Style="{StaticResource ValidatedInput}"
                                     Tag="{Binding DrillholeIdError}"
                                     Text="{Binding DrillholeId, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="Drillhole"/>
                            <TextBlock Style="{StaticResource ErrorText}" Text="{Binding DrillholeIdError}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Style="{StaticResource FieldPanel}">
                            <TextBlock Style="{StaticResource FieldLabel}"><Run Text="Project"/><Run Text=" *" Style="{StaticResource RequiredStar}"/></TextBlock>
                            <TextBox Style="{StaticResource ValidatedInput}"
                                     Tag="{Binding DrillholeNameError}"
                                     Text="{Binding DrillholeName, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="Project"/>
                            <TextBlock Style="{StaticResource ErrorText}" Text="{Binding DrillholeNameError}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Style="{StaticResource FieldPanel}">
                            <TextBlock Text="Campaign" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding ProjectArea, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="Campaign"/>
                        </StackPanel>
                        <StackPanel Grid.Column="3" Style="{StaticResource FieldPanel}">
                            <TextBlock Text="Operator" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding Operator, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="Operator"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.ColumnSpan="4" Style="{StaticResource FieldPanel}">
                            <TextBlock Text="Notes" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="Notes"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     Height="76"
                                     VerticalScrollBarVisibility="Auto"/>
                        </StackPanel>
                    </Grid>

                    <!-- Saving belongs to this form, so the action sits at its end. -->
                    <DockPanel Margin="0,4,14,0">
                        <Button DockPanel.Dock="Right" Content="Save &amp; Continue   ›" Command="{Binding SaveCommand}"/>
                        <TextBlock Text="Complete the required fields (*) before starting a measurement."
                                   Style="{StaticResource MutedText}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,16,0"/>
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- 2. Device Status: three rows — the CT007 connection, then the two databases (separate files).
                 Paths are read-only text boxes: long paths wrap and can be selected and copied.
                 The Bluetooth trigger indicator is not shown; the trigger itself (right-click in MainWindow) is unchanged. -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Device Status" Style="{StaticResource SectionTitle}"/>
                    <Border Style="{StaticResource DeviceRow}">
                        <DockPanel>
                            <TextBlock Style="{StaticResource DeviceStatusValue}"
                                       AutomationProperties.Name="Device connection status"><Run Text="●  "/><Run Text="{Binding DeviceStatus, Mode=OneWay}"/></TextBlock>
                            <StackPanel>
                                <TextBlock Text="SPP CT-007 Device" Style="{StaticResource FieldLabel}"/>
                                <TextBlock Style="{StaticResource StatusDetail}" Text="{Binding DeviceName}"/>
                                <TextBlock Style="{StaticResource StatusDetail}"
                                           Visibility="{Binding IsDeviceConnected, Converter={StaticResource BoolVisibility}}"><Run Text="ID: "/><Run Text="{Binding DeviceIdentifier, Mode=OneWay}"/></TextBlock>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource PathRow}">
                        <StackPanel>
                            <TextBlock Text="Measurement SQLite Database" Style="{StaticResource FieldLabel}"/>
                            <TextBox Style="{StaticResource CopyableValue}"
                                     Text="{Binding DatabasePath, Mode=OneWay}"
                                     AutomationProperties.Name="Measurement SQLite database path"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource PathRow}">
                        <StackPanel>
                            <TextBlock Text="Gamm Guard SQLite Database" Style="{StaticResource FieldLabel}"/>
                            <TextBox Style="{StaticResource CopyableValue}"
                                     Text="{Binding GammGuardDatabasePath, Mode=OneWay}"
                                     AutomationProperties.Name="Gamm Guard SQLite database path"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
