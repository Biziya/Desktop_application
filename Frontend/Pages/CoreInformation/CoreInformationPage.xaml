<UserControl x:Class="Frontend.Pages.CoreInformation.CoreInformationPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- Page-local styles that remove the repeated field / status-row markup. -->
        <Style x:Key="FieldPanel" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,14,16"/>
        </Style>
        <Style x:Key="RequiredStar" TargetType="Run">
            <Setter Property="Foreground" Value="{StaticResource Danger}"/>
        </Style>
        <Style x:Key="StatusRow" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SuccessSurface}"/>
            <Setter Property="CornerRadius" Value="{StaticResource ControlRadius}"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="StatusValue" TargetType="TextBlock">
            <Setter Property="DockPanel.Dock" Value="Right"/>
            <Setter Property="Width" Value="155"/>
            <Setter Property="Foreground" Value="{StaticResource Success}"/>
        </Style>
        <!-- Device row turns red when no CT007 is connected. -->
        <Style x:Key="DeviceRow" TargetType="Border" BasedOn="{StaticResource StatusRow}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDeviceConnected}" Value="False">
                    <Setter Property="Background" Value="{StaticResource DangerSurface}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DeviceStatusValue" TargetType="TextBlock" BasedOn="{StaticResource StatusValue}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDeviceConnected}" Value="False">
                    <Setter Property="Foreground" Value="{StaticResource Danger}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="StatusDetail" TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Drillhole Information" Style="{StaticResource SectionTitle}"/>
                    <UniformGrid Columns="3">
                        <StackPanel Style="{StaticResource FieldPanel}">
                            <TextBlock><Run Text="Drillhole ID"/><Run Text=" *" Style="{StaticResource RequiredStar}"/></TextBlock>
                            <TextBox Style="{StaticResource ValidatedInput}"
                                     Tag="{Binding DrillholeIdError}"
                                     Text="{Binding DrillholeId, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="Drillhole ID"/>
                            <TextBlock Style="{StaticResource ErrorText}" Text="{Binding DrillholeIdError}"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource FieldPanel}">
                            <TextBlock><Run Text="Drillhole Name"/><Run Text=" *" Style="{StaticResource RequiredStar}"/></TextBlock>
                            <TextBox Style="{StaticResource ValidatedInput}"
                                     Tag="{Binding DrillholeNameError}"
                                     Text="{Binding DrillholeName, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="Drillhole Name"/>
                            <TextBlock Style="{StaticResource ErrorText}" Text="{Binding DrillholeNameError}"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource FieldPanel}">
                            <TextBlock Text="Project / Area"/>
                            <TextBox Text="{Binding ProjectArea, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="Project / Area"/>
                        </StackPanel>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Core Information" Style="{StaticResource SectionTitle}"/>
                    <StackPanel Style="{StaticResource FieldPanel}">
                        <TextBlock><Run Text="Core ID"/><Run Text=" *" Style="{StaticResource RequiredStar}"/></TextBlock>
                        <TextBox Style="{StaticResource ValidatedInput}"
                                 Tag="{Binding CoreIdError}"
                                 Text="{Binding CoreId, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="Core ID"/>
                        <TextBlock Style="{StaticResource ErrorText}" Text="{Binding CoreIdError}"/>
                    </StackPanel>
                    <UniformGrid Columns="3">
                        <StackPanel Style="{StaticResource FieldPanel}">
                            <TextBlock><Run Text="Core Depth From (m)"/><Run Text=" *" Style="{StaticResource RequiredStar}"/></TextBlock>
                            <TextBox Style="{StaticResource ValidatedInput}"
                                     Tag="{Binding DepthError}"
                                     Text="{Binding DepthFrom, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="Core Depth From (m)"
                                     PreviewTextInput="DepthInput"
                                     DataObject.Pasting="DepthPaste"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource FieldPanel}">
                            <TextBlock><Run Text="Core Depth To (m)"/><Run Text=" *" Style="{StaticResource RequiredStar}"/></TextBlock>
                            <TextBox Style="{StaticResource ValidatedInput}"
                                     Tag="{Binding DepthError}"
                                     Text="{Binding DepthTo, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="Core Depth To (m)"
                                     PreviewTextInput="DepthInput"
                                     DataObject.Pasting="DepthPaste"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource FieldPanel}">
                            <TextBlock Text="Core Depth (m)"/>
                            <TextBox Text="{Binding CoreDepth, Mode=OneWay}"
                                     AutomationProperties.Name="Core Depth (m)"
                                     IsReadOnly="True"
                                     IsTabStop="False"/>
                        </StackPanel>
                    </UniformGrid>
                    <TextBlock Style="{StaticResource ErrorText}"
                               Text="{Binding DepthError}"
                               Margin="0,0,0,14"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="2*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Style="{StaticResource FieldPanel}">
                            <TextBlock Text="Operator"/>
                            <TextBox Text="{Binding Operator, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="Operator"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Notes"/>
                            <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="Notes"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     Height="76"
                                     VerticalScrollBarVisibility="Auto"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Device Status" Style="{StaticResource SectionTitle}"/>
                    <!-- The Bluetooth trigger indicator is not shown; the trigger itself (right-click in MainWindow) is unchanged. -->
                    <Border Style="{StaticResource DeviceRow}">
                        <DockPanel>
                            <TextBlock Style="{StaticResource DeviceStatusValue}"
                                       AutomationProperties.Name="Device connection status"><Run Text="●   "/><Run Text="{Binding DeviceStatus, Mode=OneWay}"/></TextBlock>
                            <StackPanel>
                                <TextBlock Text="SPP CT-007 Device"/>
                                <TextBlock Style="{StaticResource StatusDetail}" Text="{Binding DeviceName}"/>
                                <TextBlock Style="{StaticResource StatusDetail}"
                                           Visibility="{Binding IsDeviceConnected, Converter={StaticResource BoolVisibility}}"><Run Text="ID: "/><Run Text="{Binding DeviceIdentifier, Mode=OneWay}"/></TextBlock>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource StatusRow}" Background="{StaticResource ReadOnlySurface}">
                        <StackPanel>
                            <TextBlock Text="Measurement SQLite Database"/>
                            <!-- Read-only text box so the path can be selected and copied. -->
                            <TextBox Text="{Binding DatabasePath, Mode=OneWay}"
                                     IsReadOnly="True"
                                     TextWrapping="Wrap"
                                     FontSize="12"
                                     AutomationProperties.Name="Measurement SQLite database path"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Complete all required fields before starting a measurement."
                           Style="{StaticResource MutedText}"
                           VerticalAlignment="Center"
                           Margin="4,0,22,0"/>
                <Button Grid.Column="1" Content="Save &amp; Continue   ›" Command="{Binding SaveCommand}"/>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>
