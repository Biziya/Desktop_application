<UserControl x:Class="Frontend.Pages.CoreInformation.CoreInformationPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:Frontend.Shared.Infrastructure">
    <UserControl.Resources>
        <infra:SameItemConverter x:Key="SameItem"/>
        <!-- Page-local layout styles; colours, labels and inputs come from Shared/Styles/Theme.xaml. -->
        <!-- Drillhole dropdown entries: a group heading ("Measured drillholes" / "All drillholes") cannot be hovered,
             focused or selected, so the mouse and the arrow keys only land on drillholes. -->
        <Style x:Key="DrillholeItem" TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsHeader}" Value="True">
                    <Setter Property="IsEnabled" Value="False"/>
                    <Setter Property="Focusable" Value="False"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                    <Setter Property="Padding" Value="10,6,10,3"/>
                    <Setter Property="AutomationProperties.Name" Value="{Binding Header}"/>
                </DataTrigger>
                <!-- Closest match to the typed text (exact, then prefix, then partial): light fill and blue outline.
                     Only highlighted — Enter or a click picks it. -->
                <DataTrigger Value="True">
                    <DataTrigger.Binding>
                        <MultiBinding Converter="{StaticResource SameItem}">
                            <Binding/>
                            <Binding Path="DataContext.ClosestOption" RelativeSource="{RelativeSource AncestorType=ComboBox}"/>
                        </MultiBinding>
                    </DataTrigger.Binding>
                    <Setter Property="Background" Value="{StaticResource HoverSurface}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource Blue}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- Drillhole box: red border after Save & Continue without a drillhole (the message is a toast); disabled while
             measuring, because the drillhole cannot change until Stop. -->
        <Style x:Key="DrillholeBox" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="ToolTip" Value="{Binding DrillholeSearch}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasDrillholeError}" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource Danger}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelectionLocked}" Value="True">
                    <Setter Property="IsEnabled" Value="False"/>
                    <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
                    <Setter Property="ToolTip" Value="Stop the measurement to change the drillhole."/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="DrillholeEntry">
            <Grid>
                <!-- Heading: small muted caps; a thin line separates it from the group above. -->
                <StackPanel x:Name="HeaderPart" Visibility="Collapsed">
                    <Border x:Name="Separator" Height="1" Background="{StaticResource Line}" Margin="-10,0,-10,8" Visibility="Collapsed"/>
                    <TextBlock Text="{Binding Header}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Muted}"/>
                </StackPanel>
                <StackPanel x:Name="ItemPart" Orientation="Horizontal">
                    <TextBlock Text="{Binding HoleId}" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Details}" Foreground="{StaticResource Muted}" Margin="10,0,0,0"/>
                </StackPanel>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsHeader}" Value="True">
                    <Setter TargetName="HeaderPart" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="ItemPart" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding ShowSeparator}" Value="True">
                    <Setter TargetName="Separator" Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <Style x:Key="FieldPanel" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,14,16"/>
        </Style>
        <!-- Device Status rows. Each row's DataContext is one LocalStatus (Devices.Bluetooth, Devices.MeasurementDatabase,
             Devices.GammaGuardDatabase); its State colours the row: green Connected / Available, red Disconnected,
             amber for a missing, not found, inaccessible or busy database and for "Status unavailable", grey while checking. -->
        <Style x:Key="DeviceRow" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SuccessSurface}"/>
            <Setter Property="CornerRadius" Value="{StaticResource ControlRadius}"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="Disconnected">
                    <Setter Property="Background" Value="{StaticResource DangerSurface}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Missing">
                    <Setter Property="Background" Value="{StaticResource WarningSurface}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="NotFound">
                    <Setter Property="Background" Value="{StaticResource WarningSurface}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Inaccessible">
                    <Setter Property="Background" Value="{StaticResource WarningSurface}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Busy">
                    <Setter Property="Background" Value="{StaticResource WarningSurface}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Unavailable">
                    <Setter Property="Background" Value="{StaticResource WarningSurface}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Checking">
                    <Setter Property="Background" Value="{StaticResource Canvas}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DeviceStatusValue" TargetType="TextBlock">
            <Setter Property="DockPanel.Dock" Value="Right"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Foreground" Value="{StaticResource Success}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="Disconnected">
                    <Setter Property="Foreground" Value="{StaticResource Danger}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Missing">
                    <Setter Property="Foreground" Value="{StaticResource Warning}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="NotFound">
                    <Setter Property="Foreground" Value="{StaticResource Warning}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Inaccessible">
                    <Setter Property="Foreground" Value="{StaticResource Warning}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Busy">
                    <Setter Property="Foreground" Value="{StaticResource Warning}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Unavailable">
                    <Setter Property="Foreground" Value="{StaticResource Warning}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Checking">
                    <Setter Property="Foreground" Value="{StaticResource Muted}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- Loading / empty / error line under a field; hidden when empty. -->
        <Style x:Key="StatusMessage" TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,5,0,0"/>
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="StatusDetail" TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>

            <!-- 1. Drillhole Information. Labels are display text only: Drillhole → DrillholeId (DrillholeID),
                 Project → DrillholeName (DrillholeName), Campaign → ProjectArea (Project). Row 1: Drillhole (widest, for long
                 Hole IDs), Project, Campaign (compact: a year), Operator (fits DOMAIN\username); row 2: Notes, full width.
                 Minimum widths add up to the space available at the smallest window with the sidebar open. -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Drillhole Information" Style="{StaticResource SectionTitle}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2.3*" MinWidth="200"/>
                            <ColumnDefinition Width="1.3*" MinWidth="120"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="1.6*" MinWidth="150"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <!-- Searchable dropdown (cached backend list): type part of a Hole ID to filter; the closest match is
                             highlighted and Enter picks it; arrows + Enter or the mouse pick any entry; Escape closes the list.
                             Two groups: Measured drillholes (newest first), then All drillholes (A–Z); while searching, exact
                             matches first, then prefix, then partial. Picking fills Project and Campaign; typing never picks
                             or rewrites the text. The × clears the drillhole (not Operator, Notes or stored data). -->
                        <StackPanel Style="{StaticResource FieldPanel}">
                            <TextBlock Style="{StaticResource FieldLabel}"><Run Text="Drillhole"/><Run Text=" *" Style="{StaticResource RequiredStar}"/></TextBlock>
                            <!-- Text and SelectedItem are bound BEFORE ItemsSource on purpose: when the page is replaced
                                 (navigation), WPF detaches bindings in this order. With ItemsSource first, the emptied list
                                 cleared the selection and the dropdown wrote "" back into the still-attached Text binding,
                                 erasing the picked drillhole (and its Project/Campaign) in the ViewModel. -->
                            <Grid>
                                <ComboBox x:Name="DrillholeBox"
                                          Style="{StaticResource DrillholeBox}"
                                          IsEditable="True"
                                          IsTextSearchEnabled="False"
                                          StaysOpenOnEdit="True"
                                          Text="{Binding DrillholeSearch, UpdateSourceTrigger=PropertyChanged}"
                                          SelectedItem="{Binding PickedDrillhole, Mode=TwoWay}"
                                          ItemsSource="{Binding DrillholeOptions}"
                                          TextSearch.TextPath="HoleId"
                                          TextBoxBase.TextChanged="DrillholeTyped"
                                          PreviewKeyDown="DrillholeKeyDown"
                                          Padding="11,0,62,0"
                                          ItemContainerStyle="{StaticResource DrillholeItem}"
                                          ItemTemplate="{StaticResource DrillholeEntry}"
                                          AutomationProperties.Name="Drillhole"/>
                                <!-- Inside the box, left of the chevron; only shown when there is something to clear. -->
                                <Button Style="{StaticResource ClearButton}"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Margin="0,7,32,0"
                                        Command="{Binding ClearDrillholeCommand}"
                                        Visibility="{Binding CanClearDrillhole, Converter={StaticResource BoolVisibility}}"
                                        ToolTip="Clear drillhole"
                                        AutomationProperties.Name="Clear drillhole"/>
                            </Grid>
                            <DockPanel>
                                <Button DockPanel.Dock="Right"
                                        Content="Retry"
                                        Style="{StaticResource SmallButton}"
                                        Margin="8,5,0,0"
                                        Command="{Binding RefreshDrillholesCommand}"
                                        Visibility="{Binding CanRetryDrillholes, Converter={StaticResource BoolVisibility}}"/>
                                <TextBlock Style="{StaticResource StatusMessage}" Text="{Binding DrillholesMessage}"/>
                            </DockPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Style="{StaticResource FieldPanel}">
                            <TextBlock Text="Project" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding DrillholeName, Mode=OneWay}"
                                     IsReadOnly="True"
                                     IsTabStop="False"
                                     ToolTip="Filled from the selected drillhole."
                                     AutomationProperties.Name="Project"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Style="{StaticResource FieldPanel}">
                            <TextBlock Text="Campaign" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding ProjectArea, Mode=OneWay}"
                                     IsReadOnly="True"
                                     IsTabStop="False"
                                     ToolTip="Filled from the selected drillhole."
                                     AutomationProperties.Name="Campaign"/>
                        </StackPanel>
                        <StackPanel Grid.Column="3" Style="{StaticResource FieldPanel}">
                            <TextBlock Text="Operator" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding Operator, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="Operator"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.ColumnSpan="4" Style="{StaticResource FieldPanel}">
                            <TextBlock Text="Notes" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="Notes"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     Height="76"
                                     Padding="11,9"
                                     VerticalContentAlignment="Stretch"
                                     VerticalScrollBarVisibility="Auto"/>
                        </StackPanel>
                    </Grid>

                    <!-- Saving belongs to this form, so the action sits at its end. A missing drillhole is reported
                         under the Drillhole field only after Save & Continue. -->
                    <Button HorizontalAlignment="Right" Margin="0,4,14,0" Content="Save &amp; Continue   ›" Command="{Binding SaveCommand}"/>
                </StackPanel>
            </Border>

            <!-- 2. Device Status of THIS laptop (the backend may run on another computer): the CT-007 Bluetooth
                 connection and the two SQLite databases, checked locally (Calculation/Core-Information) at start, every
                 few seconds and on Retry — also while the backend is offline. Paths are read-only text boxes: long paths
                 wrap and can be selected and copied. The Bluetooth trigger indicator is not shown; the trigger itself
                 (right-click in MainWindow) is unchanged. -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Device Status" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                    <Border Style="{StaticResource DeviceRow}" DataContext="{Binding Devices.Bluetooth}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right"
                                    Content="Retry"
                                    Style="{StaticResource SmallButton}"
                                    Margin="12,0,0,0"
                                    VerticalAlignment="Top"
                                    Command="{Binding DataContext.RefreshBluetoothCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    Visibility="{Binding CanRetry, Converter={StaticResource BoolVisibility}}"/>
                            <TextBlock Style="{StaticResource DeviceStatusValue}"
                                       AutomationProperties.Name="Bluetooth device status"><Run Text="●  "/><Run Text="{Binding Text, Mode=OneWay}"/></TextBlock>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="SPP CT-007 Device — Bluetooth" Style="{StaticResource FieldLabel}"/>
                                <TextBlock Style="{StaticResource StatusMessage}" Text="{Binding Detail}" Margin="0,3,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource DeviceRow}" DataContext="{Binding Devices.MeasurementDatabase}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right"
                                    Content="Retry"
                                    Style="{StaticResource SmallButton}"
                                    Margin="12,0,0,0"
                                    VerticalAlignment="Top"
                                    Command="{Binding DataContext.RefreshMeasurementDatabaseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    Visibility="{Binding CanRetry, Converter={StaticResource BoolVisibility}}"/>
                            <TextBlock Style="{StaticResource DeviceStatusValue}"
                                       AutomationProperties.Name="Measurement database status"><Run Text="●  "/><Run Text="{Binding Text, Mode=OneWay}"/></TextBlock>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="Measurement SQLite Database" Style="{StaticResource FieldLabel}"/>
                                <TextBlock Style="{StaticResource StatusMessage}" Text="{Binding Detail}" Margin="0,3,0,0"/>
                                <TextBox Style="{StaticResource CopyableValue}"
                                         Text="{Binding Path, Mode=OneWay}"
                                         Visibility="{Binding HasPath, Converter={StaticResource BoolVisibility}}"
                                         AutomationProperties.Name="Measurement SQLite database path"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource DeviceRow}" DataContext="{Binding Devices.GammaGuardDatabase}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right"
                                    Content="Retry"
                                    Style="{StaticResource SmallButton}"
                                    Margin="12,0,0,0"
                                    VerticalAlignment="Top"
                                    Command="{Binding DataContext.RefreshGammaGuardDatabaseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    Visibility="{Binding CanRetry, Converter={StaticResource BoolVisibility}}"/>
                            <TextBlock Style="{StaticResource DeviceStatusValue}"
                                       AutomationProperties.Name="Gamma Guard database status"><Run Text="●  "/><Run Text="{Binding Text, Mode=OneWay}"/></TextBlock>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="Gamma Guard SQLite Database" Style="{StaticResource FieldLabel}"/>
                                <TextBlock Style="{StaticResource StatusMessage}" Text="{Binding Detail}" Margin="0,3,0,0"/>
                                <TextBox Style="{StaticResource CopyableValue}"
                                         Text="{Binding Path, Mode=OneWay}"
                                         Visibility="{Binding HasPath, Converter={StaticResource BoolVisibility}}"
                                         AutomationProperties.Name="Gamma Guard SQLite database path"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
