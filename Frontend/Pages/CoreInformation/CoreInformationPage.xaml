<UserControl x:Class="Frontend.Pages.CoreInformation.CoreInformationPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:drillhole="clr-namespace:Frontend.Pages.CoreInformation.DrillholeInformation"
             xmlns:device="clr-namespace:Frontend.Pages.CoreInformation.DeviceStatus">
    <!-- Page composition only. Both sections share this page's DataContext (CoreInformationViewModel). -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <drillhole:DrillholeInformationView/>
            <device:DeviceStatusView/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
