<UserControl x:Class="Frontend.Pages.CoreInformation.CoreInformationPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
<Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="♧   Drillhole Information" Style="{StaticResource SectionTitle}"/><UniformGrid Columns="3"><StackPanel Margin="0,0,14,16"><TextBlock><Run Text="Drillhole ID"/><Run Text=" *" Foreground="#D82C46"/></TextBlock><TextBox Text="{Binding DrillholeId, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Drillhole ID"/><TextBlock Style="{StaticResource ErrorText}" Text="{Binding DrillholeIdError}"/></StackPanel><StackPanel Margin="0,0,14,16"><TextBlock><Run Text="Drillhole Name"/><Run Text=" *" Foreground="#D82C46"/></TextBlock><TextBox Text="{Binding DrillholeName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Drillhole Name"/><TextBlock Style="{StaticResource ErrorText}" Text="{Binding DrillholeNameError}"/></StackPanel><StackPanel Margin="0,0,14,16"><TextBlock><Run Text="Project / Area"/></TextBlock><TextBox Text="{Binding ProjectArea, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Project / Area"/></StackPanel></UniformGrid></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="◇   Core Information" Style="{StaticResource SectionTitle}"/><StackPanel Margin="0,0,14,16"><TextBlock><Run Text="Core ID"/><Run Text=" *" Foreground="#D82C46"/></TextBlock><TextBox Text="{Binding CoreId, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Core ID"/><TextBlock Style="{StaticResource ErrorText}" Text="{Binding CoreIdError}"/></StackPanel><UniformGrid Columns="3"><StackPanel Margin="0,0,14,16"><TextBlock><Run Text="Core Depth From (m)"/><Run Text=" *" Foreground="#D82C46"/></TextBlock><TextBox Text="{Binding DepthFrom, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Core Depth From (m)" PreviewTextInput="DepthInput" DataObject.Pasting="DepthPaste"/></StackPanel><StackPanel Margin="0,0,14,16"><TextBlock><Run Text="Core Depth To (m)"/><Run Text=" *" Foreground="#D82C46"/></TextBlock><TextBox Text="{Binding DepthTo, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Core Depth To (m)" PreviewTextInput="DepthInput" DataObject.Pasting="DepthPaste"/></StackPanel><StackPanel Margin="0,0,14,16"><TextBlock><Run Text="Core Depth (m)"/></TextBlock><TextBox Text="{Binding CoreDepth, Mode=OneWay}" AutomationProperties.Name="Core Depth (m)" IsReadOnly="True" IsTabStop="False"/></StackPanel></UniformGrid><TextBlock Style="{StaticResource ErrorText}" Text="{Binding DepthError}" Margin="0,0,0,14"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,14,16"><TextBlock><Run Text="Operator"/></TextBlock><TextBox Text="{Binding Operator, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Operator"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Notes"/><TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Notes" AcceptsReturn="True" TextWrapping="Wrap" Height="76" VerticalScrollBarVisibility="Auto"/></StackPanel></Grid></StackPanel></Border>
<Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="⚙   Device Status" Style="{StaticResource SectionTitle}"/><Border Background="#EDFAF2" CornerRadius="5" Padding="12,9" Margin="0,0,0,6"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="155"/></Grid.ColumnDefinitions><TextBlock Text="SPP CT-007 Device"/><TextBlock Grid.Column="1" Text="●   Connected" Foreground="#008B46"/></Grid></Border><Border Background="#EDFAF2" CornerRadius="5" Padding="12,9" Margin="0,0,0,6"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="155"/></Grid.ColumnDefinitions><TextBlock Text="Bluetooth Trigger"/><TextBlock Grid.Column="1" Text="●   Connected" Foreground="#008B46"/></Grid></Border><Border Background="#EDFAF2" CornerRadius="5" Padding="12,9" Margin="0,0,0,6"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="155"/></Grid.ColumnDefinitions><TextBlock Text="Measurement SQLite Source"/><TextBlock Grid.Column="1" Text="●   Ready" Foreground="#008B46"/></Grid></Border><TextBlock Text="Mock indicators — no hardware connection." Style="{StaticResource MutedText}" FontSize="12" Margin="0,9,0,0"/></StackPanel></Border>
<Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Complete all required fields before starting a measurement." Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="4,0,22,0"/><Button Grid.Column="1" Content="Save &amp; Continue   ›" Command="{Binding SaveCommand}"/></Grid>
</StackPanel></ScrollViewer></UserControl>
