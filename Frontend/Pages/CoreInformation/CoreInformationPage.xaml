<UserControl x:Class="Frontend.Pages.CoreInformation.CoreInformationPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:drillhole="clr-namespace:Frontend.Pages.CoreInformation.DrillholeInformation"
             xmlns:device="clr-namespace:Frontend.Pages.CoreInformation.DeviceStatus">
    <!-- Both sections share this page's DataContext (CoreInformationViewModel): Drillhole Information, then Device Status.
         The title stays fixed; only the cards scroll, with the scroll bar in the page margin. -->
    <DockPanel>
        <Grid DockPanel.Dock="Top" Style="{StaticResource PageHeader}">
            <TextBlock Text="Core Information" Style="{StaticResource PageTitle}"/>
            <Button Style="{StaticResource HelpButton}"/>
        </Grid>
        <ScrollViewer Style="{StaticResource PageScroll}">
            <StackPanel Margin="{StaticResource PageScrollContentMargin}">
                <drillhole:DrillholeInformationView/>
                <device:DeviceStatusView/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
