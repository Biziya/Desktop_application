<UserControl x:Class="Frontend.Pages.UploadData.UploadDataPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:table="clr-namespace:Frontend.Pages.Measurement.Table">
    <!-- Upload Data: Import CSV → review (rows can only be removed) → Upload Data. DataContext: UploadDataViewModel.
         Results and errors are toasts (MainWindow). The table is the Measurement page's (MeasurementGrid, MeasurementTable.yaml). -->
    <UserControl.Resources>
        <!-- Measurement Information: label column (Auto, so labels line up) and value column; one gap between fields. -->
        <Style x:Key="InfoLabel" TargetType="TextBlock" BasedOn="{StaticResource FieldLabel}">
            <Setter Property="Margin" Value="0,0,16,6"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
        </Style>
        <!-- A value too long for its column ends in "…"; the full value is the tooltip. -->
        <Style x:Key="InfoValue" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,32,6"/>
            <Setter Property="Foreground" Value="{StaticResource Navy}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Measurement Information" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center"/>
                    <Button Grid.Column="1"
                            Content="↓   Import CSV"
                            Style="{StaticResource SecondaryButton}"
                            FontSize="{StaticResource TableActionButtonFontSize}"
                            MinWidth="{StaticResource TableActionButtonMinWidth}"
                            MinHeight="{StaticResource TableActionButtonMinHeight}"
                            Margin="0,0,10,0"
                            ToolTip="Choose a CSV file exported from the Measurement page. The file is only read."
                            Command="{Binding ImportCommand}"/>
                    <Button Grid.Column="2"
                            Content="{Binding UploadLabel}"
                            FontSize="{StaticResource TableActionButtonFontSize}"
                            MinWidth="{StaticResource TableActionButtonMinWidth}"
                            MinHeight="{StaticResource TableActionButtonMinHeight}"
                            ToolTip="Store the measurements below in the central database."
                            AutomationProperties.Name="Upload Data"
                            Command="{Binding UploadCommand}"/>
                </Grid>

                <TextBlock Text="Import a CSV file exported from the Measurement page to review and upload its measurements."
                           Margin="0,16,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasImport}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- The imported file and session on the left, the drillhole on the right; Notes wraps (up to three lines,
                     the rest in the tooltip). Missing values (older exports) read "Not available". Read-only. -->
                <Grid Visibility="{Binding HasImport, Converter={StaticResource BoolVisibility}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*" MinWidth="120"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*" MinWidth="120"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.ColumnSpan="4" Height="1" Margin="0,14,0,12" Background="{StaticResource Line}"/>

                    <TextBlock Grid.Row="1" Text="Filename" Style="{StaticResource InfoLabel}"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding FileName}" Style="{StaticResource InfoValue}"/>
                    <TextBlock Grid.Row="2" Text="Created At" Style="{StaticResource InfoLabel}"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding CreatedAt}" Style="{StaticResource InfoValue}"/>
                    <TextBlock Grid.Row="3" Text="Operator" Style="{StaticResource InfoLabel}"/>
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Operator}" Style="{StaticResource InfoValue}"/>
                    <TextBlock Grid.Row="4" Text="Uploading User" Style="{StaticResource InfoLabel}"/>
                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding UploadingUsername}" Style="{StaticResource InfoValue}"/>

                    <TextBlock Grid.Row="1" Grid.Column="2" Text="Drillhole" Style="{StaticResource InfoLabel}"/>
                    <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding Drillhole}" Style="{StaticResource InfoValue}"/>
                    <TextBlock Grid.Row="2" Grid.Column="2" Text="Project" Style="{StaticResource InfoLabel}"/>
                    <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding Project}" Style="{StaticResource InfoValue}"/>
                    <TextBlock Grid.Row="3" Grid.Column="2" Text="Campaign" Style="{StaticResource InfoLabel}"/>
                    <TextBlock Grid.Row="3" Grid.Column="3" Text="{Binding Campaign}" Style="{StaticResource InfoValue}"/>
                    <TextBlock Grid.Row="4" Grid.Column="2" Text="Notes" Style="{StaticResource InfoLabel}"/>
                    <TextBlock Grid.Row="4" Grid.Column="3" Text="{Binding Notes}" Style="{StaticResource InfoValue}"
                               TextWrapping="Wrap" TextTrimming="WordEllipsis" MaxHeight="60"/>
                </Grid>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0" Margin="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Margin="18,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Measurements" FontSize="{StaticResource TableHeadingFontSize}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding TotalText}" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                </Grid>
                <table:MeasurementGrid Grid.Row="1" EmptyText="Imported measurements will appear here."/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
