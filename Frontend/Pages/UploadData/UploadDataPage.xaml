<UserControl x:Class="Frontend.Pages.UploadData.UploadDataPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:table="clr-namespace:Frontend.Pages.Measurement.Table">
    <!-- Upload Data: Import CSV → review (rows can only be removed) → Upload Data. DataContext: UploadDataViewModel.
         Results and errors are toasts (MainWindow). The table is the Measurement page's (MeasurementGrid, MeasurementTable.yaml). -->
    <UserControl.Resources>
        <Style x:Key="InfoLabel" TargetType="TextBlock" BasedOn="{StaticResource FieldLabel}">
            <Setter Property="Margin" Value="0,0,16,8"/>
        </Style>
        <Style x:Key="InfoValue" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,24,8"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{StaticResource Navy}"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Measurement Information" Style="{StaticResource SectionTitle}" Margin="0"/>
                        <TextBlock Text="{Binding FileName}" Style="{StaticResource MutedText}" Margin="0,4,0,0"
                                   Visibility="{Binding HasImport, Converter={StaticResource BoolVisibility}}"/>
                    </StackPanel>
                    <Button Grid.Column="1"
                            Content="↓   Import CSV"
                            Style="{StaticResource SecondaryButton}"
                            FontSize="{StaticResource TableActionButtonFontSize}"
                            MinWidth="{StaticResource TableActionButtonMinWidth}"
                            MinHeight="{StaticResource TableActionButtonMinHeight}"
                            Margin="0,0,10,0"
                            ToolTip="Choose a CSV file exported from the Measurement page. The file is only read."
                            Command="{Binding ImportCommand}"/>
                    <Button Grid.Column="2"
                            Content="{Binding UploadLabel}"
                            FontSize="{StaticResource TableActionButtonFontSize}"
                            MinWidth="{StaticResource TableActionButtonMinWidth}"
                            MinHeight="{StaticResource TableActionButtonMinHeight}"
                            ToolTip="Store the measurements below in the central database."
                            AutomationProperties.Name="Upload Data"
                            Command="{Binding UploadCommand}"/>
                </Grid>

                <TextBlock Text="Import a CSV file exported from the Measurement page to review and upload its measurements."
                           Margin="0,16,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasImport}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- Labels as on Core Information. Empty or missing values (older exports) read "Not available". -->
                <Grid Margin="0,16,0,0" Visibility="{Binding HasImport, Converter={StaticResource BoolVisibility}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Drillhole" Style="{StaticResource InfoLabel}"/>
                    <TextBlock Grid.Column="1" Text="{Binding Drillhole}" Style="{StaticResource InfoValue}"/>
                    <TextBlock Grid.Column="2" Text="Created Username" Style="{StaticResource InfoLabel}"/>
                    <TextBlock Grid.Column="3" Text="{Binding CreatedUsername}" Style="{StaticResource InfoValue}"/>

                    <TextBlock Grid.Row="1" Text="Project" Style="{StaticResource InfoLabel}"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Project}" Style="{StaticResource InfoValue}"/>
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="Uploading Username" Style="{StaticResource InfoLabel}"/>
                    <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding UploadingUsername}" Style="{StaticResource InfoValue}"/>

                    <TextBlock Grid.Row="2" Text="Campaign" Style="{StaticResource InfoLabel}"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Campaign}" Style="{StaticResource InfoValue}"/>

                    <TextBlock Grid.Row="3" Text="Operator" Style="{StaticResource InfoLabel}"/>
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Operator}" Style="{StaticResource InfoValue}"/>
                    <TextBlock Grid.Row="2" Grid.Column="2" Text="Notes" Style="{StaticResource InfoLabel}"/>
                    <TextBlock Grid.Row="2" Grid.RowSpan="2" Grid.Column="3" Text="{Binding Notes}" Style="{StaticResource InfoValue}"/>
                </Grid>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0" Margin="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Margin="18,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Measurements" FontSize="{StaticResource TableHeadingFontSize}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding TotalText}" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                </Grid>
                <table:MeasurementGrid Grid.Row="1" EmptyText="Imported measurements will appear here."/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
