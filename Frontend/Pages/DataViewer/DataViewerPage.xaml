<UserControl x:Class="Frontend.Pages.DataViewer.DataViewerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:table="clr-namespace:Frontend.Pages.Measurement.Table">
    <!-- DataContext: DataViewerViewModel. Uploaded measurements (central database), by drillhole; read-only.
         The drillhole card mirrors Core Information's Drillhole Information form; the table is the Measurement page's. -->
    <UserControl.Resources>
        <Style x:Key="FieldPanel" TargetType="StackPanel">
            <Setter Property="Margin" Value="{StaticResource DrillholeFieldMargin}"/>
        </Style>
        <Style x:Key="ReadOnlyField" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="IsTabStop" Value="False"/>
        </Style>
        <DataTemplate x:Key="DrillholeEntry">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding HoleId}" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding Details}" Foreground="{StaticResource Muted}" Margin="10,0,0,0"/>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Style="{StaticResource PageHeader}">
            <TextBlock Text="Data Viewer" Style="{StaticResource PageTitle}"/>
            <Button Style="{StaticResource HelpButton}"/>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="{StaticResource DrillholeSectionTitle}" Style="{StaticResource SectionTitle}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{StaticResource DrillholeColumnWidth}" MinWidth="{StaticResource DrillholeColumnMinWidth}"/>
                        <ColumnDefinition Width="{StaticResource ProjectColumnWidth}" MinWidth="{StaticResource ProjectColumnMinWidth}"/>
                        <ColumnDefinition Width="{StaticResource CampaignColumnWidth}"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <!-- Text and SelectedItem are bound before ItemsSource, as on Core Information (navigation detaches
                         bindings in this order, so the emptied list cannot erase the pick). -->
                    <StackPanel Style="{StaticResource FieldPanel}">
                        <TextBlock Text="{StaticResource DrillholeLabel}" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="DrillholeBox"
                                  IsEditable="True"
                                  IsTextSearchEnabled="False"
                                  StaysOpenOnEdit="True"
                                  Text="{Binding DrillholeSearch, UpdateSourceTrigger=PropertyChanged}"
                                  SelectedItem="{Binding PickedDrillhole, Mode=TwoWay}"
                                  ItemsSource="{Binding DrillholeOptions}"
                                  TextSearch.TextPath="HoleId"
                                  TextBoxBase.TextChanged="DrillholeTyped"
                                  ItemTemplate="{StaticResource DrillholeEntry}"
                                  ToolTip="Type to search the uploaded drillholes"
                                  AutomationProperties.Name="Drillhole"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Style="{StaticResource FieldPanel}">
                        <TextBlock Text="{StaticResource ProjectLabel}" Style="{StaticResource FieldLabel}"/>
                        <TextBox Style="{StaticResource ReadOnlyField}" Text="{Binding Project, Mode=OneWay}"
                                 AutomationProperties.Name="{StaticResource ProjectLabel}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Style="{StaticResource FieldPanel}">
                        <TextBlock Text="{StaticResource CampaignLabel}" Style="{StaticResource FieldLabel}"/>
                        <TextBox Style="{StaticResource ReadOnlyField}" Text="{Binding Campaign, Mode=OneWay}"
                                 AutomationProperties.Name="{StaticResource CampaignLabel}"/>
                    </StackPanel>
                    <Button Grid.Column="3" Content="Refresh" Style="{StaticResource SecondaryButton}" VerticalAlignment="Bottom"
                            Margin="0,0,0,16" Command="{Binding RefreshCommand}"
                            ToolTip="Load the uploaded data from the central database again"/>
                </Grid>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="{StaticResource RetryDrillholesLabel}" Style="{StaticResource SmallButton}"
                            Command="{Binding RefreshCommand}"
                            Visibility="{Binding CanRetry, Converter={StaticResource BoolVisibility}}"/>
                    <TextBlock Style="{StaticResource StatusMessage}" Text="{Binding Message}" Margin="0,0,0,0"/>
                </DockPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0" Margin="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Margin="18,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Uploaded Measurements" FontSize="{StaticResource TableHeadingFontSize}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding Summary}" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                </Grid>
                <table:MeasurementGrid Grid.Row="1" ShowDelete="False" EmptyText="{Binding EmptyText}"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
