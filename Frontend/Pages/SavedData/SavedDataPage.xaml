<UserControl x:Class="Frontend.Pages.SavedData.SavedDataPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- DataContext: SavedDataViewModel. Read-only browser over measurements.db. -->
    <UserControl.Resources>
        <Style x:Key="SessionItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="8,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Frame" Padding="{TemplateBinding Padding}" CornerRadius="{StaticResource ControlRadius}"
                                Background="Transparent" BorderBrush="Transparent" BorderThickness="1.5">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Frame" Property="Background" Value="{StaticResource HoverSurface}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Frame" Property="Background" Value="{StaticResource SoftBlue}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource Blue}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MetaLabel" TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="MetaValue" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,2,0,0"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Style="{StaticResource PageHeader}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Saved Data" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="Measurements stored on this laptop, by drillhole. Read-only: edit captures on the Measurement page."
                           Style="{StaticResource PageSubtitle}"/>
            </StackPanel>
            <Button Grid.Column="1" Content="Refresh" Style="{StaticResource SecondaryButton}" VerticalAlignment="Center"
                    Command="{Binding RefreshCommand}"/>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <!-- Sessions -->
            <Border Style="{StaticResource Card}" Padding="0" Margin="0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="16,16,16,8">
                        <Grid>
                            <TextBox x:Name="Search" Margin="0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="11,0,32,0" AutomationProperties.Name="Search sessions"/>
                            <TextBlock Text="Search drillhole, project, operator" Style="{StaticResource MutedText}" Margin="12,0,0,0"
                                       VerticalAlignment="Center" IsHitTestVisible="False"
                                       Visibility="{Binding SearchText, Converter={StaticResource ZeroLengthVisibility}}"/>
                            <Button Style="{StaticResource ClearButton}" HorizontalAlignment="Right" Margin="0,0,8,0"
                                    Command="{Binding ClearSearchCommand}" ToolTip="Clear search" AutomationProperties.Name="Clear search"
                                    Visibility="{Binding SearchText, Converter={StaticResource NonEmptyVisibility}}"/>
                        </Grid>
                        <ComboBox ItemsSource="{Binding Periods}" SelectedItem="{Binding SelectedPeriod}" Margin="0,8,0,0"
                                  AutomationProperties.Name="Period"/>
                        <TextBlock Text="{Binding SessionsSummary}" Style="{StaticResource MetaLabel}" Margin="2,10,0,0"/>
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding LoadError}" Style="{StaticResource StatusMessage}" Foreground="{StaticResource Danger}"
                               Margin="16,0,16,8"/>
                    <Grid>
                        <ListBox ItemsSource="{Binding Sessions}" SelectedItem="{Binding SelectedSession}" BorderThickness="0"
                                 Background="Transparent" ItemContainerStyle="{StaticResource SessionItem}" Padding="0,0,0,8"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Sessions">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="1" Style="{StaticResource MetaLabel}" Margin="8,0,0,0"
                                                       Text="{Binding RecordCount, StringFormat={}{0} captures}"/>
                                        </Grid>
                                        <TextBlock Style="{StaticResource MetaLabel}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0">
                                            <Run Text="{Binding Project, TargetNullValue=No project, Mode=OneWay}"/>
                                            <Run Text=" · "/>
                                            <Run Text="{Binding LastActivity, StringFormat={}{0:d MMM yyyy, HH:mm}, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Text="No sessions match. Saved measurements appear here after Save &amp; Continue on the Measurement page."
                                   Style="{StaticResource EmptyStateText}"
                                   Visibility="{Binding Sessions.Count, Converter={StaticResource ZeroVisibility}}"/>
                    </Grid>
                </DockPanel>
            </Border>

            <!-- Selected session -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0" Margin="0">
                <Grid>
                    <TextBlock Text="Select a session to see its captures." Style="{StaticResource EmptyStateText}"
                               Visibility="{Binding HasSelectedSession, Converter={StaticResource InverseBoolVisibility}}"/>

                    <Grid Visibility="{Binding HasSelectedSession, Converter={StaticResource BoolVisibility}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Margin="20,16,20,12">
                            <TextBlock Text="{Binding SelectedSession.Title}" Style="{StaticResource CardTitle}"/>
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="Drillhole name" Style="{StaticResource MetaLabel}"/>
                                    <TextBlock Text="{Binding SelectedSession.DrillholeName, TargetNullValue=–}" Style="{StaticResource MetaValue}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="0,0,16,0">
                                    <TextBlock Text="Project" Style="{StaticResource MetaLabel}"/>
                                    <TextBlock Text="{Binding SelectedSession.Project, TargetNullValue=–}" Style="{StaticResource MetaValue}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="0,0,16,0">
                                    <TextBlock Text="Operator" Style="{StaticResource MetaLabel}"/>
                                    <TextBlock Text="{Binding SelectedSession.Operator, TargetNullValue=–}" Style="{StaticResource MetaValue}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="3">
                                    <TextBlock Text="Started" Style="{StaticResource MetaLabel}"/>
                                    <TextBlock Text="{Binding SelectedSession.CreatedAt, StringFormat={}{0:d MMM yyyy, HH:mm}}" Style="{StaticResource MetaValue}"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="{Binding SelectedSession.Comment}" Style="{StaticResource MutedText}" Margin="0,10,0,0"
                                       Visibility="{Binding SelectedSession.Comment, Converter={StaticResource NonEmptyVisibility}}"/>
                        </StackPanel>

                        <Grid Grid.Row="1">
                            <DataGrid Style="{StaticResource DataTable}" ItemsSource="{Binding Records}" SelectedItem="{Binding SelectedRecord}"
                                      AutomationProperties.Name="Captures">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="#" Binding="{Binding CaptureNo}" Width="44"/>
                                    <DataGridTextColumn Header="Depth (m)" Binding="{Binding Interval}" Width="1.3*"/>
                                    <DataGridTextColumn Header="Start" Binding="{Binding StartTime, StringFormat={}{0:d MMM HH:mm}}" Width="1.1*"/>
                                    <DataGridTextColumn Header="Samples" Binding="{Binding Samples}" Width="0.8*"/>
                                    <DataGridTextColumn Header="CPS" Binding="{Binding Cps, StringFormat=0.00}" Width="0.8*" ElementStyle="{StaticResource NumberCell}" HeaderStyle="{StaticResource NumberHeader}"/>
                                    <DataGridTextColumn Header="CPS raw" Binding="{Binding CpsRaw, StringFormat=0.00}" Width="0.8*" ElementStyle="{StaticResource NumberCell}" HeaderStyle="{StaticResource NumberHeader}"/>
                                    <DataGridTextColumn Header="Dose rate" Binding="{Binding DoseRate, StringFormat=0.###}" Width="0.8*" ElementStyle="{StaticResource NumberCell}" HeaderStyle="{StaticResource NumberHeader}"/>
                                    <DataGridTextColumn Header="Temp. (°C)" Binding="{Binding Temperature, StringFormat=0.0}" Width="0.95*" ElementStyle="{StaticResource NumberCell}" HeaderStyle="{StaticResource NumberHeader}"/>
                                    <DataGridTextColumn Header="Detector" Binding="{Binding DeviceSerial}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Text="This session has no captures." Style="{StaticResource EmptyStateText}"
                                       Visibility="{Binding Records.Count, Converter={StaticResource ZeroVisibility}}"/>
                        </Grid>

                        <!-- Pager -->
                        <Grid Grid.Row="2" Margin="20,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding RecordsSummary}" Style="{StaticResource MetaLabel}" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="Previous" Style="{StaticResource SmallButton}" Margin="0,0,8,0"
                                    Command="{Binding PreviousPageCommand}"
                                    Visibility="{Binding HasMultiplePages, Converter={StaticResource BoolVisibility}}"/>
                            <Button Grid.Column="2" Content="Next" Style="{StaticResource SmallButton}"
                                    Command="{Binding NextPageCommand}"
                                    Visibility="{Binding HasMultiplePages, Converter={StaticResource BoolVisibility}}"/>
                        </Grid>

                        <!-- Raw samples of the selected capture -->
                        <Border Grid.Row="3" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0"
                                Visibility="{Binding HasSelectedRecord, Converter={StaticResource BoolVisibility}}">
                            <StackPanel>
                                <Grid Margin="20,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource CardTitle}" FontSize="14"
                                               Text="{Binding SelectedRecord.CaptureNo, StringFormat=Raw samples of capture {0}}"/>
                                    <TextBlock Grid.Column="1" Text="Counts per minute, as the detector reported them"
                                               Style="{StaticResource MetaLabel}" VerticalAlignment="Center"/>
                                </Grid>
                                <Grid>
                                    <DataGrid Style="{StaticResource DataTable}" ItemsSource="{Binding RawSamples}" MaxHeight="220"
                                              AutomationProperties.Name="Raw samples">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="*"/>
                                            <DataGridTextColumn Header="Seq" Binding="{Binding Seq}" Width="0.6*"/>
                                            <DataGridTextColumn Header="CPM" Binding="{Binding Count0, StringFormat=0}" Width="0.7*" ElementStyle="{StaticResource NumberCell}" HeaderStyle="{StaticResource NumberHeader}"/>
                                            <DataGridTextColumn Header="CPM raw" Binding="{Binding Count0Raw, StringFormat=0}" Width="0.7*" ElementStyle="{StaticResource NumberCell}" HeaderStyle="{StaticResource NumberHeader}"/>
                                            <DataGridTextColumn Header="HDM" Binding="{Binding Hdm, StringFormat=0.###}" Width="0.7*" ElementStyle="{StaticResource NumberCell}" HeaderStyle="{StaticResource NumberHeader}"/>
                                            <DataGridTextColumn Header="Dose rate" Binding="{Binding DoseRate, StringFormat=0.###}" Width="0.7*" ElementStyle="{StaticResource NumberCell}" HeaderStyle="{StaticResource NumberHeader}"/>
                                            <DataGridTextColumn Header="Temp. (°C)" Binding="{Binding Temperature, StringFormat=0.0}" Width="0.7*" ElementStyle="{StaticResource NumberCell}" HeaderStyle="{StaticResource NumberHeader}"/>
                                            <DataGridTextColumn Header="Detector" Binding="{Binding Serial}" Width="*"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <TextBlock Text="No raw samples were stored with this capture." Style="{StaticResource EmptyStateText}" Margin="16"
                                               Visibility="{Binding RawSamples.Count, Converter={StaticResource ZeroVisibility}}"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <TextBlock Grid.Row="2" Text="{Binding RetentionNote}" Style="{StaticResource MetaLabel}" Margin="2,12,0,0"
                   ToolTip="{Binding DatabasePath}"/>
    </Grid>
</UserControl>
